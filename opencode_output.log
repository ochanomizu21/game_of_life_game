{"type":"tool_use","timestamp":1771167750373,"sessionID":"ses_39e2d200bffenWVxn564xoSdlc","part":{"id":"prt_c61d318cd001LMj4IYfacjQuGs","sessionID":"ses_39e2d200bffenWVxn564xoSdlc","messageID":"msg_c61d2f7bf001J4ZTry72Zi3CEv","type":"tool","callID":"call_96a96a73b0ce419b8fdf9879","tool":"read","state":{"status":"completed","input":{"filePath":"/home/ochanomizu/repos/game_of_life/src/lib/validation.ts"},"output":"<path>/home/ochanomizu/repos/game_of_life/src/lib/validation.ts</path>\n<type>file</type>\n<content>1: export function isValidCoordinate(\n2:   row: number,\n3:   col: number,\n4:   numRows: number,\n5:   numCols: number\n6: ): boolean {\n7:   return row >= 0 && row < numRows && col >= 0 && col < numCols\n8: }\n9: \n10: export function clamp(value: number, min: number, max: number): number {\n11:   return Math.min(Math.max(value, min), max)\n12: }\n13: \n14: export function isInRange(value: number, min: number, max: number): boolean {\n15:   return value >= min && value <= max\n16: }\n17: \n18: export function isPositiveNumber(value: unknown): value is number {\n19:   return typeof value === 'number' && !isNaN(value) && value > 0\n20: }\n21: \n22: export function isNonNegativeNumber(value: unknown): value is number {\n23:   return typeof value === 'number' && !isNaN(value) && value >= 0\n24: }\n25: \n26: export function isInteger(value: unknown): value is number {\n27:   return typeof value === 'number' && Number.isInteger(value)\n28: }\n29: \n30: export function isValidRuleSet(ruleSet: unknown): ruleSet is { born: number[]; survive: number[] } {\n31:   if (typeof ruleSet !== 'object' || ruleSet === null) return false\n32:   const { born, survive } = ruleSet as { born?: unknown; survive?: unknown }\n33: \n34:   if (!Array.isArray(born) || !Array.isArray(survive)) return false\n35: \n36:   return (\n37:     born.every((v) => isInteger(v) && isNonNegativeNumber(v)) &&\n38:     survive.every((v) => isInteger(v) && isNonNegativeNumber(v))\n39:   )\n40: }\n41: \n42: export function validateGridDimensions(\n43:   rows: number,\n44:   cols: number\n45: ): { valid: boolean; error?: string } {\n46:   if (!isPositiveNumber(rows) || !isPositiveNumber(cols)) {\n47:     return { valid: false, error: 'Grid dimensions must be positive numbers' }\n48:   }\n49: \n50:   if (rows > 1000 || cols > 1000) {\n51:     return { valid: false, error: 'Grid dimensions cannot exceed 1000x1000' }\n52:   }\n53: \n54:   return { valid: true }\n55: }\n56: \n\n(End of file - total 56 lines)\n</content>","title":"src/lib/validation.ts","metadata":{"preview":"export function isValidCoordinate(\n  row: number,\n  col: number,\n  numRows: number,\n  numCols: number\n): boolean {\n  return row >= 0 && row < numRows && col >= 0 && col < numCols\n}\n\nexport function clamp(value: number, min: number, max: number): number {\n  return Math.min(Math.max(value, min), max)\n}\n\nexport function isInRange(value: number, min: number, max: number): boolean {\n  return value >= min && value <= max\n}\n\nexport function isPositiveNumber(value: unknown): value is number {\n  return typeof value === 'number' && !isNaN(value) && value > 0\n}","truncated":false,"loaded":[]},"time":{"start":1771167750351,"end":1771167750371}}}}
