{"type":"tool_use","timestamp":1771197117266,"sessionID":"ses_39c6f4287ffey46zawOx3i1Iz0","part":{"id":"prt_c63933348001BYq7t47Cul408x","sessionID":"ses_39c6f4287ffey46zawOx3i1Iz0","messageID":"msg_c63932130001MoQ1c2sEJHDQTE","type":"tool","callID":"call_8dfe935eb5d448a891596afc","tool":"read","state":{"status":"completed","input":{"filePath":"/home/ochanomizu/repos/game_of_life/src/components/Game.tsx"},"output":"<path>/home/ochanomizu/repos/game_of_life/src/components/Game.tsx</path>\n<type>file</type>\n<content>1: import { useState, useCallback, useEffect, useRef } from 'react'\n2: import { createGrid, GRID_SIZE_PRESETS, type GridSizePreset } from '../lib/simulation'\n3: import {\n4:   type GridType,\n5:   type FluxState,\n6:   type InteractionMode,\n7:   type TrackedCluster,\n8:   type ExpertSettings,\n9:   type LevelProgression,\n10: } from '../types'\n11: import { createInitialFluxState } from '../lib/flux'\n12: import { GridInteraction } from './GridInteraction'\n13: import { usePhaseTimer } from '../hooks/usePhaseTimer'\n14: import { useTransition } from '../hooks/useTransition'\n15: import { stepSimulation, CONWAY_RULES } from '../lib/simulation'\n16: import { findConnectedComponents, trackClusters } from '../lib/movement'\n17: import { createInitialScoreState, updateScore, calculateGenerationScore } from '../lib/scoring'\n18: import { ScoreDisplay } from './ScoreDisplay'\n19: import { GlassHUD } from './GlassHUD'\n20: import { SettingsPanel } from './SettingsPanel'\n21: import { TransitionOverlay } from './TransitionOverlay'\n22: import { VictoryScreen } from './VictoryScreen'\n23: import {\n24:   createInitialExpertSettings,\n25:   saveToLocalStorage,\n26:   loadFromLocalStorage,\n27: } from '../lib/settings'\n28: import {\n29:   generateProgression,\n30:   getCurrentLevelConfig,\n31:   advanceLevel,\n32:   isFinalLevel,\n33:   resetProgression,\n34: } from '../lib/level'\n35: import { SoundEngine } from '../lib/audio'\n36: \n37: export function Game() {\n38:   const [gridPreset, setGridPreset] = useState<GridSizePreset>('SMALL')\n39:   const [grid, setGrid] = useState<GridType>(() => createGrid(20, 30))\n40:   const [flux, setFlux] = useState<FluxState>(() => createInitialFluxState(20))\n41:   const [showGridLines, setShowGridLines] = useState(true)\n42:   const [interactionMode, setInteractionMode] = useState<InteractionMode>('DRAW')\n43:   const [generation, setGeneration] = useState(0)\n44:   const [scoreState, setScoreState] = useState(() => createInitialScoreState())\n45:   const [settingsPanelOpen, setSettingsPanelOpen] = useState(false)\n46:   const [expertSettings, setExpertSettings] = useState<ExpertSettings>(() => {\n47:     const saved = loadFromLocalStorage<ExpertSettings>(\n48:       'gol-expert-settings',\n49:       createInitialExpertSettings()\n50:     )\n51:     return saved\n52:   })\n53:   const [levelProgression, setLevelProgression] = useState<LevelProgression>(() =>\n54:     generateProgression(createInitialExpertSettings().levelGeneration)\n55:   )\n56:   const [showVictory, setShowVictory] = useState(false)\n57: \n58:   const previousTrackedClustersRef = useRef<TrackedCluster[]>([])\n59:   const previousPhaseRef = useRef<'PLANNING' | 'COUNTDOWN' | 'RUNNING' | 'FINISHED'>('PLANNING')\n60:   const simulationSpeed = 200\n61:   const soundEngineRef = useRef<SoundEngine | null>(null)\n62: \n63:   const {\n64:     enabled: audioEnabled,\n65:     volume: audioVolume,\n66:     waveform: audioWaveform,\n67:   } = expertSettings.audio\n68: \n69:   const handleInteractionSound = useCallback((type: 'draw' | 'erase') => {\n70:     soundEngineRef.current?.playInteractionSound(type)\n71:   }, [])\n72: \n73:   const handleTransitionSound = useCallback((type: 'fade-out' | 'fade-in') => {\n74:     soundEngineRef.current?.playTransitionSound(type)\n75:   }, [])\n76: \n77:   useEffect(() => {\n78:     if (!soundEngineRef.current) {\n79:       soundEngineRef.current = new SoundEngine()\n80:     }\n81:     soundEngineRef.current.setEnabled(audioEnabled)\n82:     soundEngineRef.current.setVolume(audioVolume)\n83:     soundEngineRef.current.setWaveform(audioWaveform)\n84:   }, [audioEnabled, audioVolume, audioWaveform])\n85: \n86:   const currentLevelConfig = getCurrentLevelConfig(levelProgression)\n87: \n88:   const movementConfig = expertSettings.movementDetection\n89:   const scoringConfig = expertSettings.scoring\n90: \n91:   const handleTransitionComplete = useCallback(() => {\n92:     soundEngineRef.current?.playLevelStartSound()\n93: \n94:     if (isFinalLevel(levelProgression)) {\n95:       setShowVictory(true)\n96:     } else {\n97:       const newProgression = advanceLevel(levelProgression, scoreState.currentScore)\n98:       const newLevelConfig = getCurrentLevelConfig(newProgression)\n99: \n100:       setLevelProgression(newProgression)\n101:       const { rows, cols } = GRID_SIZE_PRESETS[gridPreset]\n102:       setGrid(createGrid(rows, cols))\n103:       setFlux(createInitialFluxState(newLevelConfig?.initialFlux ?? 20))\n104:       setGeneration(0)\n105:       setScoreState(createInitialScoreState())\n106:       previousTrackedClustersRef.current = []\n107:     }\n108:   }, [levelProgression, scoreState.currentScore, gridPreset])\n109: \n110:   const { transitionState, startTransition, resetTransition } = useTransition(\n111:     {\n112:       fadeOutDuration: 2000,\n113:       fadeInDuration: 2000,\n114:       interstitialDuration: 2000,\n115:       autoAdvanceDelay: 2000,\n116:       skipEnabled: true,\n117:     },\n118:     handleTransitionComplete,\n119:     handleTransitionSound\n120:   )\n121: \n122:   const [previousScore, setPreviousScore] = useState(0)\n123: \n124:   const hasCells = useCallback(() => {\n125:     return grid.flat().filter((cell: number) => cell > 0).length > 0\n126:   }, [grid])\n127: \n128:   const { phaseState, startCountdown, startRunning } = usePhaseTimer(hasCells)\n129: \n130:   useEffect(() => {\n131:     if (previousPhaseRef.current === 'COUNTDOWN' && phaseState.current === 'RUNNING') {\n132:       soundEngineRef.current?.playSimulationStartSound()\n133:     }\n134:     previousPhaseRef.current = phaseState.current\n135:   }, [phaseState.current])\n136: \n137:   useEffect(() => {\n138:     if (phaseState.current === 'FINISHED') {\n139:       window.setTimeout(() => {\n140:         if (!showVictory) {\n141:           startTransition()\n142:           soundEngineRef.current?.playLevelCompleteSound()\n143:         }\n144:       }, 2000)\n145:     }\n146:   }, [phaseState, showVictory, startTransition])\n147: \n148:   useEffect(() => {\n149:     if (transitionState === 'READY') {\n150:       window.setTimeout(() => {\n151:         resetTransition()\n152:       }, 100)\n153:     }\n154:   }, [transitionState, resetTransition])\n155: \n156:   const handleSimulationStep = useCallback(() => {\n157:     const currentState = {\n158:       grid,\n159:       generation,\n160:       running: true,\n161:       speed: simulationSpeed,\n162:       selectedRule: CONWAY_RULES,\n163:     }\n164: \n165:     const result = stepSimulation(currentState)\n166: \n167:     if (result.bornCount > 0) {\n168:       const totalRows = grid.length\n169:       soundEngineRef.current?.playGenerationSound(result.bornCount, result.averageRow, totalRows)\n170:     }\n171: \n172:     const currentClusters = findConnectedComponents(result.newGrid, result.newGeneration)\n173:     const tracked = trackClusters(\n174:       currentClusters,\n175:       previousTrackedClustersRef.current,\n176:       movementConfig\n177:     )\n178: \n179:     const generationScore = calculateGenerationScore(tracked, scoringConfig)\n180:     const newScoreState = updateScore(scoreState, generationScore)\n181: \n182:     setPreviousScore(scoreState.currentScore)\n183:     previousTrackedClustersRef.current = tracked\n184:     setScoreState(newScoreState)\n185:     setGrid(result.newGrid)\n186:     setGeneration(result.newGeneration)\n187:   }, [grid, generation, simulationSpeed, scoreState, movementConfig, scoringConfig])\n188: \n189:   useEffect(() => {\n190:     let interval: number | undefined\n191: \n192:     if (phaseState.current === 'RUNNING') {\n193:       interval = window.setInterval(() => {\n194:         handleSimulationStep()\n195:       }, simulationSpeed)\n196:     }\n197: \n198:     return () => {\n199:       if (interval) {\n200:         window.clearInterval(interval)\n201:       }\n202:     }\n203:   }, [phaseState, simulationSpeed, handleSimulationStep])\n204: \n205:   const handleStart = useCallback(() => {\n206:     if (phaseState.current === 'PLANNING' && hasCells() && currentLevelConfig) {\n207:       startCountdown()\n208:       startRunning(currentLevelConfig.timeLimitSeconds)\n209:     }\n210:   }, [phaseState, startCountdown, hasCells, currentLevelConfig, startRunning])\n211: \n212:   const handleGridChange = useCallback((newGrid: GridType) => {\n213:     setGrid(newGrid)\n214:     setGeneration(0)\n215:   }, [])\n216: \n217:   const handleFluxChange = useCallback((newFlux: FluxState) => {\n218:     setFlux(newFlux)\n219:   }, [])\n220: \n221:   const handleClear = useCallback(() => {\n222:     const { rows, cols } = GRID_SIZE_PRESETS[gridPreset]\n223:     setGrid(createGrid(rows, cols))\n224:     setFlux(createInitialFluxState(20))\n225:     setGeneration(0)\n226:     setScoreState(createInitialScoreState())\n227:     previousTrackedClustersRef.current = []\n228:   }, [gridPreset])\n229: \n230:   const handleRandom = useCallback(() => {\n231:     const { rows, cols } = GRID_SIZE_PRESETS[gridPreset]\n232:     const newGrid = createGrid(rows, cols)\n233:     const density = 0.15\n234: \n235:     for (let row = 0; row < rows; row++) {\n236:       for (let col = 0; col < cols; col++) {\n237:         if (Math.random() < density) {\n238:           newGrid[row][col] = 1\n239:         }\n240:       }\n241:     }\n242: \n243:     setGrid(newGrid)\n244:     setFlux(createInitialFluxState(20))\n245:     setGeneration(0)\n246:     setScoreState(createInitialScoreState())\n247:     previousTrackedClustersRef.current = []\n248:   }, [gridPreset])\n249: \n250:   const aliveCount = grid.flat().filter((cell: number) => cell > 0).length\n251: \n252:   const handleToggleSettings = useCallback(() => {\n253:     setSettingsPanelOpen((prev) => !prev)\n254:   }, [])\n255: \n256:   const handleUpdateSettings = useCallback((newSettings: ExpertSettings) => {\n257:     setExpertSettings(newSettings)\n258:     saveToLocalStorage('gol-expert-settings', newSettings)\n259:   }, [])\n260: \n261:   const handleStep = useCallback(() => {\n262:     if (phaseState.current !== 'PLANNING') return\n263: \n264:     const currentState = {\n265:       grid,\n266:       generation,\n267:       running: false,\n268:       speed: 100,\n269:       selectedRule: CONWAY_RULES,\n270:     }\n271: \n272:     const result = stepSimulation(currentState)\n273:     setGrid(result.newGrid)\n274:     setGeneration(result.newGeneration)\n275:   }, [phaseState, grid, generation])\n276: \n277:   const canInteract = phaseState.current === 'PLANNING'\n278:   const isUiVisible = true\n279: \n280:   return (\n281:     <div style={{ padding: '20px', backgroundColor: '#0a0a0f', minHeight: '100vh', color: '#fff' }}>\n282:       <ScoreDisplay\n283:         score={scoreState.currentScore}\n284:         previousScore={previousScore}\n285:         showPatternBreakdown={false}\n286:       />\n287: \n288:       <SettingsPanel\n289:         isOpen={settingsPanelOpen}\n290:         settings={expertSettings}\n291:         onClose={() => setSettingsPanelOpen(false)}\n292:         onUpdateSettings={handleUpdateSettings}\n293:       />\n294: \n295:       <h1 style={{ textAlign: 'center', marginBottom: '20px', color: '#61dafb' }}>\n296:         Level {levelProgression.currentLevel} - Conway's Game of Life\n297:       </h1>\n298: \n299:       <TransitionOverlay\n300:         transitionState={transitionState}\n301:         currentLevel={levelProgression.currentLevel}\n302:       />\n303: \n304:       {showVictory && (\n305:         <VictoryScreen\n306:           totalScore={levelProgression.totalScore}\n307:           onPlayAgain={() => {\n308:             const reset = resetProgression()\n309:             setLevelProgression(reset)\n310:             setShowVictory(false)\n311:             const { rows, cols } = GRID_SIZE_PRESETS[gridPreset]\n312:             setGrid(createGrid(rows, cols))\n313:             setFlux(createInitialFluxState(reset.levels[0]?.initialFlux ?? 20))\n314:             setGeneration(0)\n315:             setScoreState(createInitialScoreState())\n316:             previousTrackedClustersRef.current = []\n317:           }}\n318:         />\n319:       )}\n320: \n321:       {isUiVisible && (\n322:         <GlassHUD\n323:           phase={phaseState.current}\n324:           aliveCount={aliveCount}\n325:           flux={flux.current}\n326:           fluxMax={flux.initial}\n327:           interactionMode={interactionMode}\n328:           gridPreset={gridPreset}\n329:           showGridLines={showGridLines}\n330:           generation={generation}\n331:           countdownValue={phaseState.countdownValue}\n332:           timerRemaining={phaseState.timerRemaining}\n333:           canStart={aliveCount > 0}\n334:           canInteract={canInteract}\n335:           onStart={handleStart}\n336:           onStep={handleStep}\n337:           onClear={handleClear}\n338:           onRandom={handleRandom}\n339:           onToggleGrid={() => setShowGridLines(!showGridLines)}\n340:           onSetMode={setInteractionMode}\n341:           onSetGridPreset={setGridPreset}\n342:           onToggleSettings={handleToggleSettings}\n343:         />\n344:       )}\n345: \n346:       <div style={{ display: 'flex', justifyContent: 'center' }}>\n347:         <GridInteraction\n348:           grid={grid}\n349:           flux={flux}\n350:           phase={phaseState.current}\n351:           showGridLines={showGridLines}\n352:           onGridChange={handleGridChange}\n353:           onFluxChange={handleFluxChange}\n354:           interactionMode={interactionMode}\n355:           onInteractionSound={handleInteractionSound}\n356:         />\n357:       </div>\n358:     </div>\n359:   )\n360: }\n361: \n\n(End of file - total 361 lines)\n</content>","title":"src/components/Game.tsx","metadata":{"preview":"import { useState, useCallback, useEffect, useRef } from 'react'\nimport { createGrid, GRID_SIZE_PRESETS, type GridSizePreset } from '../lib/simulation'\nimport {\n  type GridType,\n  type FluxState,\n  type InteractionMode,\n  type TrackedCluster,\n  type ExpertSettings,\n  type LevelProgression,\n} from '../types'\nimport { createInitialFluxState } from '../lib/flux'\nimport { GridInteraction } from './GridInteraction'\nimport { usePhaseTimer } from '../hooks/usePhaseTimer'\nimport { useTransition } from '../hooks/useTransition'\nimport { stepSimulation, CONWAY_RULES } from '../lib/simulation'\nimport { findConnectedComponents, trackClusters } from '../lib/movement'\nimport { createInitialScoreState, updateScore, calculateGenerationScore } from '../lib/scoring'\nimport { ScoreDisplay } from './ScoreDisplay'\nimport { GlassHUD } from './GlassHUD'\nimport { SettingsPanel } from './SettingsPanel'","truncated":false,"loaded":[]},"time":{"start":1771197117257,"end":1771197117264}}}}
