{"type":"tool_use","timestamp":1771234181483,"sessionID":"ses_39a387835ffeQXkadxFvThlMO2","part":{"id":"prt_c65c8c165001JdE3u6ZQoemAKR","sessionID":"ses_39a387835ffeQXkadxFvThlMO2","messageID":"msg_c65c8b30c0013LYSgVdTBfEWae","type":"tool","callID":"call_8ec8fa6fd4224292b190fe4d","tool":"read","state":{"status":"completed","input":{"filePath":"/home/ochanomizu/repos/game_of_life/src/components/Game.tsx"},"output":"<path>/home/ochanomizu/repos/game_of_life/src/components/Game.tsx</path>\n<type>file</type>\n<content>1: import { useState, useCallback, useEffect, useRef, useMemo } from 'react'\n2: import { createGrid, GRID_SIZE_PRESETS, type GridSizePreset } from '../lib/simulation'\n3: import {\n4:   type GridType,\n5:   type FluxState,\n6:   type InteractionMode,\n7:   type TrackedCluster,\n8:   type ExpertSettings,\n9:   type LevelProgression,\n10: } from '../types'\n11: import { createInitialFluxState } from '../lib/flux'\n12: import { GridInteraction } from './GridInteraction'\n13: import { usePhaseTimer } from '../hooks/usePhaseTimer'\n14: import { useTransition } from '../hooks/useTransition'\n15: import { useTripleTapGesture } from '../hooks/useTripleTapGesture'\n16: import { stepSimulation, CONWAY_RULES } from '../lib/simulation'\n17: import { findConnectedComponents, trackClusters } from '../lib/movement'\n18: import { createInitialScoreState, updateScore, calculateGenerationScore } from '../lib/scoring'\n19: import { ScoreDisplay } from './ScoreDisplay'\n20: import { GlassHUD } from './GlassHUD'\n21: import { SettingsPanel } from './SettingsPanel'\n22: import { TransitionOverlay } from './TransitionOverlay'\n23: import { VictoryScreen } from './VictoryScreen'\n24: import { UIToggleButton } from './UIToggleButton'\n25: import { Announcer } from './Announcer'\n26: import {\n27:   createInitialExpertSettings,\n28:   saveToLocalStorage,\n29:   loadFromLocalStorage,\n30: } from '../lib/settings'\n31: import {\n32:   generateProgression,\n33:   getCurrentLevelConfig,\n34:   advanceLevel,\n35:   isFinalLevel,\n36:   resetProgression,\n37:   saveHighScore,\n38:   getHighScore,\n39: } from '../lib/level'\n40: import { SoundEngine } from '../lib/audio'\n41: \n42: export function Game() {\n43:   const [gridPreset, setGridPreset] = useState<GridSizePreset>('SMALL')\n44:   const [grid, setGrid] = useState<GridType>(() => createGrid(20, 30))\n45:   const [flux, setFlux] = useState<FluxState>(() => createInitialFluxState(20))\n46:   const [showGridLines, setShowGridLines] = useState(true)\n47:   const [interactionMode, setInteractionMode] = useState<InteractionMode>('DRAW')\n48:   const [generation, setGeneration] = useState(0)\n49:   const [scoreState, setScoreState] = useState(() => createInitialScoreState())\n50:   const [settingsPanelOpen, setSettingsPanelOpen] = useState(false)\n51:   const [announcement, setAnnouncement] = useState('')\n52:   const [expertSettings, setExpertSettings] = useState<ExpertSettings>(() => {\n53:     const saved = loadFromLocalStorage<ExpertSettings>(\n54:       'gol-expert-settings',\n55:       createInitialExpertSettings()\n56:     )\n57:     return saved\n58:   })\n59:   const [levelProgression, setLevelProgression] = useState<LevelProgression>(() =>\n60:     generateProgression(createInitialExpertSettings().levelGeneration)\n61:   )\n62:   const [showVictory, setShowVictory] = useState(false)\n63:   const [isUiVisible, setIsUiVisible] = useState(true)\n64:   const [highScore, setHighScore] = useState(0)\n65:   const [trackedClusters, setTrackedClusters] = useState<TrackedCluster[]>([])\n66: \n67:   const previousTrackedClustersRef = useRef<TrackedCluster[]>([])\n68:   const previousPhaseRef = useRef<'PLANNING' | 'COUNTDOWN' | 'RUNNING' | 'FINISHED'>('PLANNING')\n69:   const simulationSpeed = 200\n70:   const soundEngineRef = useRef<SoundEngine | null>(null)\n71: \n72:   const {\n73:     enabled: audioEnabled,\n74:     volume: audioVolume,\n75:     waveform: audioWaveform,\n76:   } = expertSettings.audio\n77: \n78:   const handleInteractionSound = useCallback((type: 'draw' | 'erase') => {\n79:     soundEngineRef.current?.playInteractionSound(type)\n80:   }, [])\n81: \n82:   const handleTransitionSound = useCallback((type: 'fade-out' | 'fade-in') => {\n83:     soundEngineRef.current?.playTransitionSound(type)\n84:   }, [])\n85: \n86:   const handleFluxErrorSound = useCallback(() => {\n87:     soundEngineRef.current?.playFluxErrorSound()\n88:   }, [])\n89: \n90:   useEffect(() => {\n91:     if (!soundEngineRef.current) {\n92:       soundEngineRef.current = new SoundEngine()\n93:     }\n94:     soundEngineRef.current.setEnabled(audioEnabled)\n95:     soundEngineRef.current.setVolume(audioVolume)\n96:     soundEngineRef.current.setWaveform(audioWaveform)\n97:   }, [audioEnabled, audioVolume, audioWaveform])\n98: \n99:   useEffect(() => {\n100:     const handleKeyDown = (e: KeyboardEvent) => {\n101:       if (e.code === 'Backquote') {\n102:         e.preventDefault()\n103:         setSettingsPanelOpen((prev) => !prev)\n104:       }\n105:       if (e.code === 'KeyG') {\n106:         e.preventDefault()\n107:         setShowGridLines((prev) => !prev)\n108:       }\n109:     }\n110: \n111:     window.addEventListener('keydown', handleKeyDown)\n112:     return () => {\n113:       window.removeEventListener('keydown', handleKeyDown)\n114:     }\n115:   }, [])\n116: \n117:   useTripleTapGesture({\n118:     threshold: 100,\n119:     maxTimeBetweenTaps: 500,\n120:     onTripleTap: useCallback(() => {\n121:       setSettingsPanelOpen((prev) => !prev)\n122:     }, []),\n123:   })\n124: \n125:   const currentLevelConfig = getCurrentLevelConfig(levelProgression)\n126: \n127:   useEffect(() => {\n128:     if (currentLevelConfig) {\n129:       window.requestAnimationFrame(() => {\n130:         setHighScore(getHighScore(currentLevelConfig.levelNumber))\n131:       })\n132:     }\n133:   }, [currentLevelConfig])\n134: \n135:   const movementConfig = expertSettings.movementDetection\n136:   const scoringConfig = expertSettings.scoring\n137: \n138:   const handleTransitionComplete = useCallback(() => {\n139:     soundEngineRef.current?.playLevelStartSound()\n140: \n141:     if (isFinalLevel(levelProgression)) {\n142:       const updatedProgression: LevelProgression = {\n143:         ...levelProgression,\n144:         totalScore: levelProgression.totalScore + scoreState.currentScore,\n145:         currentLevel: levelProgression.currentLevel + 1,\n146:         maxUnlockedLevel: Math.max(\n147:           levelProgression.maxUnlockedLevel,\n148:           levelProgression.currentLevel + 1\n149:         ),\n150:       }\n151:       setLevelProgression(updatedProgression)\n152:       setShowVictory(true)\n153:       setAnnouncement(\n154:         `Victory! All ${levelProgression.currentLevel} levels completed. Total score: ${levelProgression.totalScore + scoreState.currentScore} points.`\n155:       )\n156:     } else {\n157:       const newProgression = advanceLevel(levelProgression, scoreState.currentScore)\n158:       const newLevelConfig = getCurrentLevelConfig(newProgression)\n159: \n160:       setLevelProgression(newProgression)\n161:       const { rows, cols } = GRID_SIZE_PRESETS[gridPreset]\n162:       setGrid(createGrid(rows, cols))\n163:       setFlux(createInitialFluxState(newLevelConfig?.initialFlux ?? 20))\n164:       setGeneration(0)\n165:       setScoreState(createInitialScoreState())\n166:       previousTrackedClustersRef.current = []\n167:       setAnnouncement(\n168:         `Level ${levelProgression.currentLevel} complete. Score: ${scoreState.currentScore} points. Starting level ${newProgression.currentLevel}.`\n169:       )\n170:     }\n171:   }, [levelProgression, scoreState.currentScore, gridPreset])\n172: \n173:   const { transitionState, startTransition, resetTransition } = useTransition(\n174:     {\n175:       fadeOutDuration: 2000,\n176:       fadeInDuration: 2000,\n177:       interstitialDuration: 2000,\n178:       autoAdvanceDelay: 2000,\n179:       skipEnabled: true,\n180:     },\n181:     handleTransitionComplete,\n182:     handleTransitionSound\n183:   )\n184: \n185:   const [previousScore, setPreviousScore] = useState(0)\n186: \n187:   const hasCells = useCallback(() => {\n188:     return grid.flat().filter((cell: number) => cell > 0).length > 0\n189:   }, [grid])\n190: \n191:   const { phaseState, startCountdown, startRunning, finishPhase } = usePhaseTimer(hasCells)\n192: \n193:   const levelStats = useMemo(() => {\n194:     if (phaseState.current === 'FINISHED' && currentLevelConfig && scoreState.currentScore > 0) {\n195:       const staticCount = trackedClusters.filter((c) => c.classification === 'STATIC').length\n196:       const movers = trackedClusters.filter((c) => c.classification === 'MOVER').length\n197:       const oscillators = trackedClusters.filter((c) => c.classification === 'OSCILLATOR').length\n198:       const aliveCount = grid.flat().filter((cell: number) => cell > 0).length\n199: \n200:       return {\n201:         finalScore: scoreState.currentScore,\n202:         highScore: getHighScore(currentLevelConfig.levelNumber),\n203:         timeLimitSeconds: currentLevelConfig.timeLimitSeconds,\n204:         timeRemaining: phaseState.timerRemaining,\n205:         finalGeneration: generation,\n206:         finalAliveCount: aliveCount,\n207:         moversCount: movers,\n208:         oscillatorsCount: oscillators,\n209:         staticCount: staticCount,\n210:         totalPatternsTracked: scoreState.totalPatternsTracked,\n211:       }\n212:     }\n213:     return null\n214:   }, [phaseState, currentLevelConfig, scoreState, generation, grid, trackedClusters])\n215: \n216:   useEffect(() => {\n217:     if (previousPhaseRef.current === 'COUNTDOWN' && phaseState.current === 'RUNNING') {\n218:       soundEngineRef.current?.playSimulationStartSound()\n219:     }\n220:     previousPhaseRef.current = phaseState.current\n221: \n222:     switch (phaseState.current) {\n223:       case 'PLANNING':\n224:         setAnnouncement(\n225:           `Planning phase. Level ${levelProgression.currentLevel}. Place your cells and start when ready.`\n226:         )\n227:         break\n228:       case 'COUNTDOWN':\n229:         setAnnouncement('Countdown. Simulation starting soon.')\n230:         break\n231:       case 'RUNNING':\n232:         setAnnouncement(\n233:           `Running phase. Simulation in progress. ${phaseState.timerRemaining} seconds remaining.`\n234:         )\n235:         break\n236:       case 'FINISHED':\n237:         setAnnouncement('Level finished.')\n238:         break\n239:     }\n240:   }, [phaseState.current, levelProgression.currentLevel])\n241: \n242:   useEffect(() => {\n243:     if (phaseState.current === 'FINISHED') {\n244:       window.setTimeout(() => {\n245:         if (!showVictory) {\n246:           startTransition()\n247:           soundEngineRef.current?.playLevelCompleteSound()\n248:         }\n249:       }, 2000)\n250:     }\n251:   }, [phaseState, showVictory, startTransition])\n252: \n253:   useEffect(() => {\n254:     if (transitionState === 'READY') {\n255:       window.setTimeout(() => {\n256:         resetTransition()\n257:       }, 100)\n258:     }\n259:   }, [transitionState, resetTransition])\n260: \n261:   useEffect(() => {\n262:     if (phaseState.current === 'FINISHED' && currentLevelConfig && scoreState.currentScore > 0) {\n263:       saveHighScore(currentLevelConfig.levelNumber, scoreState.currentScore)\n264:       window.requestAnimationFrame(() => {\n265:         setHighScore(getHighScore(currentLevelConfig.levelNumber))\n266:       })\n267:     }\n268:   }, [phaseState, currentLevelConfig, scoreState])\n269: \n270:   const handleSimulationStep = useCallback(() => {\n271:     const currentState = {\n272:       grid,\n273:       generation,\n274:       running: true,\n275:       speed: simulationSpeed,\n276:       selectedRule: CONWAY_RULES,\n277:     }\n278: \n279:     const result = stepSimulation(currentState)\n280: \n281:     if (result.bornCount > 0) {\n282:       const totalRows = grid.length\n283:       soundEngineRef.current?.playGenerationSound(result.bornCount, result.averageRow, totalRows)\n284:     }\n285: \n286:     const currentClusters = findConnectedComponents(result.newGrid, result.newGeneration)\n287:     const tracked = trackClusters(currentClusters, trackedClusters, movementConfig)\n288: \n289:     const generationScore = calculateGenerationScore(tracked, scoringConfig)\n290:     const newScoreState = updateScore(scoreState, generationScore)\n291: \n292:     setPreviousScore(scoreState.currentScore)\n293:     previousTrackedClustersRef.current = tracked\n294:     setTrackedClusters(tracked)\n295:     setScoreState(newScoreState)\n296:     setGrid(result.newGrid)\n297:     setGeneration(result.newGeneration)\n298: \n299:     if (phaseState.current === 'RUNNING') {\n300:       const aliveCount = result.newGrid.flat().filter((cell: number) => cell > 0).length\n301:       if (aliveCount === 0) {\n302:         finishPhase()\n303:       }\n304:     }\n305:   }, [\n306:     grid,\n307:     generation,\n308:     simulationSpeed,\n309:     scoreState,\n310:     movementConfig,\n311:     scoringConfig,\n312:     trackedClusters,\n313:     phaseState,\n314:     finishPhase,\n315:   ])\n316: \n317:   useEffect(() => {\n318:     let interval: number | undefined\n319: \n320:     if (phaseState.current === 'RUNNING') {\n321:       interval = window.setInterval(() => {\n322:         handleSimulationStep()\n323:       }, simulationSpeed)\n324:     }\n325: \n326:     return () => {\n327:       if (interval) {\n328:         window.clearInterval(interval)\n329:       }\n330:     }\n331:   }, [phaseState, simulationSpeed, handleSimulationStep, trackedClusters])\n332: \n333:   const handleStart = useCallback(() => {\n334:     if (phaseState.current === 'PLANNING' && hasCells() && currentLevelConfig) {\n335:       startCountdown()\n336:       startRunning(currentLevelConfig.timeLimitSeconds)\n337:     }\n338:   }, [phaseState, startCountdown, hasCells, currentLevelConfig, startRunning, finishPhase])\n339: \n340:   const handleGridChange = useCallback((newGrid: GridType) => {\n341:     setGrid(newGrid)\n342:     setGeneration(0)\n343:   }, [])\n344: \n345:   const handleFluxChange = useCallback((newFlux: FluxState) => {\n346:     setFlux(newFlux)\n347:   }, [])\n348: \n349:   const handleClear = useCallback(() => {\n350:     const { rows, cols } = GRID_SIZE_PRESETS[gridPreset]\n351:     setGrid(createGrid(rows, cols))\n352:     setFlux(createInitialFluxState(20))\n353:     setGeneration(0)\n354:     setScoreState(createInitialScoreState())\n355:     setTrackedClusters([])\n356:   }, [gridPreset])\n357: \n358:   const handleRandom = useCallback(() => {\n359:     const { rows, cols } = GRID_SIZE_PRESETS[gridPreset]\n360:     const newGrid = createGrid(rows, cols)\n361:     const density = 0.15\n362: \n363:     for (let row = 0; row < rows; row++) {\n364:       for (let col = 0; col < cols; col++) {\n365:         if (Math.random() < density) {\n366:           newGrid[row][col] = 1\n367:         }\n368:       }\n369:     }\n370: \n371:     setGrid(newGrid)\n372:     setFlux(createInitialFluxState(20))\n373:     setGeneration(0)\n374:     setScoreState(createInitialScoreState())\n375:     setTrackedClusters([])\n376:   }, [gridPreset])\n377: \n378:   const aliveCount = grid.flat().filter((cell: number) => cell > 0).length\n379: \n380:   const handleToggleSettings = useCallback(() => {\n381:     setSettingsPanelOpen((prev) => !prev)\n382:   }, [])\n383: \n384:   const handleUpdateSettings = useCallback((newSettings: ExpertSettings) => {\n385:     setExpertSettings(newSettings)\n386:     saveToLocalStorage('gol-expert-settings', newSettings)\n387:   }, [])\n388: \n389:   const handleStep = useCallback(() => {\n390:     if (phaseState.current !== 'PLANNING') return\n391: \n392:     const currentState = {\n393:       grid,\n394:       generation,\n395:       running: false,\n396:       speed: 100,\n397:       selectedRule: CONWAY_RULES,\n398:     }\n399: \n400:     const result = stepSimulation(currentState)\n401:     setGrid(result.newGrid)\n402:     setGeneration(result.newGeneration)\n403:   }, [phaseState, grid, generation])\n404: \n405:   const canInteract = phaseState.current === 'PLANNING'\n406: \n407:   const movers = trackedClusters.filter((c) => c.classification === 'MOVER').length\n408:   const oscillators = trackedClusters.filter((c) => c.classification === 'OSCILLATOR').length\n409:   const rate =\n410:     scoringConfig.moverPointsPerGeneration * movers +\n411:     scoringConfig.oscillatorPointsPerGeneration * oscillators\n412: \n413:   return (\n414:     <div style={{ padding: '20px', backgroundColor: '#0a0a0f', minHeight: '100vh', color: '#fff' }}>\n415:       <Announcer message={announcement} priority=\"polite\" />\n416: \n417:       <UIToggleButton isVisible={isUiVisible} onToggle={() => setIsUiVisible(!isUiVisible)} />\n418: \n419:       <ScoreDisplay\n420:         score={scoreState.currentScore}\n421:         previousScore={previousScore}\n422:         showPatternBreakdown={true}\n423:         movers={movers}\n424:         oscillators={oscillators}\n425:         rate={rate}\n426:         highScore={highScore}\n427:       />\n428: \n429:       <SettingsPanel\n430:         isOpen={settingsPanelOpen}\n431:         settings={expertSettings}\n432:         onClose={() => setSettingsPanelOpen(false)}\n433:         onUpdateSettings={handleUpdateSettings}\n434:       />\n435: \n436:       <h1 style={{ textAlign: 'center', marginBottom: '20px', color: '#61dafb' }}>\n437:         Level {levelProgression.currentLevel} - Conway's Game of Life\n438:       </h1>\n439: \n440:       <TransitionOverlay\n441:         transitionState={transitionState}\n442:         currentLevel={levelProgression.currentLevel}\n443:         showStats={!!levelStats}\n444:         stats={levelStats ?? undefined}\n445:       />\n446: \n447:       {showVictory && (\n448:         <VictoryScreen\n449:           totalScore={levelProgression.totalScore}\n450:           finalLevelStats={levelStats ?? undefined}\n451:           onPlayAgain={() => {\n452:             const reset = resetProgression()\n453:             setLevelProgression(reset)\n454:             setShowVictory(false)\n455:             const { rows, cols } = GRID_SIZE_PRESETS[gridPreset]\n456:             setGrid(createGrid(rows, cols))\n457:             setFlux(createInitialFluxState(reset.levels[0]?.initialFlux ?? 20))\n458:             setGeneration(0)\n459:             setScoreState(createInitialScoreState())\n460:             previousTrackedClustersRef.current = []\n461:           }}\n462:         />\n463:       )}\n464: \n465:       {isUiVisible && (\n466:         <GlassHUD\n467:           phase={phaseState.current}\n468:           aliveCount={aliveCount}\n469:           flux={flux.current}\n470:           fluxMax={flux.initial}\n471:           interactionMode={interactionMode}\n472:           gridPreset={gridPreset}\n473:           showGridLines={showGridLines}\n474:           generation={generation}\n475:           countdownValue={phaseState.countdownValue}\n476:           timerRemaining={phaseState.timerRemaining}\n477:           canStart={aliveCount > 0}\n478:           canInteract={canInteract}\n479:           onStart={handleStart}\n480:           onStep={handleStep}\n481:           onClear={handleClear}\n482:           onRandom={handleRandom}\n483:           onToggleGrid={() => setShowGridLines(!showGridLines)}\n484:           onSetMode={setInteractionMode}\n485:           onSetGridPreset={setGridPreset}\n486:           onToggleSettings={handleToggleSettings}\n487:         />\n488:       )}\n489: \n490:       <div style={{ display: 'flex', justifyContent: 'center' }}>\n491:         <GridInteraction\n492:           grid={grid}\n493:           flux={flux}\n494:           phase={phaseState.current}\n495:           showGridLines={showGridLines}\n496:           onGridChange={handleGridChange}\n497:           onFluxChange={handleFluxChange}\n498:           interactionMode={interactionMode}\n499:           onInteractionSound={handleInteractionSound}\n500:           onFluxErrorSound={handleFluxErrorSound}\n501:         />\n502:       </div>\n503:     </div>\n504:   )\n505: }\n506: \n\n(End of file - total 506 lines)\n</content>","title":"src/components/Game.tsx","metadata":{"preview":"import { useState, useCallback, useEffect, useRef, useMemo } from 'react'\nimport { createGrid, GRID_SIZE_PRESETS, type GridSizePreset } from '../lib/simulation'\nimport {\n  type GridType,\n  type FluxState,\n  type InteractionMode,\n  type TrackedCluster,\n  type ExpertSettings,\n  type LevelProgression,\n} from '../types'\nimport { createInitialFluxState } from '../lib/flux'\nimport { GridInteraction } from './GridInteraction'\nimport { usePhaseTimer } from '../hooks/usePhaseTimer'\nimport { useTransition } from '../hooks/useTransition'\nimport { useTripleTapGesture } from '../hooks/useTripleTapGesture'\nimport { stepSimulation, CONWAY_RULES } from '../lib/simulation'\nimport { findConnectedComponents, trackClusters } from '../lib/movement'\nimport { createInitialScoreState, updateScore, calculateGenerationScore } from '../lib/scoring'\nimport { ScoreDisplay } from './ScoreDisplay'\nimport { GlassHUD } from './GlassHUD'","truncated":false,"loaded":[]},"time":{"start":1771234181478,"end":1771234181480}}}}
