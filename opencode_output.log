   timerRemaining: 0,\n52:     canTransition: false,\n53:     blockers: [],\n54:   }\n55: }\n56: \n57: export function phaseReducer(\n58:   state: PhaseState,\n59:   action: PhaseAction,\n60:   hasCells: boolean\n61: ): PhaseState {\n62:   switch (action.type) {\n63:     case 'START_COUNTDOWN': {\n64:       if (!canTransition(state.current, 'COUNTDOWN')) {\n65:         return state\n66:       }\n67: \n68:       const blockers = getBlockers(state.current, hasCells)\n69:       if (blockers.length > 0) {\n70:         return { ...state, canTransition: false, blockers }\n71:       }\n72: \n73:       return {\n74:         current: 'COUNTDOWN',\n75:         countdownValue: COUNTDOWN_SECONDS,\n76:         timerRemaining: 0,\n77:         canTransition: false,\n78:         blockers: [],\n79:       }\n80:     }\n81: \n82:     case 'DECREMENT_COUNTDOWN': {\n83:       if (state.current !== 'COUNTDOWN') {\n84:         return state\n85:       }\n86: \n87:       const newValue = state.countdownValue - 1\n88: \n89:       if (newValue <= 0) {\n90:         return {\n91:           ...state,\n92:           countdownValue: 0,\n93:           canTransition: true,\n94:         }\n95:       }\n96: \n97:       return {\n98:         ...state,\n99:         countdownValue: newValue,\n100:       }\n101:     }\n102: \n103:     case 'START_RUNNING': {\n104:       if (!canTransition(state.current, 'RUNNING')) {\n105:         return state\n106:       }\n107: \n108:       return {\n109:         current: 'RUNNING',\n110:         countdownValue: 0,\n111:         timerRemaining: action.duration,\n112:         canTransition: false,\n113:         blockers: [],\n114:       }\n115:     }\n116: \n117:     case 'DECREMENT_TIMER': {\n118:       if (state.current !== 'RUNNING') {\n119:         return state\n120:       }\n121: \n122:       const newValue = state.timerRemaining - 1\n123: \n124:       if (newValue <= 0) {\n125:         return {\n126:           ...state,\n127:           timerRemaining: 0,\n128:           canTransition: true,\n129:         }\n130:       }\n131: \n132:       return {\n133:         ...state,\n134:         timerRemaining: newValue,\n135:       }\n136:     }\n137: \n138:     case 'FINISH_PHASE': {\n139:       if (!canTransition(state.current, 'FINISHED')) {\n140:         return state\n141:       }\n142: \n143:       return {\n144:         current: 'FINISHED',\n145:         countdownValue: 0,\n146:         timerRemaining: FINISHED_DELAY_SECONDS,\n147:         canTransition: false,\n148:         blockers: [],\n149:       }\n150:     }\n151: \n152:     case 'RESET_PHASE': {\n153:       return {\n154:         current: 'PLANNING',\n155:         countdownValue: COUNTDOWN_SECONDS,\n156:         timerRemaining: 0,\n157:         canTransition: false,\n158:         blockers: [],\n159:       }\n160:     }\n161: \n162:     default:\n163:       return state\n164:   }\n165: }\n166: \n\n(End of file - total 166 lines)\n</content>","title":"src/lib/phase.ts","metadata":{"preview":"import type { GamePhase } from '../types'\n\nexport interface PhaseState {\n  current: GamePhase\n  countdownValue: number\n  timerRemaining: number\n  canTransition: boolean\n  blockers: string[]\n}\n\nexport type PhaseAction =\n  | { type: 'START_COUNTDOWN' }\n  | { type: 'DECREMENT_COUNTDOWN' }\n  | { type: 'START_RUNNING'; duration: number }\n  | { type: 'DECREMENT_TIMER' }\n  | { type: 'FINISH_PHASE' }\n  | { type: 'RESET_PHASE' }\n\nconst COUNTDOWN_SECONDS = 3\nconst FINISHED_DELAY_SECONDS = 2","truncated":false,"loaded":[]},"time":{"start":1771218805314,"end":1771218805316}}}}
