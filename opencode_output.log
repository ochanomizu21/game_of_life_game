 {\n185:     if (phaseState.current === 'FINISHED' && currentLevelConfig && scoreState.currentScore > 0) {\n186:       saveHighScore(currentLevelConfig.levelNumber, scoreState.currentScore)\n187:       window.requestAnimationFrame(() => {\n188:         setHighScore(getHighScore(currentLevelConfig.levelNumber))\n189:       })\n190:     }\n191:   }, [phaseState, currentLevelConfig, scoreState.currentScore])\n192: \n193:   const handleSimulationStep = useCallback(() => {\n194:     const currentState = {\n195:       grid,\n196:       generation,\n197:       running: true,\n198:       speed: simulationSpeed,\n199:       selectedRule: CONWAY_RULES,\n200:     }\n\n(File has more lines. Use 'offset' parameter to read beyond line 200)\n</content>","title":"src/components/Game.tsx","metadata":{"preview":"import { useState, useCallback, useEffect, useRef } from 'react'\nimport { createGrid, GRID_SIZE_PRESETS, type GridSizePreset } from '../lib/simulation'\nimport {\n  type GridType,\n  type FluxState,\n  type InteractionMode,\n  type TrackedCluster,\n  type ExpertSettings,\n  type LevelProgression,\n} from '../types'\nimport { createInitialFluxState } from '../lib/flux'\nimport { GridInteraction } from './GridInteraction'\nimport { usePhaseTimer } from '../hooks/usePhaseTimer'\nimport { useTransition } from '../hooks/useTransition'\nimport { stepSimulation, CONWAY_RULES } from '../lib/simulation'\nimport { findConnectedComponents, trackClusters } from '../lib/movement'\nimport { createInitialScoreState, updateScore, calculateGenerationScore } from '../lib/scoring'\nimport { ScoreDisplay } from './ScoreDisplay'\nimport { GlassHUD } from './GlassHUD'\nimport { SettingsPanel } from './SettingsPanel'","truncated":true,"loaded":[]},"time":{"start":1771201132216,"end":1771201132219}}}}
