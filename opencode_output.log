ct(canvasMock.getContext).toHaveBeenCalledWith('2d')\n    expect(mockContext.scale).toHaveBeenCalled()\n  })\n\n  it('applies DPR scaling', () => {\n    vi.stubGlobal('window', {\n      ...window,\n      devicePixelRatio: 2,\n      innerWidth: 800,\n    })\n\n    const mockContext = {\n      scale: vi.fn(),\n      fillStyle: '',\n      fillRect: vi.fn(),\n    } as unknown as CanvasRenderingContext2D\n\n    const canvasMock = {\n      getContext: vi.fn().mockReturnValue(mockContext),\n      style: { touchAction: '', width: '', height: '' },\n      width: 300,\n      height: 150,\n    } as unknown as HTMLCanvasElement\n\n    vi.spyOn(document, 'querySelector').mockReturnValue(canvasMock)\n\n    const grid = [\n      [0, 0],\n      [0, 1],\n    ]\n    render(<CanvasGrid grid={grid} showGridLines={false} />)\n\n    expect(mockContext.scale).toHaveBeenCalledWith(2, 2)\n  })\n\n  it('uses provided cellSize', () => {\n    const mockContext = {\n      scale: vi.fn(),\n      fillStyle: '',\n      fillRect: vi.fn(),\n    } as unknown as CanvasRenderingContext2D\n\n    const canvasMock = {\n      getContext: vi.fn().mockReturnValue(mockContext),\n      style: { touchAction: '', width: '', height: '' },\n      width: 300,\n      height: 150,\n    } as unknown as HTMLCanvasElement\n\n    vi.spyOn(document, 'querySelector').mockReturnValue(canvasMock)\n\n    const grid = [\n      [0, 0],\n      [0, 0],\n    ]\n    render(<CanvasGrid grid={grid} showGridLines={false} cellSize={25} />)\n\n    expect(mockContext.scale).toHaveBeenCalled()\n  })\n})\n\ndescribe('getCellColor', () => {\n  it('returns correct color for age 0', () => {\n    expect(getCellColor(0)).toBe('#00ffff')\n  })\n\n  it('returns correct color for age 1', () => {\n    expect(getCellColor(1)).toBe('#61dafb')\n  })\n\n  it('returns correct color for age 2', () => {\n    expect(getCellColor(2)).toBe('#61dafb')\n  })\n\n  it('returns correct color for age 3', () => {\n    expect(getCellColor(3)).toBe('#ff00ff')\n  })\n