"^8.55.0\",\n41:     \"@typescript-eslint/parser\": \"^8.55.0\",\n42:     \"@vitejs/plugin-react\": \"^5.1.4\",\n43:     \"@vitest/ui\": \"^4.0.18\",\n44:     \"eslint\": \"^9.39.2\",\n45:     \"eslint-config-prettier\": \"^10.1.8\",\n46:     \"eslint-plugin-prettier\": \"^5.5.5\",\n47:     \"eslint-plugin-react\": \"^7.37.5\",\n48:     \"eslint-plugin-react-hooks\": \"^7.0.1\",\n49:     \"eslint-plugin-react-refresh\": \"^0.5.0\",\n50:     \"jsdom\": \"^28.1.0\",\n51:     \"prettier\": \"^3.8.1\",\n52:     \"typescript\": \"^5.9.3\",\n53:     \"vite\": \"^7.3.1\",\n54:     \"vitest\": \"^4.0.18\"\n55:   },\n56:   \"dependencies\": {\n57:     \"react\": \"^19.2.4\",\n58:     \"react-dom\": \"^19.2.4\"\n59:   }\n60: }\n61: \n\n(End of file - total 61 lines)\n</content>","title":"package.json","metadata":{"preview":"{\n  \"name\": \"game_of_life\",\n  \"version\": \"0.0.1\",\n  \"description\": \"Conway's Game of Life - A strategic cellular automaton puzzle game\",\n  \"type\": \"module\",\n  \"scripts\": {\n    \"dev\": \"vite\",\n    \"build\": \"tsc -b && vite build\",\n    \"lint\": \"eslint .\",\n    \"typecheck\": \"tsc --noEmit\",\n    \"format\": \"prettier --write \\\"src/**/*.{ts,tsx,css,json,md}\\\"\",\n    \"preview\": \"vite preview\",\n    \"test\": \"vitest\",\n    \"test:ui\": \"vitest --ui\",\n    \"test:run\": \"vitest run\",\n    \"test:coverage\": \"vitest run --coverage\"\n  },\n  \"repository\": {\n    \"type\": \"git\",\n    \"url\": \"git+https://github.com/ochanomizu21/game_of_life_game.git\"","truncated":false,"loaded":[]},"time":{"start":1771219295293,"end":1771219295306}}}}
