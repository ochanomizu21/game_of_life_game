e: 20,\n52:       minVisibleCells: 10,\n53:     },\n54:     audio: {\n55:       enabled: false,\n56:       volume: 0.1,\n57:       waveform: 'sine',\n58:     },\n59:   } as Omit<ExpertSettings, 'preset'>,\n60:   HARD: {\n61:     movementDetection: {\n62:       centroidHistoryLength: 5,\n63:       movementThreshold: 0.7,\n64:       minClusterSize: 2,\n65:     },\n66:     scoring: {\n67:       moverPointsPerGeneration: 8,\n68:       oscillatorPointsPerGeneration: 1,\n69:       scoreMultiplier: 0.8,\n70:     },\n71:     levelGeneration: {\n72:       baseTimeSeconds: 30,\n73:       timeIncrementPerLevel: 10,\n74:       baseFlux: 15,\n75:       difficultyScalingMode: 'MIXED',\n76:     },\n77:     gridSizing: {\n78:       mobileCellSize: 18,\n79:       desktopCellSize: 20,\n80:       minVisibleCells: 10,\n81:     },\n82:     audio: {\n83:       enabled: false,\n84:       volume: 0.1,\n85:       waveform: 'sine',\n86:     },\n87:   } as Omit<ExpertSettings, 'preset'>,\n88:   CHAOS: {\n89:     movementDetection: {\n90:       centroidHistoryLength: 3,\n91:       movementThreshold: 1.0,\n92:       minClusterSize: 1,\n93:     },\n94:     scoring: {\n95:       moverPointsPerGeneration: 20,\n96:       oscillatorPointsPerGeneration: 5,\n97:       scoreMultiplier: 2.0,\n98:     },\n99:     levelGeneration: {\n100:       baseTimeSeconds: 20,\n101:       timeIncrementPerLevel: 5,\n102:       baseFlux: 10,\n103:       difficultyScalingMode: 'EXTREME',\n104:     },\n105:     gridSizing: {\n106:       mobileCellSize: 18,\n107:       desktopCellSize: 20,\n108:       minVisibleCells: 10,\n109:     },\n110:     audio: {\n111:       enabled: false,\n112:       volume: 0.1,\n113:       waveform: 'sawtooth',\n114:     },\n115:   } as Omit<ExpertSettings, 'preset'>,\n116: }\n117: \n118: export function applyPreset(preset: Preset): ExpertSettings {\n119:   return JSON.parse(\n120:     JSON.stringify({\n121:       ...PRESET_CONFIGS[preset],\n122:       preset,\n123:     })\n124:   ) as ExpertSettings\n125: }\n126: \n127: export function getPresetName(preset: Preset): string {\n128:   const names: Record<Preset, string> = {\n129:     EASY: 'Easy',\n130:     NORMAL: 'Normal',\n131:     HARD: 'Hard',\n132:     CHAOS: 'Chaos',\n133:   }\n134:   return names[preset]\n135: }\n136: \n137: export function getPresetDescription(preset: Preset): string {\n138:   const descriptions: Record<Preset, string> = {\n139:     EASY: 'Generous resources and time limits for a relaxed experience',\n140:     NORMAL: 'Balanced gameplay for standard challenge',\n141:     HARD: 'Strict resources and shorter time limits for experienced players',\n142:     CHAOS: 'Extreme settings with rapid changes and high scoring potential',\n143:   }\n144:   return descriptions[preset]\n145: }\n146: \n\n(End of file - total 146 lines)\n</content>","title":"src/lib/presets.ts","metadata":{"preview":"import type { ExpertSettings, Preset } from '../types'\n\nexport const PRESET_CONFIGS: Record<Preset, Omit<ExpertSettings, 'preset'>> = {\n  EASY: {\n    movementDetection: {\n      centroidHistoryLength: 5,\n      movementThreshold: 0.3,\n      minClusterSize: 1,\n    },\n    scoring: {\n      moverPointsPerGeneration: 15,\n      oscillatorPointsPerGeneration: 5,\n      scoreMultiplier: 1.5,\n    },\n    levelGeneration: {\n      baseTimeSeconds: 60,\n      timeIncrementPerLevel: 20,\n      baseFlux: 30,\n      difficultyScalingMode: 'TIME_ONLY',\n    },","truncated":false,"loaded":[]},"time":{"start":1771216224639,"end":1771216224655}}}}
