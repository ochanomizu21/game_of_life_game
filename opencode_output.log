teractionMode === 'ERASE') {\n93:         if (cellExists && phase === 'PLANNING') {\n94:           onInteractionSound?.('erase')\n95:           const newFlux = removeCell(flux, phase)\n96:           const newGrid = grid.map((r, rIdx) =>\n97:             r.map((cell, cIdx) => (rIdx === row && cIdx === col ? 0 : cell))\n98:           )\n99:           onFluxChange(newFlux)\n100:           onGridChange(newGrid)\n\n(File has more lines. Use 'offset' parameter to read beyond line 100)\n</content>","title":"src/components/GridInteraction.tsx","metadata":{"preview":"import { useState, useCallback, useEffect } from 'react'\nimport type { GridType } from '../types'\nimport { CanvasGrid, type CellAnimation } from './CanvasGrid'\nimport { getCellFromEvent, isWithinBounds } from '../lib/interaction'\nimport { canPlaceCell, placeCell, removeCell } from '../lib/flux'\nimport type { FluxState } from '../types'\n\ninterface GridInteractionProps {\n  grid: GridType\n  flux: FluxState\n  phase: 'PLANNING' | 'COUNTDOWN' | 'RUNNING' | 'FINISHED'\n  showGridLines: boolean\n  cellSize?: number\n  onGridChange: (newGrid: GridType) => void\n  onFluxChange: (newFlux: FluxState) => void\n  interactionMode: 'DRAW' | 'ERASE'\n  onInteractionSound?: (type: 'draw' | 'erase') => void\n  onFluxErrorSound?: () => void\n}\n","truncated":true,"loaded":[]},"time":{"start":1771218737310,"end":1771218737312}}}}
