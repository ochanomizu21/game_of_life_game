)\n48:       }\n49:     }\n50: \n51:     lastProcessedScoreRef.current = previousScore\n52:   }, [score, previousScore])\n53: \n54:   useEffect(() => {\n55:     const timer = window.setTimeout(() => {\n56:       setIsPulsing(false)\n57:     }, 200)\n58: \n59:     return () => window.clearTimeout(timer)\n60:   }, [isPulsing])\n61: \n62:   useEffect(() => {\n63:     const timer = window.setTimeout(() => {\n64:       setIsMilestoneFlash(false)\n65:     }, 500)\n66: \n67:     return () => window.clearTimeout(timer)\n68:   }, [isMilestoneFlash])\n69: \n70:   useEffect(() => {\n71:     const duration = 200\n72:     const startTimestamp = window.performance.now()\n73:     const startValue = displayScore\n74:     const endValue = score\n75: \n76:     if (startValue === endValue) return\n77: \n78:     const animate = (currentTime: number) => {\n79:       const elapsed = currentTime - startTimestamp\n80:       const progress = Math.min(elapsed / duration, 1)\n81: \n82:       const easedProgress =\n83:         progress < 0.5 ? 2 * progress * progress : 1 - Math.pow(-2 * progress + 2, 2) / 2\n84: \n85:       setDisplayScore(Math.round(startValue + (endValue - startValue) * easedProgress))\n86: \n87:       if (progress < 1) {\n88:         window.requestAnimationFrame(animate)\n89:       }\n90:     }\n91: \n92:     window.requestAnimationFrame(animate)\n93:   }, [score, displayScore])\n94: \n95:   return (\n96:     <div className=\"score-display-container\">\n97:       <div className=\"score-display\">\n98:         <span\n99:           className={`score-value ${isPulsing ? 'pulse' : ''} ${isMilestoneFlash ? 'milestone-flash' : ''}`}\n100:         >\n101:           {formatScore(displayScore)}\n102:         </span>\n103:         <span className=\"score-label\">PTS</span>\n104:       </div>\n105:       {highScore > 0 && (\n106:         <div className=\"high-score-display\">\n107:           <span className=\"high-score-label\">HIGH:</span>\n108:           <span className=\"high-score-value\">{formatScore(highScore)}</span>\n109:         </div>\n110:       )}\n111:       {showPatternBreakdown && (\n112:         <div className=\"score-breakdown\">\n113:           <div className=\"score-breakdown-item\">\n114:             <span className=\"breakdown-label\">Movers:</span>\n115:             <span className=\"breakdown-value\">{movers}</span>\n116:           </div>\n117:           <div className=\"score-breakdown-item\">\n118:             <span className=\"breakdown-label\">Oscillators:</span>\n119:             <span className=\"breakdown-value\">{oscillators}</span>\n120:           </div>\n121:           <div className=\"score-breakdown-item\">\n122:             <span className=\"breakdown-label\">Rate:</span>\n123:             <span className=\"breakdown-value\">{rate}/gen</span>\n124:           </div>\n125:         </div>\n126:       )}\n127:     </div>\n128:   )\n129: }\n130: \n\n(End of file - total 130 lines)\n</content>","title":"src/components/ScoreDisplay.tsx","metadata":{"preview":"import { useState, useEffect, useRef } from 'react'\nimport { formatScore, isMilestoneReached } from '../lib/scoring'\nimport '../styles/ScoreDisplay.css'\n\ninterface ScoreDisplayProps {\n  score: number\n  previousScore: number\n  movers?: number\n  oscillators?: number\n  rate?: number\n  showPatternBreakdown?: boolean\n  highScore?: number\n}\n\nexport function ScoreDisplay({\n  score,\n  previousScore,\n  movers = 0,\n  oscillators = 0,\n  rate = 0,","truncated":false,"loaded":[]},"time":{"start":1771200364824,"end":1771200364828}}}}
