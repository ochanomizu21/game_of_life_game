.5) return 'orange'\n55:     return 'green'\n56:   }\n57: \n58:   const fluxColor = getFluxColor(flux, fluxMax)\n59: \n60:   return (\n61:     <div className=\"glass-hud-container\">\n62:       <div className=\"glass-hud\">\n63:         <div className=\"hud-controls\">\n64:           <div className=\"hud-group\">\n65:             <button\n66:               className=\"hud-button\"\n67:               onClick={onStep}\n68:               disabled={phase !== 'PLANNING' || !canInteract}\n69:             >\n70:               STEP\n71:             </button>\n72:             <button\n73:               className=\"hud-button active\"\n74:               onClick={onStart}\n75:               disabled={!canStart || !canInteract}\n76:             >\n77:               {phase === 'PLANNING' ? 'START' : 'RUNNING'}\n78:             </button>\n79:             <button className=\"hud-button\" onClick={onRandom} disabled={!canInteract}>\n80:               RANDOM\n81:             </button>\n82:             <button\n83:               className=\"hud-button hud-button-danger\"\n84:               onClick={onClear}\n85:               disabled={!canInteract}\n86:             >\n87:               CLEAR\n88:             </button>\n89:           </div>\n90: \n91:           <div className=\"hud-group\">\n92:             <button\n93:               className={`hud-button ${interactionMode === 'DRAW' ? 'active' : ''}`}\n94:               onClick={() => onSetMode('DRAW')}\n95:               disabled={!canInteract}\n96:             >\n97:               DRAW\n98:             </button>\n99:             <button\n100:               className={`hud-button ${interactionMode === 'ERASE' ? 'active' : ''}`}\n101:               onClick={() => onSetMode('ERASE')}\n102:               disabled={!canInteract}\n103:             >\n104:               ERASE\n105:             </button>\n106:           </div>\n107: \n108:           <div className=\"hud-group\">\n109:             <button\n110:               className={`hud-button ${gridPreset === 'SMALL' ? 'active' : ''}`}\n111:               onClick={() => onSetGridPreset('SMALL')}\n112:               disabled={!canInteract}\n113:             >\n114:               Small\n115:             </button>\n116:             <button\n117:               className={`hud-button ${gridPreset === 'MEDIUM' ? 'active' : ''}`}\n118:               onClick={() => onSetGridPreset('MEDIUM')}\n119:               disabled={!canInteract}\n120:             >\n121:               Medium\n122:             </button>\n123:             <button\n124:               className={`hud-button ${gridPreset === 'LARGE' ? 'active' : ''}`}\n125:               onClick={() => onSetGridPreset('LARGE')}\n126:               disabled={!canInteract}\n127:             >\n128:               Large\n129:             </button>\n130:           </div>\n131: \n132:           <div className=\"hud-group\">\n133:             <button className=\"hud-button\" onClick={onToggleGrid} disabled={!canInteract}>\n134:               {showGridLines ? 'Hide Grid' : 'Show Grid'}\n135:             </button>\n136:             <button className=\"hud-button\" onClick={onToggleSettings}>\n137:               ⚙️\n138:             </button>\n139:           </div>\n140: \n141:           <div className=\"hud-status\">\n142:             <div className=\"hud-status-item\">\n143:               <span className=\"hud-status-label\">Phase:</span>\n144:               <span className=\"hud-status-value\">{phase}</span>\n145:             </div>\n146:             {phase === 'COUNTDOWN' && (\n147:               <div className=\"hud-status-item\">\n148:                 <span className=\"hud-status-label\">Countdown:</span>\n149:                 <span className=\"hud-status-value\">{countdownValue}</span>\n150:               </div>\n151:             )}\n152:             {phase === 'RUNNING' && (\n153:               <div className=\"hud-status-item\">\n154:                 <span className=\"hud-status-label\">Timer:</span>\n