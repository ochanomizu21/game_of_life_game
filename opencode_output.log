{"type":"tool_use","timestamp":1771178816169,"sessionID":"ses_39d873d0fffe1FxcQovLtdjhwD","part":{"id":"prt_c627bf24e001wPpgDQJzyMmJeV","sessionID":"ses_39d873d0fffe1FxcQovLtdjhwD","messageID":"msg_c627bbe37001ESPebeaUX6rVUI","type":"tool","callID":"call_1dbc7cc372434fe7a63dbd83","tool":"read","state":{"status":"completed","input":{"filePath":"/home/ochanomizu/repos/game_of_life/src/components/Game.tsx"},"output":"<path>/home/ochanomizu/repos/game_of_life/src/components/Game.tsx</path>\n<type>file</type>\n<content>1: import { useState, useCallback } from 'react'\n2: import { createGrid, GRID_SIZE_PRESETS, type GridSizePreset } from '../lib/simulation'\n3: import { type GridType, type FluxState, type InteractionMode } from '../types'\n4: import { createInitialFluxState } from '../lib/flux'\n5: import { GridInteraction } from './GridInteraction'\n6: import { usePhaseTimer } from '../hooks/usePhaseTimer'\n7: import { stepSimulation, CONWAY_RULES } from '../lib/simulation'\n8: \n9: export function Game() {\n10:   const [gridPreset, setGridPreset] = useState<GridSizePreset>('SMALL')\n11:   const [grid, setGrid] = useState<GridType>(() => createGrid(20, 30))\n12:   const [flux, setFlux] = useState<FluxState>(() => createInitialFluxState(20))\n13:   const [showGridLines, setShowGridLines] = useState(true)\n14:   const [interactionMode, setInteractionMode] = useState<InteractionMode>('DRAW')\n15:   const [generation, setGeneration] = useState(0)\n16: \n17:   const hasCells = useCallback(() => {\n18:     return grid.flat().filter((cell: number) => cell > 0).length > 0\n19:   }, [grid])\n20: \n21:   const { phaseState, startCountdown } = usePhaseTimer(hasCells)\n22: \n23:   const handleStart = useCallback(() => {\n24:     if (phaseState.current === 'PLANNING' && hasCells()) {\n25:       startCountdown()\n26:     }\n27:   }, [phaseState, startCountdown, hasCells])\n28: \n29:   const handleGridChange = useCallback((newGrid: GridType) => {\n30:     setGrid(newGrid)\n31:     setGeneration(0)\n32:   }, [])\n33: \n34:   const handleFluxChange = useCallback((newFlux: FluxState) => {\n35:     setFlux(newFlux)\n36:   }, [])\n37: \n38:   const handleClear = useCallback(() => {\n39:     const { rows, cols } = GRID_SIZE_PRESETS[gridPreset]\n40:     setGrid(createGrid(rows, cols))\n41:     setFlux(createInitialFluxState(20))\n42:     setGeneration(0)\n43:   }, [gridPreset])\n44: \n45:   const handleRandom = useCallback(() => {\n46:     const { rows, cols } = GRID_SIZE_PRESETS[gridPreset]\n47:     const newGrid = createGrid(rows, cols)\n48:     const density = 0.15\n49: \n50:     for (let row = 0; row < rows; row++) {\n51:       for (let col = 0; col < cols; col++) {\n52:         if (Math.random() < density) {\n53:           newGrid[row][col] = 1\n54:         }\n55:       }\n56:     }\n57: \n58:     setGrid(newGrid)\n59:     setFlux(createInitialFluxState(20))\n60:     setGeneration(0)\n61:   }, [gridPreset])\n62: \n63:   const aliveCount = grid.flat().filter((cell: number) => cell > 0).length\n64: \n65:   const handleStep = useCallback(() => {\n66:     if (phaseState.current !== 'PLANNING') return\n67: \n68:     const currentState = {\n69:       grid,\n70:       generation,\n71:       running: false,\n72:       speed: 100,\n73:       selectedRule: CONWAY_RULES,\n74:     }\n75: \n76:     const result = stepSimulation(currentState)\n77:     setGrid(result.newGrid)\n78:     setGeneration(result.newGeneration)\n79:   }, [phaseState, grid, generation])\n80: \n81:   return (\n82:     <div style={{ padding: '20px', backgroundColor: '#0a0a0f', minHeight: '100vh', color: '#fff' }}>\n83:       <h1 style={{ textAlign: 'center', marginBottom: '20px', color: '#61dafb' }}>\n84:         Conway's Game of Life\n85:       </h1>\n86: \n87:       <div style={{ marginBottom: '20px', textAlign: 'center' }}>\n88:         <div\n89:           style={{ display: 'flex', justifyContent: 'center', gap: '10px', marginBottom: '10px' }}\n90:         >\n91:           <button\n92:             onClick={() => setGridPreset('SMALL')}\n93:             disabled={phaseState.current !== 'PLANNING'}\n94:           >\n95:             Small\n96:           </button>\n97:           <button\n98:             onClick={() => setGridPreset('MEDIUM')}\n99:             disabled={phaseState.current !== 'PLANNING'}\n100:           >\n101:             Medium\n102:           </button>\n103:           <button\n104:             onClick={() => setGridPreset('LARGE')}\n105:             disabled={phaseState.current !== 'PLANNING'}\n106:           >\n107:             Large\n108:           </button>\n109:         </div>\n110: \n111:         <div\n112:           style={{ display: 'flex', justifyContent: 'center', gap: '10px', marginBottom: '10px' }}\n113:         >\n114:           <button onClick={handleStep} disabled={phaseState.current !== 'PLANNING'}>\n115:             STEP\n116:           </button>\n117:           <button\n118:             onClick={handleStart}\n119:             disabled={phaseState.current !== 'PLANNING' || aliveCount === 0}\n120:           >\n121:             {phaseState.current === 'PLANNING' ? 'Start' : 'Running'}\n122:           </button>\n123:           <button onClick={handleClear} disabled={phaseState.current !== 'PLANNING'}>\n124:             Clear\n125:           </button>\n126:           <button onClick={handleRandom} disabled={phaseState.current !== 'PLANNING'}>\n127:             Random\n128:           </button>\n129:         </div>\n130: \n131:         <div\n132:           style={{ display: 'flex', justifyContent: 'center', gap: '10px', marginBottom: '10px' }}\n133:         >\n134:           <button\n135:             onClick={() => setShowGridLines(!showGridLines)}\n136:             disabled={phaseState.current !== 'PLANNING'}\n137:           >\n138:             {showGridLines ? 'Hide Grid' : 'Show Grid'}\n139:           </button>\n140:         </div>\n141: \n142:         <div\n143:           style={{ display: 'flex', justifyContent: 'center', gap: '10px', marginBottom: '10px' }}\n144:         >\n145:           <button\n146:             onClick={() => setInteractionMode('DRAW')}\n147:             disabled={phaseState.current !== 'PLANNING'}\n148:             style={{ backgroundColor: interactionMode === 'DRAW' ? '#61dafb' : '#1a1a1a' }}\n149:           >\n150:             Draw\n151:           </button>\n152:           <button\n153:             onClick={() => setInteractionMode('ERASE')}\n154:             disabled={phaseState.current !== 'PLANNING'}\n155:             style={{ backgroundColor: interactionMode === 'ERASE' ? '#61dafb' : '#1a1a1a' }}\n156:           >\n157:             Erase\n158:           </button>\n159:         </div>\n160:       </div>\n161: \n162:       <div style={{ display: 'flex', justifyContent: 'center', marginBottom: '20px' }}>\n163:         <div\n164:           style={{\n165:             display: 'flex',\n166:             gap: '30px',\n167:             padding: '10px 20px',\n168:             backgroundColor: 'rgba(26, 26, 46, 0.8)',\n169:             borderRadius: '8px',\n170:             backdropFilter: 'blur(10px)',\n171:           }}\n172:         >\n173:           <div>Phase: {phaseState.current}</div>\n174:           {phaseState.current === 'COUNTDOWN' && <div>Countdown: {phaseState.countdownValue}</div>}\n175:           {phaseState.current === 'RUNNING' && <div>Timer: {phaseState.timerRemaining}s</div>}\n176:           <div>GEN: {generation}</div>\n177:           <div>Cells: {aliveCount}</div>\n178:           <div\n179:             style={{\n180:               color: flux.current > 10 ? '#00ff00' : flux.current > 5 ? '#ffaa00' : '#ff0000',\n181:             }}\n182:           >\n183:             Flux: {flux.current}\n184:           </div>\n185:         </div>\n186:       </div>\n187: \n188:       <div style={{ display: 'flex', justifyContent: 'center' }}>\n189:         <GridInteraction\n190:           grid={grid}\n191:           flux={flux}\n192:           phase={phaseState.current}\n193:           showGridLines={showGridLines}\n194:           onGridChange={handleGridChange}\n195:           onFluxChange={handleFluxChange}\n196:           interactionMode={interactionMode}\n197:         />\n198:       </div>\n199:     </div>\n200:   )\n201: }\n202: \n\n(End of file - total 202 lines)\n</content>","title":"src/components/Game.tsx","metadata":{"preview":"import { useState, useCallback } from 'react'\nimport { createGrid, GRID_SIZE_PRESETS, type GridSizePreset } from '../lib/simulation'\nimport { type GridType, type FluxState, type InteractionMode } from '../types'\nimport { createInitialFluxState } from '../lib/flux'\nimport { GridInteraction } from './GridInteraction'\nimport { usePhaseTimer } from '../hooks/usePhaseTimer'\nimport { stepSimulation, CONWAY_RULES } from '../lib/simulation'\n\nexport function Game() {\n  const [gridPreset, setGridPreset] = useState<GridSizePreset>('SMALL')\n  const [grid, setGrid] = useState<GridType>(() => createGrid(20, 30))\n  const [flux, setFlux] = useState<FluxState>(() => createInitialFluxState(20))\n  const [showGridLines, setShowGridLines] = useState(true)\n  const [interactionMode, setInteractionMode] = useState<InteractionMode>('DRAW')\n  const [generation, setGeneration] = useState(0)\n\n  const hasCells = useCallback(() => {\n    return grid.flat().filter((cell: number) => cell > 0).length > 0\n  }, [grid])\n","truncated":false,"loaded":[]},"time":{"start":1771178816095,"end":1771178816159}}}}
