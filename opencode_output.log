f = useRef<TrackedCluster[]>([])\n31:   const simulationSpeed = 200\n32: \n33:   const movementConfig = createInitialMovementDetectionParams()\n34:   const scoringConfig = createInitialScoringConfig()\n35: \n36:   const [previousScore, setPreviousScore] = useState(0)\n37: \n38:   const hasCells = useCallback(() => {\n39:     return grid.flat().filter((cell: number) => cell > 0).length > 0\n40:   }, [grid])\n41: \n42:   const { phaseState, startCountdown } = usePhaseTimer(hasCells)\n43: \n44:   const handleSimulationStep = useCallback(() => {\n45:     const currentState = {\n46:       grid,\n47:       generation,\n48:       running: true,\n49:       speed: simulationSpeed,\n50:       selectedRule: CONWAY_RULES,\n51:     }\n52: \n53:     const result = stepSimulation(currentState)\n54: \n55:     const currentClusters = findConnectedComponents(result.newGrid, result.newGeneration)\n56:     const tracked = trackClusters(\n57:       currentClusters,\n58:       previousTrackedClustersRef.current,\n59:       movementConfig\n60:     )\n61: \n62:     const generationScore = calculateGenerationScore(tracked, scoringConfig)\n63:     const newScoreState = updateScore(scoreState, generationScore)\n64: \n65:     setPreviousScore(scoreState.currentScore)\n66:     previousTrackedClustersRef.current = tracked\n67:     setScoreState(newScoreState)\n68:     setGrid(result.newGrid)\n69:     setGeneration(result.newGeneration)\n70:   }, [grid, generation, simulationSpeed, scoreState, movementConfig, scoringConfig])\n71: \n72:   useEffect(() => {\n73:     let interval: number | undefined\n74: \n75:     if (phaseState.current === 'RUNNING') {\n76:       interval = window.setInterval(() => {\n77:         handleSimulationStep()\n78:       }, simulationSpeed)\n79:     }\n80: \n81:     return () => {\n82:       if (interval) {\n83:         window.clearInterval(interval)\n84:       }\n85:     }\n86:   }, [phaseState, simulationSpeed, handleSimulationStep])\n87: \n88:   const handleStart = useCallback(() => {\n89:     if (phaseState.current === 'PLANNING' && hasCells()) {\n90:       startCountdown()\n91:     }\n92:   }, [phaseState, startCountdown, hasCells])\n93: \n94:   const handleGridChange = useCallback((newGrid: GridType) => {\n95:     setGrid(newGrid)\n96:     setGeneration(0)\n97:   }, [])\n98: \n99:   const handleFluxChange = useCallback((newFlux: FluxState) => {\n100:     setFlux(newFlux)\n101:   }, [])\n102: \n103:   const handleClear = useCallback(() => {\n104:     const { rows, cols } = GRID_SIZE_PRESETS[gridPreset]\n105:     setGrid(createGrid(rows, cols))\n106:     setFlux(createInitialFluxState(20))\n107:     setGeneration(0)\n108:     setScoreState(createInitialScoreState())\n109:     previousTrackedClustersRef.current = []\n110:   }, [gridPreset])\n111: \n112:   const handleRandom = useCallback(() => {\n113:     const { rows, cols } = GRID_SIZE_PRESETS[gridPreset]\n114:     const newGrid = createGrid(rows, cols)\n115:     const density = 0.15\n116: \n117:     for (let row = 0; row < rows; row++) {\n118:       for (let col = 0; col < cols; col++) {\n119:         if (Math.random() < density) {\n120:           newGrid[row][col] = 1\n121:         }\n122:       }\n123:     }\n124: \n125:     setGrid(newGrid)\n126:     setFlux(createInitialFluxState(20))\n127:     setGeneration(0)\n128:     setScoreState(createInitialScoreState())\n129:     previousTrackedClustersRef.current = []\n130:   }, [gridPreset])\n131: \n132:   const aliveCount = grid.flat().filter((cell: number) => cell > 0).length\n133: \n134:   const handleStep = useCallback(() => {\n135:     if (phaseState.current !== 'PLANNING') return\n136: \n137:     const currentState = {\n138:       grid,\n139:       generation,\n140:       running: false,\n141:       speed: 100,\n142:       selectedRule: CONWAY_RULES,\n143:     }\n144: \n145:     const result = stepSimulation(currentState)\n146:     setGrid(result.newGrid)\n147:     setGeneration(result.newGeneration)\n148:   }, [phaseState, grid, generation])\n149: \n150:   return (\n\n(File has more lines. Use 'offset' parameter to read beyond line 150)\n</content>","title":"src/components/Game.tsx","metadata":{"preview":"import { useState, useCallback, useEffect, useRef } from 'react'\nimport { createGrid, GRID_SIZE_PRESETS, type GridSizePreset } from '../lib/simulation'\nimport { type GridType, type FluxState, type InteractionMode, type TrackedCluster } from '../types'\nimport { createInitialFluxState } from '../lib/flux'\nimport { GridInteraction } from './GridInteraction'\nimport { usePhaseTimer } from '../hooks/usePhaseTimer'\nimport { stepSimulation, CONWAY_RULES } from '../lib/simulation'\nimport {\n  findConnectedComponents,\n  trackClusters,\n  createInitialMovementDetectionParams,\n} from '../lib/movement'\nimport {\n  createInitialScoreState,\n  createInitialScoringConfig,\n  updateScore,\n  calculateGenerationScore,\n} from '../lib/scoring'\nimport { ScoreDisplay } from './ScoreDisplay'\n","truncated":true,"loaded":[]},"time":{"start":1771180692265,"end":1771180692269}}}}
