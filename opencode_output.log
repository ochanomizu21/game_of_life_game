   }\n                className=\"settings-slider\"\n              />\n            </div>\n            <div className=\"setting-help\">\n              Size of each cell on desktop devices (16-28px)\n            </div>\n          </section>"},"output":"Edit applied successfully.","title":"src/components/SettingsPanel.tsx","metadata":{"diagnostics":{"/home/ochanomizu/repos/game_of_life/src/components/SettingsPanel.tsx":[],"/home/ochanomizu/repos/game_of_life/src/lib/presets.ts":[]},"diff":"Index: /home/ochanomizu/repos/game_of_life/src/components/SettingsPanel.tsx\n===================================================================\n--- /home/ochanomizu/repos/game_of_life/src/components/SettingsPanel.tsx\n+++ /home/ochanomizu/repos/game_of_life/src/components/SettingsPanel.tsx\n@@ -286,8 +286,11 @@\n         <option value=\"HARD\">Hard</option>\n         <option value=\"CHAOS\">Chaos</option>\n       </select>\n     </div>\n+    <div className=\"setting-help\">\n+      Quickly apply balanced difficulty presets that adjust multiple settings at once\n+    </div>\n   </section>\n   <section className=\"settings-section\">\n     <h3>Audio</h3>\n     <div className=\"settings-row\">\n@@ -300,8 +303,11 @@\n         />\n         Enable Sonification\n       </label>\n     </div>\n+    <div className=\"setting-help\">\n+      Generate sounds based on cell births and user interactions\n+    </div>\n     <div className=\"settings-row\">\n       <label htmlFor=\"audio-volume\">\n         Volume: {(localSettings.audio.volume * 100).toFixed(0)}%\n       </label>\n@@ -315,8 +321,9 @@\n         onChange={(e) => handleUpdate('audio.volume', parseFloat(e.target.value))}\n         className=\"settings-slider\"\n       />\n     </div>\n+    <div className=\"setting-help\">Master volume for all game sounds (0-50%)</div>\n     <div className=\"settings-row\">\n       <label htmlFor=\"audio-waveform\">Waveform</label>\n       <select\n         id=\"audio-waveform\"\n@@ -334,8 +341,11 @@\n  