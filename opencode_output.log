{"type":"tool_use","timestamp":1771200425387,"sessionID":"ses_39c3dcac5ffezeoS1NttWkQaSO","part":{"id":"prt_c63c5ad970010pzFdrkIv2R0gK","sessionID":"ses_39c3dcac5ffezeoS1NttWkQaSO","messageID":"msg_c63c59bed001AbOQgBMRdRkBLU","type":"tool","callID":"call_854fb2c074834f7c9c46c996","tool":"read","state":{"status":"completed","input":{"filePath":"/home/ochanomizu/repos/game_of_life/src/components/GlassHUD.test.tsx"},"output":"<path>/home/ochanomizu/repos/game_of_life/src/components/GlassHUD.test.tsx</path>\n<type>file</type>\n<content>1: import { describe, it, expect, vi } from 'vitest'\n2: import { render, screen } from '@testing-library/react'\n3: import userEvent from '@testing-library/user-event'\n4: import { GlassHUD } from './GlassHUD'\n5: \n6: describe('GlassHUD', () => {\n7:   const defaultProps = {\n8:     phase: 'PLANNING' as const,\n9:     aliveCount: 10,\n10:     flux: 20,\n11:     fluxMax: 20,\n12:     interactionMode: 'DRAW' as const,\n13:     gridPreset: 'SMALL' as const,\n14:     showGridLines: true,\n15:     generation: 0,\n16:     countdownValue: undefined as number | undefined,\n17:     timerRemaining: undefined as number | undefined,\n18:     canStart: true,\n19:     canInteract: true,\n20:     onStart: vi.fn(),\n21:     onStep: vi.fn(),\n22:     onClear: vi.fn(),\n23:     onRandom: vi.fn(),\n24:     onToggleGrid: vi.fn(),\n25:     onSetMode: vi.fn(),\n26:     onSetGridPreset: vi.fn(),\n27:     onToggleSettings: vi.fn(),\n28:   }\n29: \n30:   it('should render all control groups', () => {\n31:     render(<GlassHUD {...defaultProps} />)\n32: \n33:     expect(screen.getByText('START')).toBeInTheDocument()\n34:     expect(screen.getByText('RANDOM')).toBeInTheDocument()\n35:     expect(screen.getByText('CLEAR')).toBeInTheDocument()\n36:     expect(screen.getByText('DRAW')).toBeInTheDocument()\n37:     expect(screen.getByText('ERASE')).toBeInTheDocument()\n38:     expect(screen.getByText('Small')).toBeInTheDocument()\n39:     expect(screen.getByText('Medium')).toBeInTheDocument()\n40:     expect(screen.getByText('Large')).toBeInTheDocument()\n41:   })\n42: \n43:   it('should render status display', () => {\n44:     render(<GlassHUD {...defaultProps} />)\n45: \n46:     expect(screen.getByText('Phase:')).toBeInTheDocument()\n47:     expect(screen.getByText('Cells:')).toBeInTheDocument()\n48:     expect(screen.getByText('Flux:')).toBeInTheDocument()\n49:     expect(screen.getByText('PLANNING')).toBeInTheDocument()\n50:     expect(screen.getByText('10')).toBeInTheDocument()\n51:     expect(screen.getByText('20')).toBeInTheDocument()\n52:   })\n53: \n54:   it('should call onStart when START button clicked', async () => {\n55:     const user = userEvent.setup()\n56:     render(<GlassHUD {...defaultProps} />)\n57: \n58:     const startButton = screen.getByText('START')\n59:     await user.click(startButton)\n60: \n61:     expect(defaultProps.onStart).toHaveBeenCalledTimes(1)\n62:   })\n63: \n64:   it('should call onRandom when RANDOM button clicked', async () => {\n65:     const user = userEvent.setup()\n66:     render(<GlassHUD {...defaultProps} />)\n67: \n68:     const randomButton = screen.getByText('RANDOM')\n69:     await user.click(randomButton)\n70: \n71:     expect(defaultProps.onRandom).toHaveBeenCalledTimes(1)\n72:   })\n73: \n74:   it('should call onClear when CLEAR button clicked', async () => {\n75:     const user = userEvent.setup()\n76:     render(<GlassHUD {...defaultProps} />)\n77: \n78:     const clearButton = screen.getByText('CLEAR')\n79:     await user.click(clearButton)\n80: \n81:     expect(defaultProps.onClear).toHaveBeenCalledTimes(1)\n82:   })\n83: \n84:   it('should call onSetMode when mode buttons clicked', async () => {\n85:     const user = userEvent.setup()\n86:     render(<GlassHUD {...defaultProps} />)\n87: \n88:     await user.click(screen.getByText('ERASE'))\n89:     expect(defaultProps.onSetMode).toHaveBeenCalledWith('ERASE')\n90: \n91:     await user.click(screen.getByText('DRAW'))\n92:     expect(defaultProps.onSetMode).toHaveBeenCalledWith('DRAW')\n93:   })\n94: \n95:   it('should call onSetGridPreset when size buttons clicked', async () => {\n96:     const user = userEvent.setup()\n97:     render(<GlassHUD {...defaultProps} />)\n98: \n99:     await user.click(screen.getByText('Medium'))\n100:     expect(defaultProps.onSetGridPreset).toHaveBeenCalledWith('MEDIUM')\n101: \n102:     await user.click(screen.getByText('Large'))\n103:     expect(defaultProps.onSetGridPreset).toHaveBeenCalledWith('LARGE')\n104:   })\n105: \n106:   it('should call onToggleGrid when grid toggle clicked', async () => {\n107:     const user = userEvent.setup()\n108:     render(<GlassHUD {...defaultProps} />)\n109: \n110:     const gridButton = screen.getByText('Hide Grid')\n111:     await user.click(gridButton)\n112: \n113:     expect(defaultProps.onToggleGrid).toHaveBeenCalledTimes(1)\n114:   })\n115: \n116:   it('should call onToggleSettings when settings clicked', async () => {\n117:     const user = userEvent.setup()\n118:     render(<GlassHUD {...defaultProps} />)\n119: \n120:     const settingsButton = screen.getByText('⚙️')\n121:     await user.click(settingsButton)\n122: \n123:     expect(defaultProps.onToggleSettings).toHaveBeenCalledTimes(1)\n124:   })\n125: \n126:   it('should disable interaction when canInteract is false', () => {\n127:     render(<GlassHUD {...defaultProps} canInteract={false} />)\n128: \n129:     expect(screen.getByText('START')).toBeDisabled()\n130:     expect(screen.getByText('RANDOM')).toBeDisabled()\n131:     expect(screen.getByText('CLEAR')).toBeDisabled()\n132:     expect(screen.getByText('DRAW')).toBeDisabled()\n133:     expect(screen.getByText('ERASE')).toBeDisabled()\n134:     expect(screen.getByText('Small')).toBeDisabled()\n135:   })\n136: \n137:   it('should disable START when canStart is false', () => {\n138:     render(<GlassHUD {...defaultProps} canStart={false} />)\n139: \n140:     expect(screen.getByText('START')).toBeDisabled()\n141:     expect(screen.getByText('RANDOM')).not.toBeDisabled()\n142:   })\n143: \n144:   it('should show Show Grid when grid lines are hidden', () => {\n145:     render(<GlassHUD {...defaultProps} showGridLines={false} />)\n146: \n147:     expect(screen.getByText('Show Grid')).toBeInTheDocument()\n148:     expect(screen.queryByText('Hide Grid')).not.toBeInTheDocument()\n149:   })\n150: \n151:   it('should display flux color based on value', () => {\n152:     const { rerender } = render(<GlassHUD {...defaultProps} flux={20} fluxMax={20} />)\n153:     const fluxValue = screen.getByText('20')\n154:     expect(fluxValue).toHaveClass('hud-status-value', 'green')\n155: \n156:     rerender(<GlassHUD {...defaultProps} flux={5} fluxMax={20} />)\n157:     expect(fluxValue).toHaveClass('hud-status-value', 'orange')\n158: \n159:     rerender(<GlassHUD {...defaultProps} flux={0} fluxMax={20} />)\n160:     expect(fluxValue).toHaveClass('hud-status-value', 'red')\n161:   })\n162: \n163:   it('should highlight active interaction mode', () => {\n164:     const { container: container1 } = render(<GlassHUD {...defaultProps} interactionMode=\"DRAW\" />)\n165:     expect(container1.querySelectorAll('.hud-button')[4]).toHaveClass('active')\n166:     expect(container1.querySelectorAll('.hud-button')[5]).not.toHaveClass('active')\n167: \n168:     const { container: container2 } = render(<GlassHUD {...defaultProps} interactionMode=\"ERASE\" />)\n169:     expect(container2.querySelectorAll('.hud-button')[5]).toHaveClass('active')\n170:     expect(container2.querySelectorAll('.hud-button')[4]).not.toHaveClass('active')\n171:   })\n172: \n173:   it('should highlight active grid preset', () => {\n174:     const { container: container1 } = render(<GlassHUD {...defaultProps} gridPreset=\"SMALL\" />)\n175:     const gridButtons = Array.from(container1.querySelectorAll('.hud-button')).filter((btn) =>\n176:       ['Small', 'Medium', 'Large'].includes(btn.textContent || '')\n177:     )\n178:     const activeSmall = gridButtons.find((btn) => btn.textContent === 'Small')\n179:     const inactiveOthers = gridButtons.filter((btn) => btn.textContent !== 'Small')\n180:     expect(activeSmall).toHaveClass('active')\n181:     expect(inactiveOthers.every((btn) => !btn.classList.contains('active'))).toBe(true)\n182: \n183:     const { container: container2 } = render(<GlassHUD {...defaultProps} gridPreset=\"MEDIUM\" />)\n184:     const gridButtons2 = Array.from(container2.querySelectorAll('.hud-button')).filter((btn) =>\n185:       ['Small', 'Medium', 'Large'].includes(btn.textContent || '')\n186:     )\n187:     const activeMedium = gridButtons2.find((btn) => btn.textContent === 'Medium')\n188:     expect(activeMedium).toHaveClass('active')\n189:   })\n190: \n191:   it('should show RUNNING text when phase is not PLANNING', () => {\n192:     render(<GlassHUD {...defaultProps} phase=\"RUNNING\" />)\n193:     expect(screen.getAllByText('RUNNING')[1]).toBeInTheDocument()\n194:     expect(screen.queryByText('START')).not.toBeInTheDocument()\n195:   })\n196: })\n197: \n\n(End of file - total 197 lines)\n</content>","title":"src/components/GlassHUD.test.tsx","metadata":{"preview":"import { describe, it, expect, vi } from 'vitest'\nimport { render, screen } from '@testing-library/react'\nimport userEvent from '@testing-library/user-event'\nimport { GlassHUD } from './GlassHUD'\n\ndescribe('GlassHUD', () => {\n  const defaultProps = {\n    phase: 'PLANNING' as const,\n    aliveCount: 10,\n    flux: 20,\n    fluxMax: 20,\n    interactionMode: 'DRAW' as const,\n    gridPreset: 'SMALL' as const,\n    showGridLines: true,\n    generation: 0,\n    countdownValue: undefined as number | undefined,\n    timerRemaining: undefined as number | undefined,\n    canStart: true,\n    canInteract: true,\n    onStart: vi.fn(),","truncated":false,"loaded":[]},"time":{"start":1771200425371,"end":1771200425383}}}}
