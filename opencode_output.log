setProgression,\n36:   saveHighScore,\n37:   getHighScore,\n38: } from '../lib/level'\n39: import { SoundEngine } from '../lib/audio'\n40: \n41: export function Game() {\n42:   const [gridPreset, setGridPreset] = useState<GridSizePreset>('SMALL')\n43:   const [grid, setGrid] = useState<GridType>(() => createGrid(20, 30))\n44:   const [flux, setFlux] = useState<FluxState>(() => createInitialFluxState(20))\n45:   const [showGridLines, setShowGridLines] = useState(true)\n46:   const [interactionMode, setInteractionMode] = useState<InteractionMode>('DRAW')\n47:   const [generation, setGeneration] = useState(0)\n48:   const [scoreState, setScoreState] = useState(() => createInitialScoreState())\n49:   const [settingsPanelOpen, setSettingsPanelOpen] = useState(false)\n50:   const [expertSettings, setExpertSettings] = useState<ExpertSettings>(() => {\n51:     const saved = loadFromLocalStorage<ExpertSettings>(\n52:       'gol-expert-settings',\n53:       createInitialExpertSettings()\n54:     )\n55:     return saved\n56:   })\n57:   const [levelProgression, setLevelProgression] = useState<LevelProgression>(() =>\n58:     generateProgression(createInitialExpertSettings().levelGeneration)\n59:   )\n60:   const [showVictory, setShowVictory] = useState(false)\n61:   const [isUiVisible, setIsUiVisible] = useState(true)\n62:   const [highScore, setHighScore] = useState(0)\n63:   const [trackedClusters, setTrackedClusters] = useState<TrackedCluster[]>([])\n64:   const [levelStats, setLevelStats] = useState<{\n65:     finalScore: number\n66:     highScore: number\n67:     timeLimitSeconds: number\n68:     timeRemaining: number\n69:     finalGeneration: number\n70:     finalAliveCount: number\n71:     moversCount: number\n72:     oscillatorsCount: number\n73:     staticCount: number\n74:     totalPatternsTracked: number\n75:   } | null>(null)\n76: \n77:   const previousTrackedClustersRef = useRef<TrackedCluster[]>([])\n78:   const previousPhaseRef = useRef<'PLANNING' | 'COUNTDOWN' | 'RUNNING' | 'FINISHED'>('PLANNING')\n79:   const simulationSpeed = 200\n80:   const soundEngineRef = useRef<SoundEngine | null>(null)\n81: \n82:   const {\n83:     enabled: audioEnabled,\n84:     volume: audioVolume,\n85:     waveform: audioWaveform,\n86:   } = expertSettings.audio\n87: \n88:   const handleInteractionSound = useCallback((type: 'draw' | 'erase') => {\n89:     soundEngineRef.current?.playInteractionSound(type)\n90:   }, [])\n91: \n92:   const handleTransitionSound = useCallback((type: 'fade-out' | 'fade-in') => {\n93:     soundEngineRef.current?.playTransitionSound(type)\n94:   }, [])\n95: \n96:   const handleFluxErrorSound = useCallback(() => {\n97:     soundEngineRef.current?.playFluxErrorSound()\n98:   }, [])\n99: \n100:   useEffect(() => {\n101:     if (!soundEngineRef.current) {\n102:       soundEngineRef.current = new SoundEngine()\n103:     }\n104:     soundEngineRef.current.setEnabled(audioEnabled)\n105:     soundEngineRef.current.setVolume(audioVolume)\n106:     soundEngineRef.current.setWaveform(audioWaveform)\n107:   }, [audioEnabled, audioVolume, audioWaveform])\n108: \n109:   useEffect(() => {\n110:     const handleKeyDown = (e: KeyboardEvent) => {\n111:       if (e.code === 'Backquote') {\n112:         e.preventDefault()\n113:         setSettingsPanelOpen((prev) => !prev)\n114:       }\n115:       if (e.code === 'KeyG') {\n116:         e.preventDefault()\n117:         setShowGridLines((prev) => !prev)\n118:       }\n119:     }\n120: \n121:     window.addEventListener('keydown', handleKeyDown)\n122:     return () => {\n123:       window.removeEventListener('keydown', handleKeyDown)\n124:     }\n125:   }, [])\n126: \n127:   useTripleTapGesture({\n128:     threshold: 100,\n129:     maxTimeBetweenTaps: 500,\n130:     onTripleTap: useCallback(() => {\n131:       setSettingsPanelOpen((prev) => !prev)\n132:     }, []),\n133:   })\n134: \n135:   const currentLevelConfig = getCurrentLevelConfig(levelProgression)\n136: \n137:   useEffect(() => {\n138:     if (currentLevelConfig) {\n139:       window.requestAnimationFrame(() => {\n140:         setHighScore(getHighScore(currentLevelConfig.levelNumber))\n141:       })\n142:     }\n143:   }, [currentLevelConfig])\n144: \n145:   const movementConfig = expertSettings.movementDetection\n146:   const scoringConfig = expertSettings.scoring\n147: \n148:   const handleTransitionComplete = useCallback(() => {\n149:     soundEngineRef.current?.playLevelStartSound()\n150: \n151:     if (isFinalLevel(levelProgression)) {\n152:       const updatedProgression: LevelProgression = {\n153:         ...levelProgression,\n154:         totalScore: levelProgression.totalScore + scoreState.currentScore,\n155:         currentLevel: levelProgression.currentLevel + 1,\n156:         maxUnlockedLevel: Math.max(\n157:           levelProgression.maxUnlockedLevel,\n158:           levelProgression.currentLevel + 1\n159:         ),\n160:       }\n161:       setLevelProgression(updatedProgression)\n162:       setShowVictory(true)\n163:     } else {\n164:       const newProgression = advanceLevel(levelProgression, scoreState.currentScore)\n165:       const newLevelConfig = getCurrentLevelConfig(newProgression)\n166: \n167:       setLevelProgression(newProgression)\n168:       const { rows, cols } = GRID_SIZE_PRESETS[gridPreset]\n169:       setGrid(createGrid(rows, cols))\n170:       setFlux(createInitialFluxState(newLevelConfig?.initialFlux ?? 20))\n171:       setGeneration(0)\n172:       setScoreState(createInitialScoreState())\n173:       previousTrackedClustersRef.current = []\n174:       setLevelStats(null)\n175:     }\n176:   }, [levelProgression, scoreState.currentScore, gridPreset])\n177: \n178:   const { transitionState, startTransition, resetTransition } = useTransition(\n179:     {\n180:       fadeOutDuration: 2000,\n181:       fadeInDuration: 2000,\n182:       interstitialDuration: 2000,\n183:       autoAdvanceDelay: 2000,\n184:       skipEnabled: true,\n185:     },\n186:     handleTransitionComplete,\n187:     handleTransitionSound\n188:   )\n189: \n190:   const [previousScore, setPreviousScore] = useState(0)\n191: \n192:   const hasCells = useCallback(() => {\n193:     return grid.flat().filter((cell: number) => cell > 0).length > 0\n194:   }, [grid])\n195: \n196:   const { phaseState, startCountdown, startRunning } = usePhaseTimer(hasCells)\n197: \n198:   useEffect(() => {\n199:     if (previousPhaseRef.current === 'COUNTDOWN' && phaseState.current === 'RUNNING') {\n200:       soundEngineRef.current?.playSimulationStartSound()\n201:     }\n202:     previousPhaseRef.current = phaseState.current\n203:   }, [phaseState.current])\n204: \n205:   useEffect(() => {\n206:     if (phaseState.current === 'FINISHED') {\n207:       window.setTimeout(() => {\n208:         if (!showVictory) {\n209:           startTransition()\n210:           soundEngineRef.current?.playLevelCompleteSound()\n211:         }\n212:       }, 2000)\n213:     }\n214:   }, [phaseState, showVictory, startTransition])\n215: \n216:   useEffect(() => {\n217:     if (transitionState === 'READY') {\n218:       window.setTimeout(() => {\n219:         resetTransition()\n220:       }, 100)\n221:     }\n222:   }, [transitionState, resetTransition])\n223: \n224:   useEffect(() => {\n225:     if (phaseState.current === 'FINISHED' && currentLevelConfig && scoreState.currentScore > 0) {\n226:       saveHighScore(currentLevelConfig.levelNumber, scoreState.currentScore)\n227:       window.requestAnimationFrame(() => {\n228:         setHighScore(getHighScore(currentLevelConfig.levelNumber))\n229:       })\n230: \n231:       const staticCount = trackedClusters.filter((c) => c.classification === 'STATIC').length\n232:       const movers = trackedClusters.filter((c) => c.classification === 'MOVER').length\n233:       const oscillators = trackedClusters.filter((c) => c.classification === 'OSCILLATOR').length\n234:       const aliveCount = grid.flat().filter((cell: number) => cell > 0).length\n235: \n236:       setLevelStats({\n237:         finalScore: scoreState.currentScore,\n238:         highScore: getHighScore(currentLevelConfig.levelNumber),\n239:         timeLimitSeconds: currentLevelConfig.timeLimitSeconds,\n240:         timeRemaining: phaseState.timerRemaining,\n241:         finalGeneration: generation,\n242:         finalAliveCount: aliveCount,\n243:         moversCount: movers,\n244:         oscillatorsCount: oscillators,\n245:         staticCount: staticCount,\n246:         totalPatternsTracked: scoreState.totalPatternsTracked,\n247:       })\n248:     }\n249:   }, [phaseState, currentLevelConfig, scoreState, generation, grid, trackedClusters])\n250: \n251:   const handleSimulationStep = useCallback(() => {\n252:     const currentState = {\n253:       grid,\n254:       generation,\n255:       running: true,\n256:       speed: simulationSpeed,\n257:       selectedRule: CONWAY_RULES,\n258:     }\n259: \n260:     const result = stepSimulation(currentState)\n261: \n262:     if (result.bornCount > 0) {\n263:       const totalRows = grid.length\n264:       soundEngineRef.current?.playGenerationSound(result.bornCount, result.averageRow, totalRows)\n265:     }\n266: \n267:     const currentClusters = findConnectedComponents(result.newGrid, result.newGeneration)\n268:     const tracked = trackClusters(currentClusters, trackedClusters, movementConfig)\n269: \n270:     const generationScore = calculateGenerationScore(tracked, scoringConfig)\n271:     const newScoreState = updateScore(scoreState, generationScore)\n272: \n273:     setPreviousScore(scoreState.currentScore)\n274:     previousTrackedClustersRef.current = tracked\n275:     setTrackedClusters(tracked)\n276:     setScoreState(newScoreState)\n277:     setGrid(result.newGrid)\n278:     setGeneration(result.newGeneration)\n279:   }, [\n280:     grid,\n281:     generation,\n282:     simulationSpeed,\n283:     scoreState,\n284:     movementConfig,\n285:     scoringConfig,\n286:     trackedClusters,\n287:   ])\n288: \n289:   useEffect(() => {\n290:     let interval: number | undefined\n291: \n292:     if (phaseState.current === 'RUNNING') {\n293:       interval = window.setInterval(() => {\n294:         handleSimulationStep()\n295:       }, simulationSpeed)\n296:     }\n297: \n298:     return () => {\n299:       if (interval) {\n300:         window.clearInterval(interval)\n301:       }\n302:     }\n303:   }, [phaseState, simulationSpeed, handleSimulationStep, trackedClusters])\n304: \n305:   const handleStart = useCallback(() => {\n306:     if (phaseState.current === 'PLANNING' && hasCells() && currentLevelConfig) {\n307:       startCountdown()\n308:       startRunning(currentLevelConfig.timeLimitSeconds)\n309:     }\n310:   }, [phaseState, startCountdown, hasCells, currentLevelConfig, startRunning])\n311: \n312:   const handleGridChange = useCallback((newGrid: GridType) => {\n313:     setGrid(newGrid)\n314:     setGeneration(0)\n315:   }, [])\n316: \n317:   const handleFluxChange = useCallback((newFlux: FluxState) => {\n318:     setFlux(newFlux)\n319:   }, [])\n320: \n321:   const handleClear = useCallback(() => {\n322:     const { rows, cols } = GRID_SIZE_PRESETS[gridPreset]\n323:     setGrid(createGrid(rows, cols))\n324:     setFlux(createInitialFluxState(20))\n325:     setGeneration(0)\n326:     setScoreState(createInitialScoreState())\n327:     setTrackedClusters([])\n328:     setLevelStats(null)\n329:   }, [gridPreset])\n330: \n331:   const handleRandom = useCallback(() => {\n332:     const { rows, cols } = GRID_SIZE_PRESETS[gridPreset]\n333:     const newGrid = createGrid(rows, cols)\n334:     const density = 0.15\n335: \n336:     for (let row = 0; row < rows; row++) {\n337:       for (let col = 0; col < cols; col++) {\n338:         if (Math.random() < density) {\n339:           newGrid[row][col] = 1\n340:         }\n341:       }\n342:     }\n343: \n344:     setGrid(newGrid)\n345:     setFlux(createInitialFluxState(20))\n346:     setGeneration(0)\n347:     setScoreState(createInitialScoreState())\n348:     setTrackedClusters([])\n349:     setLevelStats(null)\n350:   }, [gridPreset])\n351: \n352:   const aliveCount = grid.flat().filter((cell: number) => cell > 0).length\n353: \n354:   const handleToggleSettings = useCallback(() => {\n355:     setSettingsPanelOpen((prev) => !prev)\n356:   }, [])\n357: \n358:   const handleUpdateSettings = useCallback((newSettings: ExpertSettings) => {\n359:     setExpertSettings(newSettings)\n360:     saveToLocalStorage('gol-expert-settings', newSettings)\n361:   }, [])\n362: \n363:   const handleStep = useCallback(() => {\n364:     if (phaseState.current !== 'PLANNING') return\n365: \n366:     const currentState = {\n367:       grid,\n368:       generation,\n369:       running: false,\n370:       speed: 100,\n371:       selectedRule: CONWAY_RULES,\n372:     }\n373: \n374:     const result = stepSimulation(currentState)\n375:     setGrid(result.newGrid)\n376:     setGeneration(result.newGeneration)\n377:   }, [phaseState, grid, generation])\n378: \n379:   const canInteract = phaseState.current === 'PLANNING'\n380: \n381:   const movers = trackedClusters.filter((c) => c.classification === 'MOVER').length\n382:   const oscillators = trackedClusters.filter((c) => c.classification === 'OSCILLATOR').length\n383:   const rate =\n384:     scoringConfig.moverPointsPerGeneration * movers +\n385:     scoringConfig.oscillatorPointsPerGeneration * oscillators\n386: \n387:   return (\n388:     <div style={{ padding: '20px', backgroundColor: '#0a0a0f', minHeight: '100vh', color: '#fff' }}>\n389:       <UIToggleButton isVisible={isUiVisible} onToggle={() => setIsUiVisible(!isUiVisible)} />\n390: \n391:       <ScoreDisplay\n392:         score={scoreState.currentScore}\n393:         previousScore={previousScore}\n394:         showPatternBreakdown={true}\n395:         movers={movers}\n396:         oscillators={oscillators}\n397:         rate={rate}\n398:         highScore={highScore}\n399:       />\n400: \n401:       <SettingsPanel\n402:         isOpen={settingsPanelOpen}\n403:         settings={expertSettings}\n404:         onClose={() => setSettingsPanelOpen(false)}\n405:         onUpdateSettings={handleUpdateSettings}\n406:       />\n407: \n408:       <h1 style={{ textAlign: 'center', marginBottom: '20px', color: '#61dafb' }}>\n409:         Level {levelProgression.currentLevel} - Conway's Game of Life\n410:       </h1>\n411: \n412:       <TransitionOverlay\n413:         transitionState={transitionState}\n414:         currentLevel={levelProgression.currentLevel}\n415:         showStats={!!levelStats}\n416:         stats={levelStats ?? undefined}\n417:       />\n418: \n419:       {showVictory && (\n420:         <VictoryScreen\n421:           totalScore={levelProgression.totalScore}\n422:           finalLevelStats={levelStats ?? undefined}\n423:           onPlayAgain={() => {\n424:             const reset = resetProgression()\n425:             setLevelProgression(reset)\n426:             setShowVictory(false)\n427:             const { rows, cols } = GRID_SIZE_PRESETS[gridPreset]\n428:             setGrid(createGrid(rows, cols))\n429:             setFlux(createInitialFluxState(reset.levels[0]?.initialFlux ?? 20))\n430:             setGeneration(0)\n431:             setScoreState(createInitialScoreState())\n432:             previousTrackedClustersRef.current = []\n433:             setLevelStats(null)\n434:           }}\n435:         />\n436:       )}\n437: \n438:       {isUiVisible && (\n439:         <GlassHUD\n440:           phase={phaseState.current}\n441:           aliveCount={aliveCount}\n442:           flux={flux.current}\n443:           fluxMax={flux.initial}\n444:           interactionMode={interactionMode}\n445:           gridPreset={gridPreset}\n446:           showGridLines={showGridLines}\n447:           generation={generation}\n448:           countdownValue={phaseState.countdownValue}\n449:           timerRemaining={phaseState.timerRemaining}\n450:           canStart={aliveCount > 0}\n451:           canInteract={canInteract}\n452:           onStart={handleStart}\n453:           onStep={handleStep}\n454:           onClear={handleClear}\n455:           onRandom={handleRandom}\n456:           onToggleGrid={() => setShowGridLines(!showGridLines)}\n457:           onSetMode={setInteractionMode}\n458:           onSetGridPreset={setGridPreset}\n459:           onToggleSettings={handleToggleSettings}\n460:         />\n461:       )}\n462: \n463:       <div style={{ display: 'flex', justifyContent: 'center' }}>\n464:         <GridInteraction\n465:           grid={grid}\n466:           flux={flux}\n467:           phase={phaseState.current}\n468:           showGridLines={showGridLines}\n469:           onGridChange={handleGridChange}\n470:           onFluxChange={handleFluxChange}\n471:           interactionMode={interactionMode}\n472:           onInteractionSound={handleInteractionSound}\n473:           onFluxErrorSound={handleFluxErrorSound}\n474:         />\n475:       </div>\n476:     </div>\n477:   )\n478: }\n479: \n\n(End of file - total 479 lines)\n</content>","title":"src/components/Game.tsx","metadata":{"preview":"import { useState, useCallback, useEffect, useRef } from 'react'\nimport { createGrid, GRID_SIZE_PRESETS, type GridSizePreset } from '../lib/simulation'\nimport {\n  type GridType,\n  type FluxState,\n  type InteractionMode,\n  type TrackedCluster,\n  type ExpertSettings,\n  type LevelProgression,\n} from '../types'\nimport { createInitialFluxState } from '../lib/flux'\nimport { GridInteraction } from './GridInteraction'\nimport { usePhaseTimer } from '../hooks/usePhaseTimer'\nimport { useTransition } from '../hooks/useTransition'\nimport { useTripleTapGesture } from '../hooks/useTripleTapGesture'\nimport { stepSimulation, CONWAY_RULES } from '../lib/simulation'\nimport { findConnectedComponents, trackClusters } from '../lib/movement'\nimport { createInitialScoreState, updateScore, calculateGenerationScore } from '../lib/scoring'\nimport { ScoreDisplay } from './ScoreDisplay'\nimport { GlassHUD } from './GlassHUD'","truncated":false,"loaded":[]},"time":{"start":1771215560363,"end":1771215560369}}}}
{"type":"tool_use","timestamp":1771215560374,"sessionID":"ses_39b55e9f8fferWn8zBs1ZJmQ6V","part":{"id":"prt_c64ac9ead001P5rr8HfjYtRK6X","sessionID":"ses_39b55e9f8fferWn8zBs1ZJmQ6V","messageID":"msg_c64ac93b8001yScWezal3pUEUx","type":"tool","callID":"call_911db71b81064a6bb89fcf6d","tool":"read","state":{"status":"completed","input":{"filePath":"/home/ochanomizu/repos/game_of_life/src/components/ScoreDisplay.tsx"},"output":"<path>/home/ochanomizu/repos/game_of_life/src/components/ScoreDisplay.tsx</path>\n<type>file</type>\n<content>1: import { useState, useEffect, useRef } from 'react'\n2: import { formatScore, isMilestoneReached } from '../lib/scoring'\n3: import '../styles/ScoreDisplay.css'\n4: \n5: interface ScoreDisplayProps {\n6:   score: number\n7:   previousScore: number\n8:   movers?: number\n9:   oscillators?: number\n10:   rate?: number\n11:   showPatternBreakdown?: boolean\n12:   highScore?: number\n13: }\n14: \n15: export function ScoreDisplay({\n16:   score,\n17:   previousScore,\n18:   movers = 0,\n19:   oscillators = 0,\n20:   rate = 0,\n21:   showPatternBreakdown = false,\n22:   highScore = 0,\n23: }: ScoreDisplayProps) {\n24:   const [displayScore, setDisplayScore] = useState(score)\n25:   const [isPulsing, setIsPulsing] = useState(false)\n26:   const [isMilestoneFlash, setIsMilestoneFlash] = useState(false)\n27:   const lastProcessedScoreRef = useRef<number | null>(null)\n28: \n29:   useEffect(() => {\n30:     if (lastProcessedScoreRef.current === null) {\n31:       lastProcessedScoreRef.current = previousScore\n32: \n33:       if (previousScore !== score) {\n34:         setIsPulsing(true)\n35: \n36:         if (isMilestoneReached(score, previousScore)) {\n37:           setIsMilestoneFlash(true)\n38:         }\n39:       }\n40:       return\n41:     }\n42: \n43:     if (lastProcessedScoreRef.current !== previousScore) {\n44:       setIsPulsing(true)\n45: \n46:       if (isMilestoneReached(score, previousScore)) {\n47:         setIsMilestoneFlash(true)\n48:       }\n49:     }\n50: \n51:     lastProcessedScoreRef.current = previousScore\n52:   }, [score, previousScore])\n53: \n54:   useEffect(() => {\n55:     const timer = window.setTimeout(() => {\n56:       setIsPulsing(false)\n57:     }, 200)\n58: \n59:     return () => window.clearTimeout(timer)\n60:   }, [isPulsing])\n61: \n62:   useEffect(() => {\n63:     const timer = window.setTimeout(() => {\n64:       setIsMilestoneFlash(false)\n65:     }, 500)\n66: \n67:     return () => window.clearTimeout(timer)\n68:   }, [isMilestoneFlash])\n69: \n70:   useEffect(() => {\n71:     const duration = 200\n72:     const startTimestamp = window.performance.now()\n73:     const startValue = displayScore\n74:     const endValue = score\n75: \n76:     if (startValue === endValue) return\n77: \n78:     const animate = (currentTime: number) => {\n79:       const elapsed = currentTime - startTimestamp\n80:       const progress = Math.min(elapsed / duration, 1)\n81: \n82:       const easedProgress =\n83:         progress < 0.5 ? 2 * progress * progress : 1 - Math.pow(-2 * progress + 2, 2) / 2\n84: \n85:       setDisplayScore(Math.round(startValue + (endValue - startValue) * easedProgress))\n86: \n87:       if (progress < 1) {\n88:         window.requestAnimationFrame(animate)\n89:       }\n90:     }\n91: \n92:     window.requestAnimationFrame(animate)\n93:   }, [score, displayScore])\n94: \n95:   return (\n96:     <div className=\"score-display-container\">\n97:       <div className=\"score-display\">\n98:         <span\n99:           className={`score-value ${isPulsing ? 'pulse' : ''} ${isMilestoneFlash ? 'milestone-flash' : ''}`}\n100:         >\n101:           {formatScore(displayScore)}\n102:         </span>\n103:         <span className=\"score-label\">PTS</span>\n104:       </div>\n105:       {highScore > 0 && (\n106:         <div className=\"high-score-display\">\n107:           <span className=\"high-score-label\">HIGH:</span>\n108:           <span className=\"high-score-value\">{formatScore(highScore)}</span>\n109:         </div>\n110:       )}\n111:       {showPatternBreakdown && (\n112:         <div className=\"score-breakdown\">\n113:           <div className=\"score-breakdown-item\">\n114:             <span className=\"breakdown-label\">Movers:</span>\n115:             <span className=\"breakdown-value\">{movers}</span>\n116:           </div>\n117:           <div className=\"score-breakdown-item\">\n118:             <span className=\"breakdown-label\">Oscillators:</span>\n119:             <span className=\"breakdown-value\">{oscillators}</span>\n120:           </div>\n121:           <div className=\"score-breakdown-item\">\n122:             <span className=\"breakdown-label\">Rate:</span>\n123:             <span className=\"breakdown-value\">{rate}/gen</span>\n124:           </div>\n125:         </div>\n126:       )}\n127:     </div>\n128:   )\n129: }\n130: \n\n(End of file - total 130 lines)\n</content>","title":"src/components/ScoreDisplay.tsx","metadata":{"preview":"import { useState, useEffect, useRef } from 'react'\nimport { formatScore, isMilestoneReached } from '../lib/scoring'\nimport '../styles/ScoreDisplay.css'\n\ninterface ScoreDisplayProps {\n  score: number\n  previousScore: number\n  movers?: number\n  oscillators?: number\n  rate?: number\n  showPatternBreakdown?: boolean\n  highScore?: number\n}\n\nexport function ScoreDisplay({\n  score,\n  previousScore,\n  movers = 0,\n  oscillators = 0,\n  rate = 0,","truncated":false,"loaded":[]},"time":{"start":1771215560367,"end":1771215560371}}}}
