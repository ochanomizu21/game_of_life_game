{"type":"tool_use","timestamp":1771182209399,"sessionID":"ses_39d54d119ffe5wknN3nwR32dw0","part":{"id":"prt_c62afabf2001tMMLUtQ3b8AEsg","sessionID":"ses_39d54d119ffe5wknN3nwR32dw0","messageID":"msg_c62af7a8b001HjV8Tsp9K1P5Ew","type":"tool","callID":"call_01854079401b4996b4132fd7","tool":"write","state":{"status":"completed","input":{"content":"import type {\n  LevelConfig,\n  LevelProgression,\n  LevelGenerationParams,\n  DifficultyScalingMode,\n} from '../types'\n\nconst DEFAULT_TOTAL_LEVELS = 10\n\nfunction generateLevelConfig(\n  levelNumber: number,\n  params: LevelGenerationParams,\n): LevelConfig {\n  const { baseTimeSeconds, timeIncrementPerLevel, baseFlux, difficultyScalingMode } = params\n\n  let timeLimitSeconds = baseTimeSeconds\n  let initialFlux = baseFlux\n\n  switch (difficultyScalingMode) {\n    case 'TIME_ONLY':\n      timeLimitSeconds = baseTimeSeconds + (levelNumber - 1) * timeIncrementPerLevel\n      initialFlux = baseFlux\n      break\n\n    case 'RESOURCE_ONLY':\n      timeLimitSeconds = baseTimeSeconds\n      initialFlux = Math.max(5, baseFlux - Math.floor((levelNumber - 1) * 1.5))\n      break\n\n    case 'MIXED':\n      timeLimitSeconds = baseTimeSeconds + (levelNumber - 1) * Math.floor(timeIncrementPerLevel / 2)\n      initialFlux = Math.max(5, baseFlux - Math.floor((levelNumber - 1) * 0.5))\n      break\n\n    case 'EXTREME':\n      timeLimitSeconds = baseTimeSeconds + (levelNumber - 1) * Math.floor(timeIncrementPerLevel / 3)\n      initialFlux = Math.max(5, baseFlux - (levelNumber - 1) * 2)\n      break\n\n    default:\n      timeLimitSeconds = baseTimeSeconds + (levelNumber - 1) * timeIncrementPerLevel\n      initialFlux = baseFlux\n  }\n\n  return {\n    levelNumber,\n    timeLimitSeconds,\n    initialFlux,\n  }\n}\n\nexport function createInitialProgression(\n  totalLevels: number = DEFAULT_TOTAL_LEVELS,\n): LevelProgression {\n  const levels: LevelConfig[] = []\n  for (let i = 1; i <= totalLevels; i++) {\n    levels.push({\n      levelNumber: i,\n      timeLimitSeconds: 45 + (i - 1) * 15,\n      initialFlux: 20,\n    })\n  }\n\n  return {\n    currentLevel: 1,\n    maxUnlockedLevel: 1,\n    totalScore: 0,\n    levels,\n  }\n}\n\nexport function generateProgression(\n  params: LevelGenerationParams,\n  totalLevels: number = DEFAULT_TOTAL_LEVELS,\n): LevelProgression {\n  const levels: LevelConfig[] = []\n  for (let i = 1; i <= totalLevels; i++) {\n    levels.push(generateLevelConfig(i, params))\n  }\n\n  return {\n    currentLevel: 1,\n    maxUnlockedLevel: 1,\n    totalScore: 0,\n    levels,\n  }\n}\n\nexport function getCurrentLevelConfig(progression: LevelProgression): LevelConfig | null {\n  if (progression.currentLevel < 1 || progression.currentLevel > progression.levels.length) {\n    return null\n  }\n  return progression.levels[progression.currentLevel - 1]\n}\n\nexport function advanceLevel(progression: LevelProgression, levelScore: number): LevelProgression {\n  const newTotalScore = progression.totalScore + levelScore\n  const newCurrentLevel = progression.currentLevel + 1\n  const newMaxUnlockedLevel = Math.max(progression.maxUnlockedLevel, newCurrentLevel)\n\n  return {\n    currentLevel: newCurrentLevel,\n    maxUnlockedLevel: newMaxUnlockedLevel,\n    totalScore: newTotalScore,\n    levels: progression.levels,\n  }\n}\n\nexport function isFinalLevel(progression: LevelProgression): boolean {\n  return progression.currentLevel >= progression.levels.length\n}\n\nexport function resetProgression(totalLevels: number = DEFAULT_TOTAL_LEVELS): LevelProgression {\n  return createInitialProgression(totalLevels)\n}\n\nexport function regenerateProgression(\n  progression: LevelProgression,\n  params: LevelGenerationParams,\n): LevelProgression {\n  const totalLevels = progression.levels.length\n  const levels: LevelConfig[] = []\n\n  for (let i = 1; i <= totalLevels; i++) {\n    levels.push(generateLevelConfig(i, params))\n  }\n\n  return {\n    currentLevel: progression.currentLevel,\n    maxUnlockedLevel: progression.maxUnlockedLevel,\n    totalScore: progression.totalScore,\n    levels,\n  }\n}\n","filePath":"/home/ochanomizu/repos/game_of_life/src/lib/level.ts"},"output":"Wrote file successfully.\n\nLSP errors detected in this file, please fix:\n<diagnostics file=\"/home/ochanomizu/repos/game_of_life/src/lib/level.ts\">\nERROR [5:3] 'DifficultyScalingMode' is declared but never used.\n</diagnostics>","title":"src/lib/level.ts","metadata":{"diagnostics":{"/home/ochanomizu/repos/game_of_life/src/App.tsx":[],"/home/ochanomizu/repos/game_of_life/src/lib/phase.ts":[],"/home/ochanomizu/repos/game_of_life/src/lib/movement.ts":[],"/home/ochanomizu/repos/game_of_life/src/lib/simulation.ts":[],"/home/ochanomizu/repos/game_of_life/src/lib/interaction.ts":[],"/home/ochanomizu/repos/game_of_life/src/lib/flux.ts":[],"/home/ochanomizu/repos/game_of_life/src/components/Game.tsx":[],"/home/ochanomizu/repos/game_of_life/src/types/index.ts":[],"/home/ochanomizu/repos/game_of_life/src/lib/audio.ts":[],"/home/ochanomizu/repos/game_of_life/src/lib/scoring.ts":[],"/home/ochanomizu/repos/game_of_life/src/lib/settings.ts":[],"/home/ochanomizu/repos/game_of_life/src/hooks/usePhaseTimer.ts":[],"/home/ochanomizu/repos/game_of_life/src/components/CanvasGrid.tsx":[],"/home/ochanomizu/repos/game_of_life/src/components/GridInteraction.tsx":[],"/home/ochanomizu/repos/game_of_life/src/components/ScoreDisplay.tsx":[],"/home/ochanomizu/repos/game_of_life/src/components/SettingsPanel.tsx":[],"/home/ochanomizu/repos/game_of_life/src/components/GlassHUD.tsx":[],"/home/ochanomizu/repos/game_of_life/src/components/UIToggleButton.tsx":[],"/home/ochanomizu/repos/game_of_life/src/lib/validation.ts":[],"/home/ochanomizu/repos/game_of_life/src/lib/logger.ts":[],"/home/ochanomizu/repos/game_of_life/src/components/IntroOverlay.tsx":[],"/home/ochanomizu/repos/game_of_life/src/lib/canvasUtils.ts":[],"/home/ochanomizu/repos/game_of_life/src/lib/state.ts":[],"/home/ochanomizu/repos/game_of_life/src/l