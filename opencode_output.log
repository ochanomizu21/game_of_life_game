s-slider\"\n233:               />\n234:             </div>\n235:           </section>\n236: \n237:           <section className=\"settings-section\">\n238:             <h3>Level Generation</h3>\n239:             <div className=\"settings-row\">\n240:               <label htmlFor=\"level-time\">\n241:                 Base Time (s): {localSettings.levelGeneration.baseTimeSeconds}\n242:               </label>\n243:               <input\n244:                 id=\"level-time\"\n245:                 type=\"range\"\n246:                 min=\"10\"\n247:                 max=\"120\"\n248:                 step=\"5\"\n249:                 value={localSettings.levelGeneration.baseTimeSeconds}\n250:                 onChange={(e) =>\n251:                   handleUpdate('levelGeneration.baseTimeSeconds', parseInt(e.target.value))\n252:                 }\n253:                 className=\"settings-slider\"\n254:               />\n255:             </div>\n256:             <div className=\"settings-row\">\n257:               <label htmlFor=\"level-increment\">\n258:                 Time Increment/Level (s): {localSettings.levelGeneration.timeIncrementPerLevel}\n259:               </label>\n260:               <input\n261:                 id=\"level-increment\"\n262:                 type=\"range\"\n263:                 min=\"0\"\n264:                 max=\"60\"\n265:                 step=\"5\"\n266:                 value={localSettings.levelGeneration.timeIncrementPerLevel}\n267:                 onChange={(e) =>\n268:                   handleUpdate('levelGeneration.timeIncrementPerLevel', parseInt(e.target.value))\n269:                 }\n270:                 className=\"settings-slider\"\n271:               />\n272:             </div>\n273:             <div className=\"settings-row\">\n274:               <label htmlFor=\"level-flux\">\n275:                 Base Flux: {localSettings.levelGeneration.baseFlux}\n276:               </label>\n277:               <input\n278:                 id=\"level-flux\"\n279:                 type=\"range\"\n280:                 min=\"5\"\n281:                 max=\"50\"\n282:                 step=\"5\"\n283:                 value={localSettings.levelGeneration.baseFlux}\n284:                 onChange={(e) => handleUpdate('levelGeneration.baseFlux', parseInt(e.target.value))}\n285:                 className=\"settings-slider\"\n286:               />\n287:             </div>\n288:             <div className=\"settings-row\">\n289:               <label htmlFor=\"level-difficulty\">Difficulty Mode</label>\n290:               <select\n291:                 id=\"level-difficulty\"\n292:                 value={localSettings.levelGeneration.difficultyScalingMode}\n293:                 onChange={(e) =>\n294:                   handleUpdate(\n295:                     'levelGeneration.difficultyScalingMode',\n296:                     e.target.value as 'TIME_ONLY' | 'RESOURCE_ONLY' | 'MIXED' | 'EXTREME'\n297:                   )\n298:                 }\n299:                 className=\"settings-select\"\n300:               >\n301:                 <option value=\"TIME_ONLY\">Time Only</option>\n302:                 <option value=\"RESOURCE_ONLY\">Resource Only</option>\n303:                 <option value=\"MIXED\">Mixed</option>\n304:                 <option value=\"EXTREME\">Extreme</option>\n305:               </select>\n306:             </div>\n307:           </section>\n308: \n309:           <section className=\"settings-section\">\n310:             <h3>Grid Sizing</h3>\n311:             <div className=\"settings-row\">\n312:               <label htmlFor=\"grid-mobile\">\n313:                 Mobile Cell Size (px): {localSettings.gridSizing.mobileCellSize}\n314:               </label>\n315:               <input\n316:                 id=\"grid-mobile\"\n317:                 type=\"range\"\n318:                 min=\"14\"\n319:                 max=\"24\"\n320:                 step=\"2\"\n321:                 value={localSetting