eDefined()\n38:       expect(settings.gridSizing).toBeDefined()\n39:       expect(settings.audio).toBeDefined()\n40:     })\n41: \n42:     it('should create initial expert settings with correct defaults', () => {\n43:       const settings = createInitialExpertSettings()\n44: \n45:       expect(settings.movementDetection.centroidHistoryLength).toBe(5)\n46:       expect(settings.movementDetection.movementThreshold).toBe(0.5)\n47:       expect(settings.movementDetection.minClusterSize).toBe(1)\n48: \n49:       expect(settings.scoring.moverPointsPerGeneration).toBe(10)\n50:       expect(settings.scoring.oscillatorPointsPerGeneration).toBe(2)\n51:       expect(settings.scoring.scoreMultiplier).toBe(1.0)\n52: \n53:       expect(settings.levelGeneration.baseTimeSeconds).toBe(45)\n54:       expect(settings.levelGeneration.timeIncrementPerLevel).toBe(15)\n55:       expect(settings.levelGeneration.baseFlux).toBe(20)\n56:       expect(settings.levelGeneration.difficultyScalingMode).toBe('TIME_ONLY')\n57: \n58:       expect(settings.gridSizing.mobileCellSize).toBe(18)\n59:       expect(settings.gridSizing.desktopCellSize).toBe(20)\n60:       expect(settings.gridSizing.minVisibleCells).toBe(10)\n61: \n62:       expect(settings.audio.enabled).toBe(false)\n63:       expect(settings.audio.volume).toBe(0.1)\n64:       expect(settings.audio.waveform).toBe('sine')\n65:     })\n66:   })\n67: \n68:   describe('validateExpertSettings', () => {\n69:     it('should validate correct expert settings', () => {\n70:       const settings = createInitialExpertSettings()\n71: \n72:       expect(validateExpertSettings(settings)).toBe(true)\n73:     })\n74: \n75:     it('should reject invalid movementDetection', () => {\n76:       const settings = createInitialExpertSettings()\n77:       settings.movementDetection = null as any\n78: \n79:       expect(validateExpertSettings(settings)).toBe(false)\n80:     })\n81: \n82:     it('should reject centroidHistoryLength out of range (too low)', () => {\n83:       const settings = createInitialExpertSettings()\n84:       settings.movementDetection.centroidHistoryLength = 2\n85: \n86:       expect(validateExpertSettings(settings)).toBe(false)\n87:     })\n88: \n89:     it('should reject centroidHistoryLength out of range (too high)', () => {\n90:       const settings = createInitialExpertSettings()\n91:       settings.movementDetection.centroidHistoryLength = 11\n92: \n93:       expect(validateExpertSettings(settings)).toBe(false)\n94:     })\n95: \n96:     it('should accept centroidHistoryLength at boundaries', () => {\n97:       const settings = createInitialExpertSettings()\n98: \n99:       settings.movementDetection.centroidHistoryLength = 3\n100:       expect(validateExpertSettings(settings)).toBe(true)\n101: \n102:       settings.movementDetection.centroidHistoryLength = 10\n103:       expect(validateExpertSettings(settings)).toBe(true)\n104:     })\n105: \n106:     it('should reject movementThreshold out of range (too low)', () => {\n107:       const settings = createInitialExpertSettings()\n108:       settings.movementDetection.movementThreshold = 0.05\n109: \n110:       expect(validateExpertSettings(settings)).toBe(false)\n111:     })\n112: \n113:     it('should reject movementThreshold out of range (too high)', () => {\n114:       const settings = createInitialExpertSettings()\n115:       settings.movementDetection.movementThreshold = 2.5\n116: \n117:       expect(validateExpertSettings(settings)).toBe(false)\n118:     })\n119: \n120:     it('should reject minClusterSize out of range (too low)', () => {\n121:       const settings = createInitialExpertSettings()\n122:       settings.movementDetection.minClusterSize = 0\n123: \n124:       expect(validateExpertSettings(settings)).toBe(false)\n125:     })\n126: \n127:     it('should reject minClusterSize out of range (too high)', () => {\n128:       const settings = createInitialExpertSettings()\n129:       settings.movementDetection.minClusterSize = 6\n130: \n131:       expect(validateExpertSettings(settings)).toBe(false)\n132:     })\n133: \n134:     it('should reject scoring out of range', () => {\n135:       const settings = createInitialExpertSettings()\n136: \n137:       settings.scoring.moverPointsPerGeneration = 101\n138:       expect(validateExpertSettings(settings)).toBe(false)\n139: \n140:       settings.scoring.moverPointsPerGeneration = 0\n141:       expect(validateExpertSettings(settings)).toBe(false)\n142:     })\n143: \n144:     it('should reject levelGeneration baseTimeSeconds out of range', () => {\n145:       const settings = createInitialExpertSettings()\n146: \n147:       settings.levelGeneration.baseTimeSeconds = 9\n148:       expect(validateExpertSettings(settings)).toBe(false)\n149: \n150:       settings.levelGeneration.baseTimeSeconds = 121\n151:       expect(validateExpertSettings(settings)).toBe(false)\n152:     })\n153: \n154:     it('should reject levelGeneration timeIncrementPerLevel out of range', () => {\n155:       const settings = createInitialExpertSettings()\n156: \n157:       settings.levelGeneration.timeIncrementPerLevel = 61\n158:       expect(validateExpertSettings(settings)).toBe(false)\n159:     })\n160: \n161:     it('should reject levelGeneration baseFlux out of range', () => {\n162:       const settings = createInitialExpertSettings()\n163: \n164:       settings.levelGeneration.baseFlux = 4\n165:       expect(validateExpertSettings(settings)).toBe(false)\n166: \n167:       settings.levelGeneration.baseFlux = 51\n168:       expect(validateExpertSettings(settings)).toBe(false)\n169:     })\n170: \n171:     it('should reject invalid difficultyScalingMode', () => {\n172:       const settings = createInitialExpertSettings()\n173:       settings.levelGeneration.difficultyScalingMode = 'INVALID' as any\n174: \n175:       expect(validateExpertSettings(settings)).toBe(false)\n176:     })\n177: \n178:     it('should accept all valid difficultyScalingModes', () => {\n179:       const modes: Array<'TIME_ONLY' | 'RESOURCE_ONLY' | 'MIXED' | 'EXTREME'> = [\n180:         'TIME_ONLY',\n181:         'RESOURCE_ONLY',\n182:         'MIXED',\n183:         'EXTREME',\n184:       ]\n185: \n186:       modes.forEach((mode) => {\n187:         const settings = createInitialExpertSettings()\n188:         settings.levelGeneration.difficultyScalingMode = mode\n189:         expect(validateExpertSettings(settings)).toBe(true)\n190:       })\n191:     })\n192:     })\n193: \n194:     it('should reject gridSizing mobileCellSize out of range', () => {\n195:       const settings = createInitialExpertSettings()\n196: \n197:       settings.gridSizing.mobileCellSize = 13\n198:       expect(validateExpertSettings(settings)).toBe(false)\n199: \n200:       settings.gridSizing.mobileCellSize = 25\n201:       expect(validateExpertSettings(settings)).toBe(false)\n202:     })\n203: \n204:     it('should reject gridSizing desktopCellSize out of range', () => {\n205:       const settings = createInitialExpertSettings()\n206: \n207:       settings.gridSizing.desktopCellSize = 15\n208:       expect(validateExpertSettings(settings)).toBe(false)\n209: \n210:       settings.gridSizing.desktopCellSize = 29\n211:       expect(validateExpertSettings(settings)).toBe(false)\n212:     })\n213: \n214:     it('should reject gridSizing minVisibleCells out of range', () => {\n215:       const settings = createInitialExpertSettings()\n216: \n217:       settings.gridSizing.minVisibleCells = 0\n218:       expect(validateExpertSettings(settings)).toBe(false)\n219:     })\n220: \n221:     it('should reject audio enabled not boolean', () => {\n222:       const settings = createInitialExpertSettings()\n223:       settings.audio.enabled = 'true' as any\n224: \n225:       expect(validateExpertSettings(settings)).toBe(false)\n226:     })\n227: \n228:     it('should reject audio volume out of range', () => {\n229:       const settings = createInitialExpertSettings()\n230: \n231:       settings.audio.volume = -0.1\n232:       expect(validateExpertSettings(settings)).toBe(false)\n233: \n234:       settings.audio.volume = 0.6\n235:       expect(validateExpertSettings(settings)).toBe(false)\n236:     })\n237: \n238:     it('should reject audio invalid waveform', () => {\n239:       const settings = createInitialExpertSettings()\n240:       settings.audio.waveform = 'invalid' as any\n241: \n242:       expect(validateExpertSettings(settings)).toBe(false)\n243:     })\n244:   })\n245: })\n246: \n\n(End of file - total 246 lines)\n</content>","title":"src/lib/settings.test.ts","metadata":{"preview":"import { describe, it, expect } from 'vitest'\nimport {\n  createInitialLevelGenerationParams,\n  createInitialGridSizingParams,\n  createInitialExpertSettings,\n  validateExpertSettings,\n} from './settings'\n\ndescribe('settings', () => {\n  describe('createInitialLevelGenerationParams', () => {\n    it('should create initial level generation params with correct defaults', () => {\n      const params = createInitialLevelGenerationParams()\n\n      expect(params.baseTimeSeconds).toBe(45)\n      expect(params.timeIncrementPerLevel).toBe(15)\n      expect(params.baseFlux).toBe(20)\n      expect(params.difficultyScalingMode).toBe('TIME_ONLY')\n    })\n  })\n","truncated":false,"loaded":[]},"time":{"start":1771215895509,"end":1771215895511}}}}
