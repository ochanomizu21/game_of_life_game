{"type":"tool_use","timestamp":1771200901458,"sessionID":"ses_39c3416c0ffeUYCFcwGrAdjGPB","part":{"id":"prt_c63ccf120001jxUXu0KkxZQM1k","sessionID":"ses_39c3416c0ffeUYCFcwGrAdjGPB","messageID":"msg_c63ccd159001RWccao3tynAs3v","type":"tool","callID":"call_723973ec94894636b69aba45","tool":"read","state":{"status":"completed","input":{"filePath":"/home/ochanomizu/repos/game_of_life/src/components/SettingsPanel.tsx"},"output":"<path>/home/ochanomizu/repos/game_of_life/src/components/SettingsPanel.tsx</path>\n<type>file</type>\n<content>1: import { useState } from 'react'\n2: import type { ExpertSettings } from '../types'\n3: import '../styles/SettingsPanel.css'\n4: \n5: interface SettingsPanelProps {\n6:   isOpen: boolean\n7:   settings: ExpertSettings\n8:   onClose: () => void\n9:   onUpdateSettings: (settings: ExpertSettings) => void\n10: }\n11: \n12: export function SettingsPanel({ isOpen, settings, onClose, onUpdateSettings }: SettingsPanelProps) {\n13:   const [localSettings, setLocalSettings] = useState(settings)\n14: \n15:   const handleUpdate = (path: string, value: any) => {\n16:     const newSettings = { ...localSettings }\n17:     const keys = path.split('.')\n18:     let target: any = newSettings\n19: \n20:     for (let i = 0; i < keys.length - 1; i++) {\n21:       target = target[keys[i]]\n22:     }\n23: \n24:     target[keys[keys.length - 1]] = value\n25:     setLocalSettings(newSettings)\n26:   }\n27: \n28:   const handleSave = () => {\n29:     onUpdateSettings(localSettings)\n30:     onClose()\n31:   }\n32: \n33:   const handleReset = () => {\n34:     const defaultSettings = {\n35:       movementDetection: {\n36:         centroidHistoryLength: 5,\n37:         movementThreshold: 0.5,\n38:         minClusterSize: 1,\n39:       },\n40:       scoring: {\n41:         moverPointsPerGeneration: 10,\n42:         oscillatorPointsPerGeneration: 2,\n43:         scoreMultiplier: 1.0,\n44:       },\n45:       levelGeneration: {\n46:         baseTimeSeconds: 45,\n47:         timeIncrementPerLevel: 15,\n48:         baseFlux: 20,\n49:         difficultyScalingMode: 'TIME_ONLY' as const,\n50:       },\n51:       gridSizing: {\n52:         mobileCellSize: 18,\n53:         desktopCellSize: 20,\n54:         minVisibleCells: 10,\n55:       },\n56:       audio: {\n57:         enabled: false,\n58:         volume: 0.1,\n59:         waveform: 'sine' as const,\n60:       },\n61:     }\n62:     setLocalSettings(defaultSettings)\n63:   }\n64: \n65:   if (!isOpen) return null\n66: \n67:   return (\n68:     <div className=\"settings-overlay\" onClick={onClose}>\n69:       <div className=\"settings-panel\" onClick={(e) => e.stopPropagation()}>\n70:         <div className=\"settings-header\">\n71:           <h2>Settings</h2>\n72:           <button className=\"close-button\" onClick={onClose}>\n73:             ×\n74:           </button>\n75:         </div>\n76: \n77:         <div className=\"settings-content\">\n78:           <section className=\"settings-section\">\n79:             <h3>Audio</h3>\n80:             <div className=\"settings-row\">\n81:               <label htmlFor=\"audio-enabled\">\n82:                 <input\n83:                   id=\"audio-enabled\"\n84:                   type=\"checkbox\"\n85:                   checked={localSettings.audio.enabled}\n86:                   onChange={(e) => handleUpdate('audio.enabled', e.target.checked)}\n87:                 />\n88:                 Enable Sonification\n89:               </label>\n90:             </div>\n91:             <div className=\"settings-row\">\n92:               <label htmlFor=\"audio-volume\">\n93:                 Volume: {(localSettings.audio.volume * 100).toFixed(0)}%\n94:               </label>\n95:               <input\n96:                 id=\"audio-volume\"\n97:                 type=\"range\"\n98:                 min=\"0\"\n99:                 max=\"0.5\"\n100:                 step=\"0.01\"\n101:                 value={localSettings.audio.volume}\n102:                 onChange={(e) => handleUpdate('audio.volume', parseFloat(e.target.value))}\n103:                 className=\"settings-slider\"\n104:               />\n105:             </div>\n106:             <div className=\"settings-row\">\n107:               <label htmlFor=\"audio-waveform\">Waveform</label>\n108:               <select\n109:                 id=\"audio-waveform\"\n110:                 value={localSettings.audio.waveform}\n111:                 onChange={(e) =>\n112:                   handleUpdate(\n113:                     'audio.waveform',\n114:                     e.target.value as 'sine' | 'triangle' | 'square' | 'sawtooth'\n115:                   )\n116:                 }\n117:                 className=\"settings-select\"\n118:               >\n119:                 <option value=\"sine\">Sine</option>\n120:                 <option value=\"triangle\">Triangle</option>\n121:                 <option value=\"square\">Square</option>\n122:                 <option value=\"sawtooth\">Sawtooth</option>\n123:               </select>\n124:             </div>\n125:           </section>\n126: \n127:           <section className=\"settings-section\">\n128:             <h3>Movement Detection</h3>\n129:             <div className=\"settings-row\">\n130:               <label htmlFor=\"movement-history\">\n131:                 Centroid History Length: {localSettings.movementDetection.centroidHistoryLength}\n132:               </label>\n133:               <input\n134:                 id=\"movement-history\"\n135:                 type=\"range\"\n136:                 min=\"3\"\n137:                 max=\"10\"\n138:                 step=\"1\"\n139:                 value={localSettings.movementDetection.centroidHistoryLength}\n140:                 onChange={(e) =>\n141:                   handleUpdate('movementDetection.centroidHistoryLength', parseInt(e.target.value))\n142:                 }\n143:                 className=\"settings-slider\"\n144:               />\n145:     