nsition(\n  config: TransitionConfig = DEFAULT_CONFIG,\n  onTransitionComplete?: () => void\n) {\n  const [transitionState, setTransitionState] = useState<TransitionStateInternal>({\n    current: 'PLAYING',\n    canTransition: false,\n  })\n\n  const timeoutRef = useRef<number | null>(null)\n  const transitionTimers = useRef<Map<TransitionState, TransitionTimer>>(new Map())\n  const isTabHidden = useRef(false)\n\n  const clearTimeoutRef = () => {\n    if (timeoutRef.current !== null) {\n      window.clearTimeout(timeoutRef.current)\n      timeoutRef.current = null\n    }\n  }\n\n  const scheduleTransition = useCallback(\n    (duration: number, nextState: TransitionState) => {\n      clearTimeoutRef()\n\n      if (isTabHidden.current) {\n        const timer: TransitionTimer = {\n          timeoutId: null,\n          startTime: null,\n          remainingTime: duration,\n        }\n        transitionTimers.current.set(transitionState.current, timer)\n        return\n      }\n\n      timeoutRef.current = window.setTimeout(() => {\n        setTransitionState({ current: nextState, canTransition: nextState === 'READY' })\n        transitionTimers.current.delete(transitionState.current)\n\n        if (nextState === 'READY') {\n          onTransitionComplete?.()\n        }\n      }, duration)\n    },\n    [transitionState, onTransitionComplete]\n  )\n\n  const resumeTransition = useCallback(() => {\n    const timer = transitionTimers.current.get(transitionState.current)\n    if (timer && timer.remainingTime > 0) {\n      scheduleTransition(\n        timer.remainingTime,\n        getNextState(transitionState.current),\n        onTransitionComplete\n      )\n      transitionTimers.current.delete(transitionState.current)\n    }\n  }, [transitionState, onTransitionComplete, scheduleTransition])\n\n  const getNextState = (currentState: TransitionState): TransitionState => {\n    switch (currentState) {\n      case 'PLAYING':\n        return 'FADING_OUT'\n      case 'FADING_OUT':\n        return 'INTERSTITIAL'\n      case 'INTERSTITIAL':\n        return 'FADING_IN'\n      case 'FADING_IN':\n        return 'READY'\n      default:\n        return 'PLAYING'\n    }\n  }\n\n  const startTransition = () => {\n    scheduleTransition(config.fadeOutDuration, 'FADING_OUT')\n\n    setTimeout(() => {\n      if (!isTabHidden.current) {\n        scheduleTransition(config.interstitialDuration, 'FADING_IN')\n      }\n    }, config.fadeOutDuration)\n\n    setTimeout(() => {\n      if (!isTabHidden.current) {\n        scheduleTransition(config.fadeInDuration, 'READY')\n      }\n    }, config.fadeOutDuration + config.interstitialDuration)\n  }\n\n  const skipTransition = () => {\n    clearTimeoutRef()\n    transitionTimers.current.clear()\n    setTransitionState({ current: 'READY', canTransition: true })\n    onTransitionComplete?.()\n  }\n\n  const resetTransition = () => {\n    clearTimeoutRef()\n    transitionTimers.current.clear()\n    setTransitionState({ current: 'PLAYING', canTransition: false })\n  }\n\n  const handleKeyDown = (e: KeyboardEvent) => {\n    if (config.skipEnabled && (e.code === 'Space' || e.code === 'Escape')) {\n      if (transitionState.current !== 'PLAYING' && transitionState.current !== 'READY') {\n        skipTransition()\n      }\n    }\n  }\n\n  const handleVisibilityChange = useCallback(() => {\n    if (document.hidden) {\n      isTabHidden.current = true\n      clearTimeoutRef()\n\n      const timer: TransitionTimer = {\n        timeoutId: null,\n        startTime: performance.now(),\n        remainingTime: 0,\n      }\n\n      switch (transitionState.current) {\n        case 'FADING_OUT':\n          timer.remainingTime = config.fadeOutDuration\n          break\n        case 'INTERSTITIAL':\n          timer.remainingTime = config.interstitialDuration\n          break\n        case 'FADING_IN':\n          timer.remainingTime = config.fadeInDuration\n          break\n        default:\n          return\n      }\n\n      transitionTimers.current.set(transitionState.current, timer)\n    } else {\n      isTabHidden.current = false\n      resumeTransition()\n    }\n  }, [transitionState, config, resumeTransition])\n\n  useEffect(() => {\n    window.addEventListener('keydown', handleKeyDown)\n    window.addEventListener('visibilitychange', handleVisibilityChange)\n    return () => {\n      window.removeEventListener('keydown', handleKeyDown)\n      window.removeEventListener('visibilitychange', handleVisibilityChange)\n      clearTimeoutRef()\n    }\n  }, [config.skipEnabled, transitionState.current, skipTransition, handleVisibilityChange])\n\n  return {\n    transitionState: transitionState.current,\n    isTransitioning: transitionState.current !== 'PLAYING' && transitionState.current !== 'READY',\n    isFadingOut: transitionState.current === 'FADING_OUT',\n    isInterstitial: transitionState.current === 'INTERSTITIAL',\n    isFadingIn: transitionState.current === 'FADING_IN',\n    isReady: transitionState.current === 'READY',\n    startTransition,\n    skipTransition,\n    resetTransition,\n  }\n}\n","after":"import { useState, useEffect, useRef, useCallback } from 'react'\nimport type { TransitionState, TransitionConfig } from '../types'\n\nconst DEFAULT_CONFIG: TransitionConfig = {\n  fadeOutDuration: 2000,\n  fadeInDuration: 2000,\n  interstitialDuration: 2000,\n  autoAdvanceDelay: 2000,\n  skipEnabled: true,\n}\n\ninterface TransitionStateInternal {\n  current: TransitionState\n  canTransition: boolean\n}\n\ninterface TransitionTimer {\n  timeoutId: number | null\n  startTime: number | null\n  remainingTime: number\n}\n\nexport function useTransition(\n  config: TransitionConfig = DEFAULT_CONFIG,\n  onTransitionComplete?: () => void\n) {\n  const [transitionState, setTransitionState] = useState<TransitionStateInternal>({\n    current: 'PLAYING',\n    canTransition: false,\n  })\n\n  const timeoutRef = useRef<number | null>(null)\n  const transitionTimers = useRef<Map<TransitionState, TransitionTimer>>(new Map())\n  const isTabHidden = useRef(false)\n\n  const clearTimeoutRef = () => {\n    if (timeoutRef.current !== null) {\n      window.clearTimeout(timeoutRef.current)\n      timeoutRef.current = null\n    }\n  }\n\n  const scheduleTransition = useCallback(\n    (duration: number, nextState: TransitionState) => {\n      clearTimeoutRef()\n\n      if (isTabHidden.current) {\n        const timer: TransitionTimer = {\n          timeoutId: null,\n          startTime: null,\n          remainingTime: duration,\n        }\n        transitionTimers.current.set(transitionState.current, timer)\n        return\n      }\n\n      timeoutRef.current = window.setTimeout(() => {\n        setTransitionState({ current: nextState, canTransition: nextState === 'READY' })\n        transitionTimers.current.delete(transitionState.current)\n\n        if (nextState === 'READY') {\n          onTransitionComplete?.()\n        }\n      }, duration)\n    },\n    [transitionState, onTransitionComplete]\n  )\n\n  const resumeTransition = useCallback(() => {\n    const timer = transitionTimers.current.get(transitionState.current)\n    if (timer && timer.remainingTime > 0) {\n      scheduleTransition(timer.remainingTime, getNextState(transitionState.current))\n      transitionTimers.current.delete(transitionState.current)\n    }\n  }, [transitionState, scheduleTransition])\n\n  const getNextState = (currentState: TransitionState): TransitionState => {\n    switch (currentState) {\n      case 'PLAYING':\n        return 'FADING_OUT'\n      case 'FADING_OUT':\n        return 'INTERSTITIAL'\n      case 'INTERSTITIAL':\n        return 'FADING_IN'\n      case 'FADING_IN':\n        return 'READY'\n      default:\n        return 'PLAYING'\n    }\n  }\n\n  const startTransition = () => {\n    scheduleTransition(config.fadeOutDuration, 'FADING_OUT')\n\n    setTimeout(() => {\n      if (!isTabHidden.current) {\n        scheduleTransition(config.interstitialDuration, 'FADING_IN')\n      }\n    }, config.fadeOutDuration)\n\n    setTimeout(() => {\n      if (!isTabHidden.current) {\n        scheduleTransition(config.fadeInDuration, 'READY')\n      }\n    }, config.fadeOutDuration + config.interstitialDuration)\n  }\n\n  const skipTransition = () => {\n    clearTimeoutRef()\n    transitionTimers.current.clear()\n    setTransitionState({ current: 'READY', canTransition: true })\n    onTransitionComplete?.()\n  }\n\n  const resetTransition = () => {\n    clearTimeoutRef()\n    transitionTimers.current.clear()\n    setTransitionState({ current: 'PLAYING', canTransition: false })\n  }\n\n  const handleKeyDown = (e: KeyboardEvent) => {\n    if (config.skipEnabled && (e.code === 'Space' || e.code === 'Escape')) {\n      if (transitionState.current !== 'PLAYING' && transitionState.current !== 'READY') {\n        skipTransition()\n      }\n    }\n  }\n\n  const handleVisibilityChange = useCallback(() => {\n    if (document.hidden) {\n      isTabHidden.current = true\n      clearTimeoutRef()\n\n      const timer: TransitionTimer = {\n        timeoutId: null,\n        startTime: performance.now(),\n        remainingTime: 0,\n      }\n\n      switch (transitionState.current) {\n        case 'FADING_OUT':\n          timer.remainingTime = config.fadeOutDuration\n          break\n        case 'INTERSTITIAL':\n          timer.remainingTime = config.interstitialDuration\n          break\n        case 'FADING_IN':\n          timer.remainingTime = config.fadeInDuration\n          break\n        default:\n          return\n      }\n\n      transitionTimers.current.set(transitionState.current, timer)\n    } else {\n      isTabHidden.current = false\n      resumeTransition()\n    }\n  }, [transitionState, config, resumeTransition])\n\n  useEffect(() => {\n    window.addEventListener('keydown', handleKeyDown)\n    window.addEventListener('visibilitychange', handleVisibilityChange)\n    return () => {\n      window.removeEventListener('keydown', handleKeyDown)\n      window.removeEventListener('visibilitychange', handleVisibilityChange)\n      clearTimeoutRef()\n    }\n  }, [config.skipEnabled, transitionState.current, skipTransition, handleVisibilityChange])\n\n  return {\n    transitionState: transitionState.current,\n    isTransitioning: transitionState.current !== 'PLAYING' && transitionState.current !== 'READY',\n    isFadingOut: transitionState.current === 'FADING_OUT',\n    isInterstitial: transitionState.current === 'INTERSTITIAL',\n    isFadingIn: transitionState.current === 'FADING_IN',\n    isReady: transitionState.current === 'READY',\n    startTransition,\n    skipTransition,\n    resetTransition,\n  }\n}\n","additions":2,"deletions":6},"truncated":false},"time":{"start":1771183305427,"end":1771183308795}}}}
