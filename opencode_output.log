     progress < 0.5 ? 2 * progress * progress : 1 - Math.pow(-2 * progress + 2, 2) / 2\n\n      setDisplayScore(Math.round(startValue + (endValue - startValue) * easedProgress))\n\n      if (progress < 1) {\n        window.requestAnimationFrame(animate)\n      }\n    }\n\n    window.requestAnimationFrame(animate)\n  }, [score, displayScore])\n\n  return (\n    <div className=\"score-display-container\">\n      <div className=\"score-display\">\n        <span\n          className={`score-value ${isPulsing ? 'pulse' : ''} ${isMilestoneFlash ? 'milestone-flash' : ''}`}\n        >\n          {formatScore(displayScore)}\n        </span>\n        <span className=\"score-label\">PTS</span>\n      </div>\n      {showPatternBreakdown && (\n        <div className=\"score-breakdown\">\n          <div className=\"score-breakdown-item\">\n            <span className=\"breakdown-label\">Movers:</span>\n            <span className=\"breakdown-value\">{movers}</span>\n          </div>\n          <div className=\"score-breakdown-item\">\n            <span className=\"breakdown-label\">Oscillators:</span>\n            <span className=\"breakdown-value\">{oscillators}</span>\n          </div>\n          <div className=\"score-breakdown-item\">\n            <span className=\"breakdown-label\">Rate:</span>\n            <span className=\"breakdown-value\">{rate}/gen</span>\n          </div>\n        </div>\n      )}\n    </div>\n  )\n}\n","filePath":"/home/ochanomizu/repos/game_of_life/src/components/ScoreDisplay.tsx"},"output":"Wrote file successfully.","title":"src/components/ScoreDisplay.tsx","metadata":{"diagnostics":{"/home/ochanomizu/repos/game_of_life/src/components/Game.tsx":[],"/home/ochanomizu/repos/game_of_life/src/components/GlassHUD.tsx":[],"/home/ochanomizu/repos/game_of_life/src/components/IntroOverlay.tsx":[],"/home/ochanomizu/repos/game_of_life/src/components/GlassHUD.test.tsx":[],"/home/ochanomizu/repos/game_of_life/src/components/GridInteraction.tsx":[],"/home/ochanomi