{"type":"tool_use","timestamp":1771167760352,"sessionID":"ses_39e2d200bffenWVxn564xoSdlc","part":{"id":"prt_c61d33fba001HI2LdRk3Um9Wsx","sessionID":"ses_39e2d200bffenWVxn564xoSdlc","messageID":"msg_c61d32e68001d7fkkTP4rZ5srU","type":"tool","callID":"call_60ae4190e00f402e92ff1435","tool":"read","state":{"status":"completed","input":{"filePath":"/home/ochanomizu/repos/game_of_life/src/lib/simulation.test.ts"},"output":"<path>/home/ochanomizu/repos/game_of_life/src/lib/simulation.test.ts</path>\n<type>file</type>\n<content>1: import { describe, it, expect } from 'vitest'\n2: import {\n3:   createGrid,\n4:   countNeighbors,\n5:   applyRules,\n6:   stepSimulation,\n7:   setCell,\n8:   clearGrid,\n9:   randomFill,\n10:   countAliveCells,\n11:   CONWAY_RULES,\n12:   getGridSize,\n13:   isGridEmpty,\n14:   GRID_SIZE_PRESETS,\n15: } from '../lib/simulation'\n16: import type { SimulationState } from '../types'\n17: \n18: describe('createGrid', () => {\n19:   it('should create a grid with correct dimensions', () => {\n20:     const grid = createGrid(3, 4)\n21:     expect(grid).toHaveLength(3)\n22:     expect(grid[0]).toHaveLength(4)\n23:   })\n24: \n25:   it('should initialize all cells to 0 (dead)', () => {\n26:     const grid = createGrid(5, 5)\n27:     for (const row of grid) {\n28:       for (const cell of row) {\n29:         expect(cell).toBe(0)\n30:       }\n31:     }\n32:   })\n33: })\n34: \n35: describe('countNeighbors', () => {\n36:   it('should count neighbors for a cell in the middle', () => {\n37:     const grid = createGrid(3, 3)\n38:     grid[0][1] = 1\n39:     grid[1][0] = 1\n40:     grid[1][2] = 1\n41:     grid[2][1] = 1\n42:     const count = countNeighbors(grid, 1, 1)\n43:     expect(count).toBe(4)\n44:   })\n45: \n46:   it('should handle toroidal boundaries (wrap around)', () => {\n47:     const grid = createGrid(3, 3)\n48:     grid[0][0] = 1\n49:     grid[2][0] = 1\n50:     grid[0][2] = 1\n51:     const count = countNeighbors(grid, 0, 0)\n52:     expect(count).toBe(2)\n53:   })\n54: \n55:   it('should count only alive cells (age > 0)', () => {\n56:     const grid = createGrid(3, 3)\n57:     grid[0][1] = 1\n58:     grid[1][0] = 0\n59:     grid[1][2] = 2\n60:     const count = countNeighbors(grid, 1, 1)\n61:     expect(count).toBe(2)\n62:   })\n63: })\n64: \n65: describe('applyRules', () => {\n66:   it('should apply Conway rules correctly - block pattern', () => {\n67:     const grid = createGrid(4, 4)\n68:     grid[1][1] = 1\n69:     grid[1][2] = 1\n70:     grid[2][1] = 1\n71:     grid[2][2] = 1\n72: \n73:     const result = applyRules(grid, CONWAY_RULES)\n74: \n75:     expect(result.newGrid[1][1]).toBe(2)\n76:     expect(result.newGrid[1][2]).toBe(2)\n77:     expect(result.newGrid[2][1]).toBe(2)\n78:     expect(result.newGrid[2][2]).toBe(2)\n79:     expect(result.bornCount).toBe(0)\n80:   })\n81: \n82:   it('should apply Conway rules correctly - glider pattern (generation 0 to 1)', () => {\n83:     const grid = createGrid(10, 10)\n84:     grid[1][2] = 1\n85:     grid[2][3] = 1\n86:     grid[3][1] = 1\n87:     grid[3][2] = 1\n88:     grid[3][3] = 1\n89: \n90:     const result = applyRules(grid, CONWAY_RULES)\n91: \n92:     expect(result.newGrid[2][1]).toBe(1)\n93:     expect(result.newGrid[2][3]).toBe(2)\n94:     expect(result.newGrid[3][2]).toBe(2)\n95:     expect(result.newGrid[3][3]).toBe(2)\n96:     expect(result.newGrid[4][2]).toBe(1)\n97:     expect(result.bornCount).toBe(2)\n98:   })\n99: \n100:   it('should increment age for surviving cells', () => {\n101:     const grid = createGrid(4, 4)\n102:     grid[1][1] = 2\n103:     grid[1][2] = 2\n104:     grid[2][1] = 2\n105:     grid[2][2] = 2\n106: \n107:     const result = applyRules(grid, CONWAY_RULES)\n108: \n109:     expect(result.newGrid[1][1]).toBe(3)\n110:     expect(result.newGrid[1][2]).toBe(3)\n111:     expect(result.newGrid[2][1]).toBe(3)\n112:     expect(result.newGrid[2][2]).toBe(3)\n113:   })\n114: \n115:   it('should set age to 1 for born cells', () => {\n116:     const grid = createGrid(10, 10)\n117:     grid[1][2] = 1\n118:     grid[2][3] = 1\n119:     grid[3][1] = 1\n120:     grid[3][2] = 1\n121:     grid[3][3] = 1\n122: \n123:     const result = applyRules(grid, CONWAY_RULES)\n124: \n125:     expect(result.newGrid[2][1]).toBe(1)\n126:     expect(result.newGrid[4][2]).toBe(1)\n127:   })\n128: \n129:   it('should calculate average row position for births', () => {\n130:     const grid = createGrid(10, 10)\n131:     grid[1][2] = 1\n132:     grid[2][3] = 1\n133:     grid[3][1] = 1\n134:     grid[3][2] = 1\n135:     grid[3][3] = 1\n136: \n137:     const result = applyRules(grid, CONWAY_RULES)\n138: \n139:     expect(result.averageRow).toBe(3)\n140:   })\n141: \n142:   it('should handle no births', () => {\n143:     const grid = createGrid(4, 4)\n144:     grid[1][1] = 1\n145: \n146:     const result = applyRules(grid, CONWAY_RULES)\n147: \n148:     expect(result.bornCount).toBe(0)\n149:     expect(result.averageRow).toBe(0)\n150:   })\n151: })\n152: \n153: describe('stepSimulation', () => {\n154:   it('should increment generation counter', () => {\n155:     const state: SimulationState = {\n156:       grid: createGrid(3, 3),\n157:       generation: 5,\n158:       running: false,\n159:       speed: 100,\n160:       selectedRule: CONWAY_RULES,\n161:     }\n162: \n163:     const result = stepSimulation(state)\n164: \n165:     expect(result.newGeneration).toBe(6)\n166:   })\n167: \n168:   it('should apply rules and return new grid', () => {\n169:     const grid = createGrid(10, 10)\n170:     grid[1][2] = 1\n171:     grid[2][3] = 1\n172:     grid[3][1] = 1\n173:     grid[3][2] = 1\n174:     grid[3][3] = 1\n175: \n176:     const state: SimulationState = {\n177:       grid,\n178:       generation: 0,\n179:       running: false,\n180:       speed: 100,\n181:       selectedRule: CONWAY_RULES,\n182:     }\n183: \n184:     const result = stepSimulation(state)\n185: \n186:     expect(result.newGrid[2][1]).toBe(1)\n187:     expect(result.newGrid[4][2]).toBe(1)\n188:     expect(result.bornCount).toBe(2)\n189:     expect(result.newGeneration).toBe(1)\n190:   })\n191: })\n192: \n193: describe('setCell', () => {\n194:   it('should set a cell to specified age', () => {\n195:     const grid = createGrid(3, 3)\n196:     const newGrid = setCell(grid, 1, 1, 5)\n197: \n198:     expect(newGrid[1][1]).toBe(5)\n199:     expect(newGrid).not.toBe(grid)\n200:   })\n201: \n202:   it('should create a new grid (not mutate)', () => {\n203:     const grid = createGrid(3, 3)\n204:     const newGrid = setCell(grid, 1, 1, 1)\n205: \n206:     expect(newGrid).not.toBe(grid)\n207:     expect(grid[1][1]).toBe(0)\n208:   })\n209: })\n210: \n211: describe('clearGrid', () => {\n212:   it('should create a new empty grid', () => {\n213:     const grid = createGrid(3, 3)\n214:     grid[1][1] = 1\n215:     const newGrid = clearGrid(3, 3)\n216: \n217:     expect(newGrid[1][1]).toBe(0)\n218:     expect(newGrid).toHaveLength(3)\n219:   })\n220: })\n221: \n222: describe('randomFill', () => {\n223:   it('should fill grid with random cells', () => {\n224:     const grid = createGrid(10, 10)\n225:     const filled = randomFill(grid, 0.5)\n226: \n227:     const aliveCount = countAliveCells(filled)\n228:     expect(aliveCount).toBeGreaterThan(0)\n229:     expect(aliveCount).toBeLessThan(100)\n230:   })\n231: \n232:   it('should not mutate original grid', () => {\n233:     const grid = createGrid(3, 3)\n234:     const filled = randomFill(grid, 0.5)\n235: \n236:     expect(filled).not.toBe(grid)\n237:     expect(grid[0][0]).toBe(0)\n238:   })\n239: \n240:   it('should use default density of 0.15', () => {\n241:     const grid = createGrid(100, 100)\n242:     const filled = randomFill(grid)\n243: \n244:     const aliveCount = countAliveCells(filled)\n245:     expect(aliveCount).toBeGreaterThan(0)\n246:     expect(aliveCount).toBeLessThan(2000)\n247:   })\n248: })\n249: \n250: describe('countAliveCells', () => {\n251:   it('should count all alive cells', () => {\n252:     const grid = createGrid(3, 3)\n253:     grid[0][0] = 1\n254:     grid[0][1] = 2\n255:     grid[1][0] = 5\n256: \n257:     const count = countAliveCells(grid)\n258:     expect(count).toBe(3)\n259:   })\n260: \n261:   it('should return 0 for empty grid', () => {\n262:     const grid = createGrid(3, 3)\n263:     const count = countAliveCells(grid)\n264:     expect(count).toBe(0)\n265:   })\n266: \n267:   it('should count cells with any age > 0', () => {\n268:     const grid = createGrid(2, 2)\n269:     grid[0][0] = 0\n270:     grid[0][1] = 1\n271:     grid[1][0] = 100\n272:     grid[1][1] = 2\n273: \n274:     const count = countAliveCells(grid)\n275:     expect(count).toBe(3)\n276:   })\n277: })\n278: \n279: describe('isGridEmpty', () => {\n280:   it('should return true for empty grid', () => {\n281:     const grid = createGrid(3, 3)\n282:     expect(isGridEmpty(grid)).toBe(true)\n283:   })\n284: \n285:   it('should return false for grid with alive cells', () => {\n286:     const grid = createGrid(3, 3)\n287:     grid[1][1] = 1\n288:     expect(isGridEmpty(grid)).toBe(false)\n289:   })\n290: })\n291: \n292: describe('GRID_SIZE_PRESETS', () => {\n293:   it('should have correct SMALL preset', () => {\n294:     expect(GRID_SIZE_PRESETS.SMALL).toEqual({ rows: 20, cols: 30 })\n295:   })\n296: \n297:   it('should have correct MEDIUM preset', () => {\n298:     expect(GRID_SIZE_PRESETS.MEDIUM).toEqual({ rows: 40, cols: 50 })\n299:   })\n300: \n301:   it('should have correct LARGE preset', () => {\n302:     expect(GRID_SIZE_PRESETS.LARGE).toEqual({ rows: 60, cols: 80 })\n303:   })\n304: })\n305: \n306: describe('getGridSize', () => {\n307:   it('should return correct size for SMALL preset', () => {\n308:     const size = getGridSize('SMALL')\n309:     expect(size).toEqual({ rows: 20, cols: 30 })\n310:   })\n311: \n312:   it('should return correct size for MEDIUM preset', () => {\n313:     const size = getGridSize('MEDIUM')\n314:     expect(size).toEqual({ rows: 40, cols: 50 })\n315:   })\n316: \n317:   it('should return correct size for LARGE preset', () => {\n318:     const size = getGridSize('LARGE')\n319:     expect(size).toEqual({ rows: 60, cols: 80 })\n320:   })\n321: })\n322: \n\n(End of file - total 322 lines)\n</content>","title":"src/lib/simulation.test.ts","metadata":{"preview":"import { describe, it, expect } from 'vitest'\nimport {\n  createGrid,\n  countNeighbors,\n  applyRules,\n  stepSimulation,\n  setCell,\n  clearGrid,\n  randomFill,\n  countAliveCells,\n  CONWAY_RULES,\n  getGridSize,\n  isGridEmpty,\n  GRID_SIZE_PRESETS,\n} from '../lib/simulation'\nimport type { SimulationState } from '../types'\n\ndescribe('createGrid', () => {\n  it('should create a grid with correct dimensions', () => {\n    const grid = createGrid(3, 4)","truncated":false,"loaded":[]},"time":{"start":1771167760317,"end":1771167760350}}}}
