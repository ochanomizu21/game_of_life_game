{"type":"tool_use","timestamp":1771180692270,"sessionID":"ses_39d69a733ffeSFR27erfn8OGrt","part":{"id":"prt_c6298931a001xdYfIx3bWtVq1c","sessionID":"ses_39d69a733ffeSFR27erfn8OGrt","messageID":"msg_c6298817c001eUasCRLhnIGi0G","type":"tool","callID":"call_dfb0ceced9434fa5a8c83318","tool":"read","state":{"status":"completed","input":{"filePath":"/home/ochanomizu/repos/game_of_life/src/components/GlassHUD.tsx"},"output":"<path>/home/ochanomizu/repos/game_of_life/src/components/GlassHUD.tsx</path>\n<type>file</type>\n<content>1: import type { GamePhase, InteractionMode } from '../types'\n2: import type { GridSizePreset } from '../lib/simulation'\n3: import '../styles/GlassHUD.css'\n4: \n5: interface GlassHUDProps {\n6:   phase: GamePhase\n7:   aliveCount: number\n8:   flux: number\n9:   fluxMax: number\n10:   interactionMode: InteractionMode\n11:   gridPreset: GridSizePreset\n12:   showGridLines: boolean\n13:   canStart: boolean\n14:   canInteract: boolean\n15:   onStart: () => void\n16:   onClear: () => void\n17:   onRandom: () => void\n18:   onToggleGrid: () => void\n19:   onSetMode: (mode: InteractionMode) => void\n20:   onSetGridPreset: (preset: GridSizePreset) => void\n21:   onToggleSettings: () => void\n22: }\n23: \n24: export function GlassHUD({\n25:   phase,\n26:   aliveCount,\n27:   flux,\n28:   fluxMax,\n29:   interactionMode,\n30:   gridPreset,\n31:   showGridLines,\n32:   canStart,\n33:   canInteract,\n34:   onStart,\n35:   onClear,\n36:   onRandom,\n37:   onToggleGrid,\n38:   onSetMode,\n39:   onSetGridPreset,\n40:   onToggleSettings,\n41: }: GlassHUDProps) {\n42:   const getFluxColor = (current: number, max: number): string => {\n43:     const ratio = current / max\n44:     if (ratio <= 0) return 'red'\n45:     if (ratio < 0.3) return 'orange'\n46:     if (ratio < 0.5) return 'orange'\n47:     return 'green'\n48:   }\n49: \n50:   const fluxColor = getFluxColor(flux, fluxMax)\n51: \n52:   return (\n53:     <div className=\"glass-hud-container\">\n54:       <div className=\"glass-hud\">\n55:         <div className=\"hud-controls\">\n56:           <div className=\"hud-group\">\n57:             <button\n58:               className=\"hud-button active\"\n59:               onClick={onStart}\n60:               disabled={!canStart || !canInteract}\n61:             >\n62:               {phase === 'PLANNING' ? 'START' : 'RUNNING'}\n63:             </button>\n64:             <button className=\"hud-button\" onClick={onRandom} disabled={!canInteract}>\n65:               RANDOM\n66:             </button>\n67:             <button\n68:               className=\"hud-button hud-button-danger\"\n69:               onClick={onClear}\n70:               disabled={!canInteract}\n71:             >\n72:               CLEAR\n73:             </button>\n74:           </div>\n75: \n76:           <div className=\"hud-group\">\n77:             <button\n78:               className={`hud-button ${interactionMode === 'DRAW' ? 'active' : ''}`}\n79:               onClick={() => onSetMode('DRAW')}\n80:               disabled={!canInteract}\n81:             >\n82:               DRAW\n83:             </button>\n84:             <button\n85:               className={`hud-button ${interactionMode === 'ERASE' ? 'active' : ''}`}\n86:               onClick={() => onSetMode('ERASE')}\n87:               disabled={!canInteract}\n88:             >\n89:               ERASE\n90:             </button>\n91:           </div>\n92: \n93:           <div className=\"hud-group\">\n94:             <button\n95:               className={`hud-button ${gridPreset === 'SMALL' ? 'active' : ''}`}\n96:               onClick={() => onSetGridPreset('SMALL')}\n97:               disabled={!canInteract}\n98:             >\n99:               Small\n100:             </button>\n101:             <button\n102:               className={`hud-button ${gridPreset === 'MEDIUM' ? 'active' : ''}`}\n103:               onClick={() => onSetGridPreset('MEDIUM')}\n104:               disabled={!canInteract}\n105:             >\n106:               Medium\n107:             </button>\n108:             <button\n109:               className={`hud-button ${gridPreset === 'LARGE' ? 'active' : ''}`}\n110:               onClick={() => onSetGridPreset('LARGE')}\n111:               disabled={!canInteract}\n112:             >\n113:               Large\n114:             </button>\n115:           </div>\n116: \n117:           <div className=\"hud-group\">\n118:             <button className=\"hud-button\" onClick={onToggleGrid} disabled={!canInteract}>\n119:               {showGridLines ? 'Hide Grid' : 'Show Grid'}\n120:             </button>\n121:             <button className=\"hud-button\" onClick={onToggleSettings}>\n122:               ⚙️\n123:             </button>\n124:           </div>\n125: \n126:           <div className=\"hud-status\">\n127:             <div className=\"hud-status-item\">\n128:               <span className=\"hud-status-label\">Phase:</span>\n129:               <span className=\"hud-status-value\">{phase}</span>\n130:             </div>\n131:             <div className=\"hud-status-item\">\n132:               <span className=\"hud-status-label\">Cells:</span>\n133:               <span className=\"hud-status-value\">{aliveCount}</span>\n134:             </div>\n135:             <div className=\"hud-status-item\">\n136:               <span className=\"hud-status-label\">Flux:</span>\n137:               <span className={`hud-status-value ${fluxColor}`}>{flux}</span>\n138:             </div>\n139:           </div>\n140:         </div>\n141:       </div>\n142:     </div>\n143:   )\n144: }\n145: \n\n(End of file - total 145 lines)\n</content>","title":"src/components/GlassHUD.tsx","metadata":{"preview":"import type { GamePhase, InteractionMode } from '../types'\nimport type { GridSizePreset } from '../lib/simulation'\nimport '../styles/GlassHUD.css'\n\ninterface GlassHUDProps {\n  phase: GamePhase\n  aliveCount: number\n  flux: number\n  fluxMax: number\n  interactionMode: InteractionMode\n  gridPreset: GridSizePreset\n  showGridLines: boolean\n  canStart: boolean\n  canInteract: boolean\n  onStart: () => void\n  onClear: () => void\n  onRandom: () => void\n  onToggleGrid: () => void\n  onSetMode: (mode: InteractionMode) => void\n  onSetGridPreset: (preset: GridSizePreset) => void","truncated":false,"loaded":[]},"time":{"start":1771180692262,"end":1771180692267}}}}
