{"type":"tool_use","timestamp":1771183232836,"sessionID":"ses_39d430eecffenagK7FExfhPqyr","part":{"id":"prt_c62bf573000135QRqVHn0U4Vsp","sessionID":"ses_39d430eecffenagK7FExfhPqyr","messageID":"msg_c62bf20a7001w3cPZHEORiIzrx","type":"tool","callID":"call_5d42b50735db45f08ea03f4d","tool":"read","state":{"status":"completed","input":{"filePath":"/home/ochanomizu/repos/game_of_life/src/hooks/useTransition.ts"},"output":"<path>/home/ochanomizu/repos/game_of_life/src/hooks/useTransition.ts</path>\n<type>file</type>\n<content>1: import { useState, useEffect, useRef } from 'react'\n2: import type { TransitionState, TransitionConfig } from '../types'\n3: \n4: const DEFAULT_CONFIG: TransitionConfig = {\n5:   fadeOutDuration: 2000,\n6:   fadeInDuration: 2000,\n7:   interstitialDuration: 2000,\n8:   autoAdvanceDelay: 2000,\n9:   skipEnabled: true,\n10: }\n11: \n12: interface TransitionStateInternal {\n13:   current: TransitionState\n14:   canTransition: boolean\n15: }\n16: \n17: export function useTransition(\n18:   config: TransitionConfig = DEFAULT_CONFIG,\n19:   onTransitionComplete?: () => void\n20: ) {\n21:   const [transitionState, setTransitionState] = useState<TransitionStateInternal>({\n22:     current: 'PLAYING',\n23:     canTransition: false,\n24:   })\n25: \n26:   const timeoutRef = useRef<number | null>(null)\n27: \n28:   const clearTimeoutRef = () => {\n29:     if (timeoutRef.current !== null) {\n30:       window.clearTimeout(timeoutRef.current)\n31:       timeoutRef.current = null\n32:     }\n33:   }\n34: \n35:   const startTransition = () => {\n36:     setTransitionState({ current: 'FADING_OUT', canTransition: false })\n37: \n38:     timeoutRef.current = window.setTimeout(() => {\n39:       setTransitionState({ current: 'INTERSTITIAL', canTransition: false })\n40: \n41:       timeoutRef.current = window.setTimeout(() => {\n42:         setTransitionState({ current: 'FADING_IN', canTransition: false })\n43: \n44:         timeoutRef.current = window.setTimeout(() => {\n45:           setTransitionState({ current: 'READY', canTransition: true })\n46:           onTransitionComplete?.()\n47:         }, config.fadeInDuration)\n48:       }, config.interstitialDuration)\n49:     }, config.fadeOutDuration)\n50:   }\n51: \n52:   const skipTransition = () => {\n53:     clearTimeoutRef()\n54:     setTransitionState({ current: 'READY', canTransition: true })\n55:     onTransitionComplete?.()\n56:   }\n57: \n58:   const resetTransition = () => {\n59:     clearTimeoutRef()\n60:     setTransitionState({ current: 'PLAYING', canTransition: false })\n61:   }\n62: \n63:   const handleKeyDown = (e: KeyboardEvent) => {\n64:     if (config.skipEnabled && (e.code === 'Space' || e.code === 'Escape')) {\n65:       if (transitionState.current !== 'PLAYING' && transitionState.current !== 'READY') {\n66:         skipTransition()\n67:       }\n68:     }\n69:   }\n70: \n71:   useEffect(() => {\n72:     window.addEventListener('keydown', handleKeyDown)\n73:     return () => {\n74:       window.removeEventListener('keydown', handleKeyDown)\n75:       clearTimeoutRef()\n76:     }\n77:   }, [config.skipEnabled, transitionState.current, skipTransition])\n78: \n79:   return {\n80:     transitionState: transitionState.current,\n81:     isTransitioning: transitionState.current !== 'PLAYING' && transitionState.current !== 'READY',\n82:     isFadingOut: transitionState.current === 'FADING_OUT',\n83:     isInterstitial: transitionState.current === 'INTERSTITIAL',\n84:     isFadingIn: transitionState.current === 'FADING_IN',\n85:     isReady: transitionState.current === 'READY',\n86:     startTransition,\n87:     skipTransition,\n88:     resetTransition,\n89:   }\n90: }\n91: \n\n(End of file - total 91 lines)\n</content>","title":"src/hooks/useTransition.ts","metadata":{"preview":"import { useState, useEffect, useRef } from 'react'\nimport type { TransitionState, TransitionConfig } from '../types'\n\nconst DEFAULT_CONFIG: TransitionConfig = {\n  fadeOutDuration: 2000,\n  fadeInDuration: 2000,\n  interstitialDuration: 2000,\n  autoAdvanceDelay: 2000,\n  skipEnabled: true,\n}\n\ninterface TransitionStateInternal {\n  current: TransitionState\n  canTransition: boolean\n}\n\nexport function useTransition(\n  config: TransitionConfig = DEFAULT_CONFIG,\n  onTransitionComplete?: () => void\n) {","truncated":false,"loaded":[]},"time":{"start":1771183232819,"end":1771183232835}}}}
{"type":"tool_use","timestamp":1771183232839,"sessionID":"ses_39d430eecffenagK7FExfhPqyr","part":{"id":"prt_c62bf5735001LgZjvYc9FotrtR","sessionID":"ses_39d430eecffenagK7FExfhPqyr","messageID":"msg_c62bf20a7001w3cPZHEORiIzrx","type":"tool","callID":"call_f75152b1bb8341bf88f4b4e0","tool":"read","state":{"status":"completed","input":{"filePath":"/home/ochanomizu/repos/game_of_life/src/components/Game.tsx"},"output":"<path>/home/ochanomizu/repos/game_of_life/src/components/Game.tsx</path>\n<type>file</type>\n<content>1: import { useState, useCallback, useEffect, useRef } from 'react'\n2: import { createGrid, GRID_SIZE_PRESETS, type GridSizePreset } from '../lib/simulation'\n3: import {\n4:   type GridType,\n5:   type FluxState,\n6:   type InteractionMode,\n7:   type TrackedCluster,\n8:   type ExpertSettings,\n9:   type LevelProgression,\n10: } from '../types'\n11: import { createInitialFluxState } from '../lib/flux'\n12: import { GridInteraction } from './GridInteraction'\n13: import { usePhaseTimer } from '../hooks/usePhaseTimer'\n14: import { useTransition } from '../hooks/useTransition'\n15: import { stepSimulation, CONWAY_RULES } from '../lib/simulation'\n16: import { findConnectedComponents, trackClusters } from '../lib/movement'\n17: import { createInitialScoreState, updateScore, calculateGenerationScore } from '../lib/scoring'\n18: import { ScoreDisplay } from './ScoreDisplay'\n19: import { GlassHUD } from './GlassHUD'\n20: import { SettingsPanel } from './SettingsPanel'\n21: import { TransitionOverlay } from './TransitionOverlay'\n22: import { VictoryScreen } from './VictoryScreen'\n23: import {\n24:   createInitialExpertSettings,\n25:   saveToLocalStorage,\n26:   loadFromLocalStorage,\n27: } from '../lib/settings'\n28: import {\n29:   generateProgression,\n30:   getCurrentLevelConfig,\n31:   advanceLevel,\n32:   isFinalLevel,\n33:   resetProgression,\n34: } from '../lib/level'\n35: \n36: export function Game() {\n37:   const [gridPreset, setGridPreset] = useState<GridSizePreset>('SMALL')\n38:   const [grid, setGrid] = useState<GridType>(() => createGrid(20, 30))\n39:   const [flux, setFlux] = useState<FluxState>(() => createInitialFluxState(20))\n40:   const [showGridLines, setShowGridLines] = useState(true)\n41:   const [interactionMode, setInteractionMode] = useState<InteractionMode>('DRAW')\n42:   const [generation, setGeneration] = useState(0)\n43:   const [scoreState, setScoreState] = useState(() => createInitialScoreState())\n44:   const [settingsPanelOpen, setSettingsPanelOpen] = useState(false)\n45:   const [expertSettings, setExpertSettings] = useState<ExpertSettings>(() => {\n46:     const saved = loadFromLocalStorage<ExpertSettings>(\n47:       'gol-expert-settings',\n48:       createInitialExpertSettings()\n49:     )\n50:     return saved\n51:   })\n52:   const [levelProgression, setLevelProgression] = useState<LevelProgression>(() =>\n53:     generateProgression(createInitialExpertSettings().levelGeneration)\n54:   )\n55:   const [showVictory, setShowVictory] = useState(false)\n56: \n57:   const previousTrackedClustersRef = useRef<TrackedCluster[]>([])\n58:   const simulationSpeed = 200\n59: \n60:   const currentLevelConfig = getCurrentLevelConfig(levelProgression)\n61: \n62:   const movementConfig = expertSettings.movementDetection\n63:   const scoringConfig = expertSettings.scoring\n64: \n65:   const handleTransitionComplete = useCallback(() => {\n66:     if (isFinalLevel(levelProgression)) {\n67:       setShowVictory(true)\n68:     } else {\n69:       const newProgression = advanceLevel(levelProgression, scoreState.currentScore)\n70:       const newLevelConfig = getCurrentLevelConfig(newProgression)\n71: \n72:       setLevelProgression(newProgression)\n73:       const { rows, cols } = GRID_SIZE_PRESETS[gridPreset]\n74:       setGrid(createGrid(rows, cols))\n75:       setFlux(createInitialFluxState(newLevelConfig?.initialFlux ?? 20))\n76:       setGeneration(0)\n77:       setScoreState(createInitialScoreState())\n78:       previousTrackedClustersRef.current = []\n79:     }\n80:   }, [levelProgression, scoreState.currentScore, gridPreset])\n81: \n82:   const { transitionState, startTransition } = useTransition(\n83:     {\n84:       fadeOutDuration: 2000,\n85:       fadeInDuration: 2000,\n86:       interstitialDuration: 2000,\n87:       autoAdvanceDelay: 2000,\n88:       skipEnabled: true,\n89:     },\n90:     handleTransitionComplete\n91:   )\n92: \n93:   const [previousScore, setPreviousScore] = useState(0)\n94: \n95:   const hasCells = useCallback(() => {\n96:     return grid.flat().filter((cell: number) => cell > 0).length > 0\n97:   }, [grid])\n98: \n99:   const { phaseState, startCountdown, startRunning } = usePhaseTimer(hasCells)\n100: \n101:   useEffect(() => {\n102:     if (phaseState.current === 'FINISHED') {\n103:       window.setTimeout(() => {\n104:         if (!showVictory) {\n105:           startTransition()\n106:         }\n107:       }, 2000)\n108:     }\n109:   }, [phaseState.current, showVictory, startTransition])\n110: \n111:   const handleSimulationStep = useCallback(() => {\n112:     const currentState = {\n113:       grid,\n114:       generation,\n115:       running: true,\n116:       speed: simulationSpeed,\n117:       selectedRule: CONWAY_RULES,\n118:     }\n119: \n120:     const result = stepSimulation(currentState)\n121: \n122:     const currentClusters = findConnectedComponents(result.newGrid, result.newGeneration)\n123:     const tracked = trackClusters(\n124:       currentClusters,\n125:       previousTrackedClustersRef.current,\n126:       movementConfig\n127:     )\n128: \n129:     const generationScore = calculateGenerationScore(tracked, scoringConfig)\n130:     const newScoreState = updateScore(scoreState, generationScore)\n131: \n132:     setPreviousScore(scoreState.currentScore)\n133:     previousTrackedClustersRef.current = tracked\n134:     setScoreState(newScoreState)\n135:     setGrid(result.newGrid)\n136:     setGeneration(result.newGeneration)\n137:   }, [grid, generation, simulationSpeed, scoreState, movementConfig, scoringConfig])\n138: \n139:   useEffect(() => {\n140:     let interval: number | undefined\n141: \n142:     if (phaseState.current === 'RUNNING') {\n143:       interval = window.setInterval(() => {\n144:         handleSimulationStep()\n145:       }, simulationSpeed)\n146:     }\n147: \n148:     return () => {\n149:       if (interval) {\n150:         window.clearInterval(interval)\n151:       }\n152:     }\n153:   }, [phaseState, simulationSpeed, handleSimulationStep])\n154: \n155:   const handleStart = useCallback(() => {\n156:     if (phaseState.current === 'PLANNING' && hasCells() && currentLevelConfig) {\n157:       startCountdown()\n158:       startRunning(currentLevelConfig.timeLimitSeconds)\n159:     }\n160:   }, [phaseState, startCountdown, hasCells, currentLevelConfig, startRunning])\n161: \n162:   const handleGridChange = useCallback((newGrid: GridType) => {\n163:     setGrid(newGrid)\n164:     setGeneration(0)\n165:   }, [])\n166: \n167:   const handleFluxChange = useCallback((newFlux: FluxState) => {\n168:     setFlux(newFlux)\n169:   }, [])\n170: \n171:   const handleClear = useCallback(() => {\n172:     const { rows, cols } = GRID_SIZE_PRESETS[gridPreset]\n173:     setGrid(createGrid(rows, cols))\n174:     setFlux(createInitialFluxState(20))\n175:     setGeneration(0)\n176:     setScoreState(createInitialScoreState())\n177:     previousTrackedClustersRef.current = []\n178:   }, [gridPreset])\n179: \n180:   const handleRandom = useCallback(() => {\n181:     const { rows, cols } = GRID_SIZE_PRESETS[gridPreset]\n182:     const newGrid = createGrid(rows, cols)\n183:     const density = 0.15\n184: \n185:     for (let row = 0; row < rows; row++) {\n186:       for (let col = 0; col < cols; col++) {\n187:         if (Math.random() < density) {\n188:           newGrid[row][col] = 1\n189:         }\n190:       }\n191:     }\n192: \n193:     setGrid(newGrid)\n194:     setFlux(createInitialFluxState(20))\n195:     setGeneration(0)\n196:     setScoreState(createInitialScoreState())\n197:     previousTrackedClustersRef.current = []\n198:   }, [gridPreset])\n199: \n200:   const aliveCount = grid.flat().filter((cell: number) => cell > 0).length\n201: \n202:   const handleToggleSettings = useCallback(() => {\n203:     setSettingsPanelOpen((prev) => !prev)\n204:   }, [])\n205: \n206:   const handleUpdateSettings = useCallback((newSettings: ExpertSettings) => {\n207:     setExpertSettings(newSettings)\n208:     saveToLocalStorage('gol-expert-settings', newSettings)\n209:   }, [])\n210: \n211:   const handleStep = useCallback(() => {\n212:     if (phaseState.current !== 'PLANNING') return\n213: \n214:     const currentState = {\n215:       grid,\n216:       generation,\n217:       running: false,\n218:       speed: 100,\n219:       selectedRule: CONWAY_RULES,\n220:     }\n221: \n222:     const result = stepSimulation(currentState)\n223:     setGrid(result.newGrid)\n224:     setGeneration(result.newGeneration)\n225:   }, [phaseState, grid, generation])\n226: \n227:   const canInteract = phaseState.current === 'PLANNING'\n228:   const isUiVisible = true\n229: \n230:   return (\n231:     <div style={{ padding: '20px', backgroundColor: '#0a0a0f', minHeight: '100vh', color: '#fff' }}>\n232:       <ScoreDisplay\n233:         score={scoreState.currentScore}\n234:         previousScore={previousScore}\n235:         showPatternBreakdown={false}\n236:       />\n237: \n238:       <SettingsPanel\n239:         isOpen={settingsPanelOpen}\n240:         settings={expertSettings}\n241:         onClose={() => setSettingsPanelOpen(false)}\n242:         onUpdateSettings={handleUpdateSettings}\n243:       />\n244: \n245:       <h1 style={{ textAlign: 'center', marginBottom: '20px', color: '#61dafb' }}>\n246:         Level {levelProgression.currentLevel} - Conway's Game of Life\n247:       </h1>\n248: \n249:       <TransitionOverlay\n250:         transitionState={transitionState}\n251:         currentLevel={levelProgression.currentLevel}\n252:       />\n253: \n254:       {showVictory && (\n255:         <VictoryScreen\n256:           totalScore={levelProgression.totalScore}\n257:           onPlayAgain={() => {\n258:             const reset = resetProgression()\n259:             setLevelProgression(reset)\n260:             setShowVictory(false)\n261:             const { rows, cols } = GRID_SIZE_PRESETS[gridPreset]\n262:             setGrid(createGrid(rows, cols))\n263:             setFlux(createInitialFluxState(reset.levels[0]?.initialFlux ?? 20))\n264:             setGeneration(0)\n265:             setScoreState(createInitialScoreState())\n266:             previousTrackedClustersRef.current = []\n267:           }}\n268:         />\n269:       )}\n270: \n271:       {isUiVisible && (\n272:         <GlassHUD\n273:           phase={phaseState.current}\n274:           aliveCount={aliveCount}\n275:           flux={flux.current}\n276:           fluxMax={flux.initial}\n277:           interactionMode={interactionMode}\n278:           gridPreset={gridPreset}\n279:           showGridLines={showGridLines}\n280:           generation={generation}\n281:           countdownValue={phaseState.countdownValue}\n282:           timerRemaining={phaseState.timerRemaining}\n283:           canStart={aliveCount > 0}\n284:           canInteract={canInteract}\n285:           onStart={handleStart}\n286:           onStep={handleStep}\n287:           onClear={handleClear}\n288:           onRandom={handleRandom}\n289:           onToggleGrid={() => setShowGridLines(!showGridLines)}\n290:           onSetMode={setInteractionMode}\n291:           onSetGridPreset={setGridPreset}\n292:           onToggleSettings={handleToggleSettings}\n293:         />\n294:       )}\n295: \n296:       <div style={{ display: 'flex', justifyContent: 'center' }}>\n297:         <GridInteraction\n298:           grid={grid}\n299:           flux={flux}\n300:           phase={phaseState.current}\n301:           showGridLines={showGridLines}\n302:           onGridChange={handleGridChange}\n303:           onFluxChange={handleFluxChange}\n304:           interactionMode={interactionMode}\n305:         />\n306:       </div>\n307:     </div>\n308:   )\n309: }\n310: \n\n(End of file - total 310 lines)\n</content>","title":"src/components/Game.tsx","metadata":{"preview":"import { useState, useCallback, useEffect, useRef } from 'react'\nimport { createGrid, GRID_SIZE_PRESETS, type GridSizePreset } from '../lib/simulation'\nimport {\n  type GridType,\n  type FluxState,\n  type InteractionMode,\n  type TrackedCluster,\n  type ExpertSettings,\n  type LevelProgression,\n} from '../types'\nimport { createInitialFluxState } from '../lib/flux'\nimport { GridInteraction } from './GridInteraction'\nimport { usePhaseTimer } from '../hooks/usePhaseTimer'\nimport { useTransition } from '../hooks/useTransition'\nimport { stepSimulation, CONWAY_RULES } from '../lib/simulation'\nimport { findConnectedComponents, trackClusters } from '../lib/movement'\nimport { createInitialScoreState, updateScore, calculateGenerationScore } from '../lib/scoring'\nimport { ScoreDisplay } from './ScoreDisplay'\nimport { GlassHUD } from './GlassHUD'\nimport { SettingsPanel } from './SettingsPanel'","truncated":false,"loaded":[]},"time":{"start":1771183232823,"end":1771183232838}}}}
{"type":"tool_use","timestamp":1771183232842,"sessionID":"ses_39d430eecffenagK7FExfhPqyr","part":{"id":"prt_c62bf5738001zqss9M7hLVQ2mn","sessionID":"ses_39d430eecffenagK7FExfhPqyr","messageID":"msg_c62bf20a7001w3cPZHEORiIzrx","type":"tool","callID":"call_11314735a2de4cfa9e3ba871","tool":"read","state":{"status":"completed","input":{"filePath":"/home/ochanomizu/repos/game_of_life/src/lib/audio.ts"},"output":"<path>/home/ochanomizu/repos/game_of_life/src/lib/audio.ts</path>\n<type>file</type>\n<content>1: import type { AudioParams } from '../types'\n2: \n3: export function createInitialAudioParams(): AudioParams {\n4:   return {\n5:     enabled: false,\n6:     volume: 0.1,\n7:     waveform: 'sine',\n8:   }\n9: }\n10: \n11: export function validateAudioParams(params: AudioParams): boolean {\n12:   if (typeof params.enabled !== 'boolean') return false\n13:   if (typeof params.volume !== 'number') return false\n14:   if (params.volume < 0 || params.volume > 0.5) return false\n15:   if (!['sine', 'triangle', 'square', 'sawtooth'].includes(params.waveform)) {\n16:     return false\n17:   }\n18:   return true\n19: }\n20: \n21: export class SoundEngine {\n22:   private audioContext: AudioContext | null = null\n23:   private enabled: boolean = false\n24:   private volume: number = 0.1\n25:   private waveform: OscillatorType = 'sine'\n26:   private readonly FREQUENCY_RANGE = 880\n27:   private readonly DRAW_FREQUENCY = 880\n28:   private readonly ERASE_FREQUENCY = 440\n29: \n30:   setEnabled(enabled: boolean): void {\n31:     this.enabled = enabled\n32:   }\n33: \n34:   setVolume(volume: number): void {\n35:     this.volume = volume\n36:   }\n37: \n38:   setWaveform(waveform: 'sine' | 'triangle' | 'square' | 'sawtooth'): void {\n39:     this.waveform = waveform\n40:   }\n41: \n42:   playGenerationSound(bornCount: number, avgRow: number, totalRows: number): void {\n43:     if (!this.enabled || bornCount <= 0) return\n44: \n45:     this.ensureAudioContext()\n46: \n47:     if (!this.audioContext) return\n48: \n49:     try {\n50:       const oscillator = this.audioContext.createOscillator()\n51:       const gainNode = this.audioContext.createGain()\n52: \n53:       const frequency = (1 - avgRow / totalRows) * this.FREQUENCY_RANGE\n54:       oscillator.frequency.value = frequency\n55:       oscillator.type = this.waveform\n56: \n57:       const volume = Math.min(this.volume * Math.sqrt(bornCount), 0.5)\n58:       gainNode.gain.setValueAtTime(0, this.audioContext.currentTime)\n59:       gainNode.gain.linearRampToValueAtTime(volume, this.audioContext.currentTime + 0.01)\n60:       gainNode.gain.exponentialRampToValueAtTime(0.001, this.audioContext.currentTime + 0.15)\n61: \n62:       oscillator.connect(gainNode)\n63:       gainNode.connect(this.audioContext.destination)\n64: \n65:       oscillator.start(this.audioContext.currentTime)\n66:       oscillator.stop(this.audioContext.currentTime + 0.15)\n67:     } catch (error) {\n68:       console.error('Error playing generation sound:', error)\n69:     }\n70:   }\n71: \n72:   playInteractionSound(type: 'draw' | 'erase'): void {\n73:     if (!this.enabled) return\n74: \n75:     this.ensureAudioContext()\n76: \n77:     if (!this.audioContext) return\n78: \n79:     try {\n80:       const oscillator = this.audioContext.createOscillator()\n81:       const gainNode = this.audioContext.createGain()\n82: \n83:       const frequency = type === 'draw' ? this.DRAW_FREQUENCY : this.ERASE_FREQUENCY\n84:       oscillator.frequency.value = frequency\n85:       oscillator.type = this.waveform\n86: \n87:       gainNode.gain.setValueAtTime(0, this.audioContext.currentTime)\n88:       gainNode.gain.linearRampToValueAtTime(this.volume, this.audioContext.currentTime + 0.005)\n89:       gainNode.gain.exponentialRampToValueAtTime(0.001, this.audioContext.currentTime + 0.05)\n90: \n91:       oscillator.connect(gainNode)\n92:       gainNode.connect(this.audioContext.destination)\n93: \n94:       oscillator.start(this.audioContext.currentTime)\n95:       oscillator.stop(this.audioContext.currentTime + 0.05)\n96:     } catch (error) {\n97:       console.error('Error playing interaction sound:', error)\n98:     }\n99:   }\n100: \n101:   private ensureAudioContext(): void {\n102:     if (!this.audioContext) {\n103:       try {\n104:         this.audioContext = new (window.AudioContext || (window as any).webkitAudioContext)()\n105:       } catch (error) {\n106:         console.error('Error creating AudioContext:', error)\n107:       }\n108:     } else if (this.audioContext.state === 'suspended') {\n109:       this.audioContext.resume().catch((error) => {\n110:         console.error('Error resuming AudioContext:', error)\n111:       })\n112:     }\n113:   }\n114: \n115:   getContextState(): AudioContextState | null {\n116:     return this.audioContext?.state ?? null\n117:   }\n118: }\n119: \n\n(End of file - total 119 lines)\n</content>","title":"src/lib/audio.ts","metadata":{"preview":"import type { AudioParams } from '../types'\n\nexport function createInitialAudioParams(): AudioParams {\n  return {\n    enabled: false,\n    volume: 0.1,\n    waveform: 'sine',\n  }\n}\n\nexport function validateAudioParams(params: AudioParams): boolean {\n  if (typeof params.enabled !== 'boolean') return false\n  if (typeof params.volume !== 'number') return false\n  if (params.volume < 0 || params.volume > 0.5) return false\n  if (!['sine', 'triangle', 'square', 'sawtooth'].includes(params.waveform)) {\n    return false\n  }\n  return true\n}\n","truncated":false,"loaded":[]},"time":{"start":1771183232826,"end":1771183232841}}}}
