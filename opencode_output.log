on}\n425:                 onChange={(e) =>\n426:                   handleUpdate('scoring.oscillatorPointsPerGeneration', parseInt(e.target.value))\n427:                 }\n428:                 className=\"settings-slider\"\n429:               />\n430:             </div>\n431:             <div className=\"settings-row\">\n432:               <label htmlFor=\"scoring-multiplier\">\n433:                 Score Multiplier: {localSettings.scoring.scoreMultiplier.toFixed(1)}x\n434:               </label>\n435:               <input\n436:                 id=\"scoring-multiplier\"\n437:                 type=\"range\"\n438:                 min=\"0.1\"\n439:                 max=\"5.0\"\n440:                 step=\"0.1\"\n441:                 value={localSettings.scoring.scoreMultiplier}\n442:                 onChange={(e) =>\n443:                   handleUpdate('scoring.scoreMultiplier', parseFloat(e.target.value))\n444:                 }\n445:                 className=\"settings-slider\"\n446:               />\n447:             </div>\n448:           </section>\n449: \n450:           <section className=\"settings-section\">\n451:             <h3>Level Generation</h3>\n452:             <div className=\"settings-row\">\n453:               <label htmlFor=\"level-time\">\n454:                 Base Time (s): {localSettings.levelGeneration.baseTimeSeconds}\n455:               </label>\n456:               <input\n457:                 id=\"level-time\"\n458:                 type=\"range\"\n459:                 min=\"10\"\n460:                 max=\"120\"\n461:                 step=\"5\"\n462:                 value={localSettings.levelGeneration.baseTimeSeconds}\n463:                 onChange={(e) =>\n464:                   handleUpdate('levelGeneration.baseTimeSeconds', parseInt(e.target.value))\n465:                 }\n466:                 className=\"settings-slider\"\n467:               />\n468:             </div>\n469:             <div className=\"settings-row\">\n470:            