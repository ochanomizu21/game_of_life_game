{"type":"tool_use","timestamp":1771218722274,"sessionID":"ses_39b28f7acffeLHlrypWKneG5Bj","part":{"id":"prt_c64dcdddb001Pa3KRcPX1WuBiz","sessionID":"ses_39b28f7acffeLHlrypWKneG5Bj","messageID":"msg_c64dcccad001LrhcFpqlXFe6Ac","type":"tool","callID":"call_b9289cea59ad480abe59f864","tool":"read","state":{"status":"completed","input":{"filePath":"/home/ochanomizu/repos/game_of_life/src/hooks/useTripleTapGesture.ts"},"output":"<path>/home/ochanomizu/repos/game_of_life/src/hooks/useTripleTapGesture.ts</path>\n<type>file</type>\n<content>1: import { useEffect, useRef } from 'react'\n2: \n3: interface TripleTapGestureOptions {\n4:   threshold?: number\n5:   maxTimeBetweenTaps?: number\n6:   onTripleTap: () => void\n7: }\n8: \n9: export function useTripleTapGesture(options: TripleTapGestureOptions) {\n10:   const { threshold = 100, maxTimeBetweenTaps = 500, onTripleTap } = options\n11: \n12:   const tapCountRef = useRef<number>(0)\n13:   const lastTapTimeRef = useRef<number>(0)\n14:   const timeoutRef = useRef<number | undefined>(undefined)\n15: \n16:   useEffect(() => {\n17:     const resetTapState = () => {\n18:       tapCountRef.current = 0\n19:       lastTapTimeRef.current = 0\n20:     }\n21: \n22:     const handleTap = () => {\n23:       const now = Date.now()\n24: \n25:       if (tapCountRef.current === 0) {\n26:         tapCountRef.current = 1\n27:         lastTapTimeRef.current = now\n28:       } else {\n29:         const timeSinceLastTap = now - lastTapTimeRef.current\n30: \n31:         if (timeSinceLastTap <= maxTimeBetweenTaps) {\n32:           tapCountRef.current++\n33:           lastTapTimeRef.current = now\n34: \n35:           if (tapCountRef.current === 3) {\n36:             onTripleTap()\n37:             resetTapState()\n38:           }\n39:         } else {\n40:           resetTapState()\n41:           tapCountRef.current = 1\n42:           lastTapTimeRef.current = now\n43:         }\n44:       }\n45: \n46:       if (timeoutRef.current) {\n47:         window.clearTimeout(timeoutRef.current)\n48:       }\n49:       timeoutRef.current = window.setTimeout(() => {\n50:         resetTapState()\n51:       }, maxTimeBetweenTaps)\n52:     }\n53: \n54:     const handleTouchStart = (e: TouchEvent) => {\n55:       const touch = e.touches[0] || e.changedTouches[0]\n56:       const clientX = touch.clientX\n57:       const clientY = touch.clientY\n58: \n59:       if (clientX < threshold && clientY < threshold) {\n60:         e.preventDefault()\n61:         handleTap()\n62:       }\n63:     }\n64: \n65:     const handleClick = (e: MouseEvent) => {\n66:       const clientX = e.clientX\n67:       const clientY = e.clientY\n68: \n69:       if (clientX < threshold && clientY < threshold) {\n70:         handleTap()\n71:       }\n72:     }\n73: \n74:     window.addEventListener('touchstart', handleTouchStart, { passive: false })\n75:     window.addEventListener('click', handleClick)\n76: \n77:     return () => {\n78:       window.removeEventListener('touchstart', handleTouchStart)\n79:       window.removeEventListener('click', handleClick)\n80:       if (timeoutRef.current) {\n81:         window.clearTimeout(timeoutRef.current)\n82:       }\n83:     }\n84:   }, [threshold, maxTimeBetweenTaps, onTripleTap])\n85: \n86:   return\n87: }\n88: \n\n(End of file - total 88 lines)\n</content>","title":"src/hooks/useTripleTapGesture.ts","metadata":{"preview":"import { useEffect, useRef } from 'react'\n\ninterface TripleTapGestureOptions {\n  threshold?: number\n  maxTimeBetweenTaps?: number\n  onTripleTap: () => void\n}\n\nexport function useTripleTapGesture(options: TripleTapGestureOptions) {\n  const { threshold = 100, maxTimeBetweenTaps = 500, onTripleTap } = options\n\n  const tapCountRef = useRef<number>(0)\n  const lastTapTimeRef = useRef<number>(0)\n  const timeoutRef = useRef<number | undefined>(undefined)\n\n  useEffect(() => {\n    const resetTapState = () => {\n      tapCountRef.current = 0\n      lastTapTimeRef.current = 0\n    }","truncated":false,"loaded":[]},"time":{"start":1771218722269,"end":1771218722272}}}}
