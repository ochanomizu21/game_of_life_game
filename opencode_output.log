{"type":"tool_use","timestamp":1771215574159,"sessionID":"ses_39b55e9f8fferWn8zBs1ZJmQ6V","part":{"id":"prt_c64acd47e001n6cif3t52gU0fe","sessionID":"ses_39b55e9f8fferWn8zBs1ZJmQ6V","messageID":"msg_c64acb851001fun5IPZD2g9FbO","type":"tool","callID":"call_47f226eda83d47368523c759","tool":"read","state":{"status":"completed","input":{"filePath":"/home/ochanomizu/repos/game_of_life/src/components/SettingsPanel.tsx"},"output":"<path>/home/ochanomizu/repos/game_of_life/src/components/SettingsPanel.tsx</path>\n<type>file</type>\n<content>1: import { useState } from 'react'\n2: import type { ExpertSettings } from '../types'\n3: import '../styles/SettingsPanel.css'\n4: \n5: interface ValidationResult {\n6:   valid: boolean\n7:   errors: string[]\n8: }\n9: \n10: function validateExpertSettingsDetailed(settings: unknown): ValidationResult {\n11:   const errors: string[] = []\n12: \n13:   if (typeof settings !== 'object' || settings === null) {\n14:     return { valid: false, errors: ['Invalid settings object'] }\n15:   }\n16: \n17:   const s = settings as ExpertSettings\n18: \n19:   if (!s.movementDetection || typeof s.movementDetection !== 'object') {\n20:     errors.push('Invalid movement detection settings')\n21:   } else {\n22:     if (typeof s.movementDetection.centroidHistoryLength !== 'number') {\n23:       errors.push('centroidHistoryLength must be a number')\n24:     } else if (\n25:       s.movementDetection.centroidHistoryLength < 3 ||\n26:       s.movementDetection.centroidHistoryLength > 10\n27:     ) {\n28:       errors.push('centroidHistoryLength must be between 3 and 10')\n29:     }\n30: \n31:     if (typeof s.movementDetection.movementThreshold !== 'number') {\n32:       errors.push('movementThreshold must be a number')\n33:     } else if (\n34:       s.movementDetection.movementThreshold < 0.1 ||\n35:       s.movementDetection.movementThreshold > 2.0\n36:     ) {\n37:       errors.push('movementThreshold must be between 0.1 and 2.0')\n38:     }\n39: \n40:     if (typeof s.movementDetection.minClusterSize !== 'number') {\n41:       errors.push('minClusterSize must be a number')\n42:     } else if (s.movementDetection.minClusterSize < 1 || s.movementDetection.minClusterSize > 5) {\n43:       errors.push('minClusterSize must be between 1 and 5')\n44:     }\n45:   }\n46: \n47:   if (!s.scoring || typeof s.scoring !== 'object') {\n48:     errors.push('Invalid scoring settings')\n49:   } else {\n50:     if (typeof s.scoring.moverPointsPerGeneration !== 'number') {\n51:       errors.push('moverPointsPerGeneration must be a number')\n52:     } else if (s.scoring.moverPointsPerGeneration < 1 || s.scoring.moverPointsPerGeneration > 100) {\n53:       errors.push('moverPointsPerGeneration must be between 1 and 100')\n54:     }\n55: \n56:     if (typeof s.scoring.oscillatorPointsPerGeneration !== 'number') {\n57:       errors.push('oscillatorPointsPerGeneration must be a number')\n58:     } else if (\n59:       s.scoring.oscillatorPointsPerGeneration < 0 ||\n60:       s.scoring.oscillatorPointsPerGeneration > 20\n61:     ) {\n62:       errors.push('oscillatorPointsPerGeneration must be between 0 and 20')\n63:     }\n64: \n65:     if (typeof s.scoring.scoreMultiplier !== 'number') {\n66:       errors.push('scoreMultiplier must be a number')\n67:     } else if (s.scoring.scoreMultiplier < 0.1 || s.scoring.scoreMultiplier > 5.0) {\n68:       errors.push('scoreMultiplier must be between 0.1 and 5.0')\n69:     }\n70:   }\n71: \n72:   if (!s.levelGeneration || typeof s.levelGeneration !== 'object') {\n73:     errors.push('Invalid level generation settings')\n74:   } else {\n75:     if (typeof s.levelGeneration.baseTimeSeconds !== 'number') {\n76:       errors.push('baseTimeSeconds must be a number')\n77:     } else if (s.levelGeneration.baseTimeSeconds < 10 || s.levelGeneration.baseTimeSeconds > 120) {\n78:       errors.push('baseTimeSeconds must be between 10 and 120')\n79:     }\n80: \n81:     if (typeof s.levelGeneration.timeIncrementPerLevel !== 'number') {\n82:       errors.push('timeIncrementPerLevel must be a number')\n83:     } else if (\n84:       s.levelGeneration.timeIncrementPerLevel < 0 ||\n85:       s.levelGeneration.timeIncrementPerLevel > 60\n86:     ) {\n87:       errors.push('timeIncrementPerLevel must be between 0 and 60')\n88:     }\n89: \n90:     if (typeof s.levelGeneration.baseFlux !== 'number') {\n91:       errors.push('baseFlux must be a number')\n92:     } else if (s.levelGeneration.baseFlux < 5 || s.levelGeneration.baseFlux > 50) {\n93:       errors.push('baseFlux must be between 5 and 50')\n94:     }\n95: \n96:     if (\n97:       !['TIME_ONLY', 'RESOURCE_ONLY', 'MIXED', 'EXTREME'].includes(\n98:         s.levelGeneration.difficultyScalingMode\n99:       )\n100:     ) {\n101:       errors.push('difficultyScalingMode must be one of: TIME_ONLY, RESOURCE_ONLY, MIXED, EXTREME')\n102:     }\n103:   }\n104: \n105:   if (!s.gridSizing || typeof s.gridSizing !== 'object') {\n106:     errors.push('Invalid grid sizing settings')\n107:   } else {\n108:     if (typeof s.gridSizing.mobileCellSize !== 'number') {\n109:       errors.push('mobileCellSize must be a number')\n110:     } else if (s.gridSizing.mobileCellSize < 14 || s.gridSizing.mobileCellSize > 24) {\n111:       errors.push('mobileCellSize must be between 14 and 24')\n112:     }\n113: \n114:     if (typeof s.gridSizing.desktopCellSize !== 'number') {\n115:       errors.push('desktopCellSize must be a number')\n116:     } else if (s.gridSizing.desktopCellSize < 16 || s.gridSizing.desktopCellSize > 28) {\n117:       errors.push('desktopCellSize must be between 16 and 28')\n118:     }\n119: \n120:     if (typeof s.gridSizing.minVisibleCells !== 'number') {\n121:       errors.push('minVisibleCells must be a number')\n122:     } else if (s.gridSizing.minVisibleCells < 1) {\n123:       errors.push('minVisibleCells must be at least 1')\n124:     }\n125:   }\n126: \n127:   if (!s.audio || typeof s.audio !== 'object') {\n128:     errors.push('Invalid audio settings')\n129:   } else {\n130:     if (typeof s.audio.enabled !== 'boolean') {\n131:       errors.push('audio.enabled must be a boolean')\n132:     }\n133: \n134:     if (typeof s.audio.volume !== 'number') {\n135:       errors.push('audio.volume must be a number')\n136:     } else if (s.audio.volume < 0 || s.audio.volume > 0.5) {\n137:       errors.push('audio.volume must be between 0 and 0.5')\n138:     }\n139: \n140:     if (!['sine', 'triangle', 'square', 'sawtooth'].includes(s.audio.waveform)) {\n141:       errors.push('audio.waveform must be one of: sine, triangle, square, sawtooth')\n142:     }\n143:   }\n144: \n145:   return {\n146:     valid: errors.length === 0,\n147:     errors,\n148:   }\n149: }\n150: \n151: interface SettingsPanelProps {\n152:   isOpen: boolean\n153:   settings: ExpertSettings\n154:   onClose: () => void\n155:   onUpdateSettings: (settings: ExpertSettings) => void\n156: }\n157: \n158: export function SettingsPanel({ isOpen, settings, onClose, onUpdateSettings }: SettingsPanelProps) {\n159:   const [localSettings, setLocalSettings] = useState(settings)\n160:   const [importError, setImportError] = useState<string>('')\n161: \n162:   const handleExport = () => {\n163:     const dataStr = JSON.stringify(localSettings, null, 2)\n164:     const dataBlob = new Blob([dataStr], { type: 'application/json' })\n165:     const url = URL.createObjectURL(dataBlob)\n166:     const link = document.createElement('a')\n167:     link.href = url\n168:     link.download = 'gol-expert-settings.json'\n169:     document.body.appendChild(link)\n170:     link.click()\n171:     document.body.removeChild(link)\n172:     URL.revokeObjectURL(url)\n173:   }\n174: \n175:   const handleImport = (e: React.ChangeEvent<HTMLInputElement>) => {\n176:     const file = e.target.files?.[0]\n177:     if (!file) return\n178: \n179:     const reader = new FileReader()\n180:     reader.onload = (event) => {\n181:       try {\n182:         const json = JSON.parse(event.target?.result as string)\n183:         const validation = validateExpertSettingsDetailed(json)\n184:         if (validation.valid) {\n185:           setLocalSettings(json as ExpertSettings)\n186:           setImportError('')\n187:         } else {\n188:           setImportError(`Invalid settings: ${validation.errors.join(', ')}`)\n189:         }\n190:       } catch (error) {\n191:         setImportError('Failed to parse JSON file')\n192:       }\n193:     }\n194:     reader.readAsText(file)\n195:   }\n196: \n197:   const handleUpdate = (path: string, value: any) => {\n198:     const newSettings = { ...localSettings }\n199:     const keys = path.split('.')\n200:     let target: any = newSettings\n201: \n202:     for (let i = 0; i < keys.length - 1; i++) {\n203:       target = target[keys[i]]\n204:     }\n205: \n206:     target[keys[keys.length - 1]] = value\n207:     setLocalSettings(newSettings)\n208:   }\n209: \n210:   const handleSave = () => {\n211:     onUpdateSettings(localSettings)\n212:     onClose()\n213:   }\n214: \n215:   const handleReset = () => {\n216:     const defaultSettings = {\n217:       movementDetection: {\n218:         centroidHistoryLength: 5,\n219:         movementThreshold: 0.5,\n220:         minClusterSize: 1,\n221:       },\n222:       scoring: {\n223:         moverPointsPerGeneration: 10,\n224:         oscillatorPointsPerGeneration: 2,\n225:         scoreMultiplier: 1.0,\n226:       },\n227:       levelGeneration: {\n228:         baseTimeSeconds: 45,\n229:         timeIncrementPerLevel: 15,\n230:         baseFlux: 20,\n231:         difficultyScalingMode: 'TIME_ONLY' as const,\n232:       },\n233:       gridSizing: {\n234:         mobileCellSize: 18,\n235:         desktopCellSize: 20,\n236:         minVisibleCells: 10,\n237:       },\n238:       audio: {\n239:         enabled: false,\n240:         volume: 0.1,\n241:         waveform: 'sine' as const,\n242:       },\n243:     }\n244:     setLocalSettings(defaultSettings)\n245:   }\n246: \n247:   if (!isOpen) return null\n248: \n249:   return (\n250:     <div className=\"settings-overlay\" onClick={onClose}>\n251:       <div className=\"settings-panel\" onClick={(e) => e.stopPropagation()}>\n252:         <div className=\"settings-header\">\n253:           <h2>Settings</h2>\n254:           <button className=\"close-button\" onClick={onClose}>\n255:             ×\n256:           </button>\n257:         </div>\n258: \n259:         <div className=\"settings-content\">\n260:           <section className=\"settings-section\">\n261:             <h3>Audio</h3>\n262:             <div className=\"settings-row\">\n263:               <label htmlFor=\"audio-enabled\">\n264:                 <input\n265:                   id=\"audio-enabled\"\n266:                   type=\"checkbox\"\n267:                   checked={localSettings.audio.enabled}\n268:                   onChange={(e) => handleUpdate('audio.enabled', e.target.checked)}\n269:                 />\n270:                 Enable Sonification\n271:               </label>\n272:             </div>\n273:             <div className=\"settings-row\">\n274:               <label htmlFor=\"audio-volume\">\n275:                 Volume: {(localSettings.audio.volume * 100).toFixed(0)}%\n276:               </label>\n277:               <input\n278:                 id=\"audio-volume\"\n279:                 type=\"range\"\n280:                 min=\"0\"\n281:                 max=\"0.5\"\n282:                 step=\"0.01\"\n283:                 value={localSettings.audio.volume}\n284:                 onChange={(e) => handleUpdate('audio.volume', parseFloat(e.target.value))}\n285:                 className=\"settings-slider\"\n286:               />\n287:             </div>\n288:             <div className=\"settings-row\">\n289:               <label htmlFor=\"audio-waveform\">Waveform</label>\n290:               <select\n291:                 id=\"audio-waveform\"\n292:                 value={localSettings.audio.waveform}\n293:                 onChange={(e) =>\n294:                   handleUpdate(\n295:                     'audio.waveform',\n296:                     e.target.value as 'sine' | 'triangle' | 'square' | 'sawtooth'\n297:                   )\n298:                 }\n299:                 className=\"settings-select\"\n300:               >\n301:                 <option value=\"sine\">Sine</option>\n302:                 <option value=\"triangle\">Triangle</option>\n303:                 <option value=\"square\">Square</option>\n304:                 <option value=\"sawtooth\">Sawtooth</option>\n305:               </select>\n306:             </div>\n307:           </section>\n308: \n309:           <section className=\"settings-section\">\n310:             <h3>Movement Detection</h3>\n311:             <div className=\"settings-row\">\n312:               <label htmlFor=\"movement-history\">\n313:                 Centroid History Length: {localSettings.movementDetection.centroidHistoryLength}\n314:               </label>\n315:               <input\n316:                 id=\"movement-history\"\n317:                 type=\"range\"\n318:                 min=\"3\"\n319:                 max=\"10\"\n320:                 step=\"1\"\n321:                 value={localSettings.movementDetection.centroidHistoryLength}\n322:                 onChange={(e) =>\n323:                   handleUpdate('movementDetection.centroidHistoryLength', parseInt(e.target.value))\n324:                 }\n325:                 className=\"settings-slider\"\n326:               />\n327:             </div>\n328:             <div className=\"settings-row\">\n329:               <label htmlFor=\"movement-threshold\">\n330:                 Movement Threshold: {localSettings.movementDetection.movementThreshold.toFixed(1)}\n331:               </label>\n332:               <input\n333:                 id=\"movement-threshold\"\n334:                 type=\"range\"\n335:                 min=\"0.1\"\n336:                 max=\"2.0\"\n337:                 step=\"0.1\"\n338:                 value={localSettings.movementDetection.movementThreshold}\n339:                 onChange={(e) =>\n340:                   handleUpdate('movementDetection.movementThreshold', parseFloat(e.target.value))\n341:                 }\n342:                 className=\"settings-slider\"\n343:               />\n344:             </div>\n345:             <div className=\"settings-row\">\n346:               <label htmlFor=\"movement-min-size\">\n347:                 Minimum Cluster Size: {localSettings.movementDetection.minClusterSize}\n348:               </label>\n349:               <input\n350:                 id=\"movement-min-size\"\n351:                 type=\"range\"\n352:                 min=\"1\"\n353:                 max=\"5\"\n354:                 step=\"1\"\n355:                 value={localSettings.movementDetection.minClusterSize}\n356:                 onChange={(e) =>\n357:                   handleUpdate('movementDetection.minClusterSize', parseInt(e.target.value))\n358:                 }\n359:                 className=\"settings-slider\"\n360:               />\n361:             </div>\n362:           </section>\n363: \n364:           <section className=\"settings-section\">\n365:             <h3>Scoring</h3>\n366:             <div className=\"settings-row\">\n367:               <label htmlFor=\"scoring-mover\">\n368:                 Mover Points/Gen: {localSettings.scoring.moverPointsPerGeneration}\n369:               </label>\n370:               <input\n371:                 id=\"scoring-mover\"\n372:                 type=\"range\"\n373:                 min=\"1\"\n374:                 max=\"100\"\n375:                 step=\"1\"\n376:                 value={localSettings.scoring.moverPointsPerGeneration}\n377:                 onChange={(e) =>\n378:                   handleUpdate('scoring.moverPointsPerGeneration', parseInt(e.target.value))\n379:                 }\n380:                 className=\"settings-slider\"\n381:               />\n382:             </div>\n383:             <div className=\"settings-row\">\n384:               <label htmlFor=\"scoring-oscillator\">\n385:                 Oscillator Points/Gen: {localSettings.scoring.oscillatorPointsPerGeneration}\n386:               </label>\n387:               <input\n388:                 id=\"scoring-oscillator\"\n389:                 type=\"range\"\n390:                 min=\"0\"\n391:                 max=\"20\"\n392:                 step=\"1\"\n393:                 value={localSettings.scoring.oscillatorPointsPerGeneration}\n394:                 onChange={(e) =>\n395:                   handleUpdate('scoring.oscillatorPointsPerGeneration', parseInt(e.target.value))\n396:                 }\n397:                 className=\"settings-slider\"\n398:               />\n399:             </div>\n400:             <div className=\"settings-row\">\n401:               <label htmlFor=\"scoring-multiplier\">\n402:                 Score Multiplier: {localSettings.scoring.scoreMultiplier.toFixed(1)}x\n403:               </label>\n404:               <input\n405:                 id=\"scoring-multiplier\"\n406:                 type=\"range\"\n407:                 min=\"0.1\"\n408:                 max=\"5.0\"\n409:                 step=\"0.1\"\n410:                 value={localSettings.scoring.scoreMultiplier}\n411:                 onChange={(e) =>\n412:                   handleUpdate('scoring.scoreMultiplier', parseFloat(e.target.value))\n413:                 }\n414:                 className=\"settings-slider\"\n415:               />\n416:             </div>\n417:           </section>\n418: \n419:           <section className=\"settings-section\">\n420:             <h3>Level Generation</h3>\n421:             <div className=\"settings-row\">\n422:               <label htmlFor=\"level-time\">\n423:                 Base Time (s): {localSettings.levelGeneration.baseTimeSeconds}\n424:               </label>\n425:               <input\n426:                 id=\"level-time\"\n427:                 type=\"range\"\n428:                 min=\"10\"\n429:                 max=\"120\"\n430:                 step=\"5\"\n431:                 value={localSettings.levelGeneration.baseTimeSeconds}\n432:                 onChange={(e) =>\n433:                   handleUpdate('levelGeneration.baseTimeSeconds', parseInt(e.target.value))\n434:                 }\n435:                 className=\"settings-slider\"\n436:               />\n437:             </div>\n438:             <div className=\"settings-row\">\n439:               <label htmlFor=\"level-increment\">\n440:                 Time Increment/Level (s): {localSettings.levelGeneration.timeIncrementPerLevel}\n441:               </label>\n442:               <input\n443:                 id=\"level-increment\"\n444:                 type=\"range\"\n445:                 min=\"0\"\n446:                 max=\"60\"\n447:                 step=\"5\"\n448:                 value={localSettings.levelGeneration.timeIncrementPerLevel}\n449:                 onChange={(e) =>\n450:                   handleUpdate('levelGeneration.timeIncrementPerLevel', parseInt(e.target.value))\n451:                 }\n452:                 className=\"settings-slider\"\n453:               />\n454:             </div>\n455:             <div className=\"settings-row\">\n456:               <label htmlFor=\"level-flux\">\n457:                 Base Flux: {localSettings.levelGeneration.baseFlux}\n458:               </label>\n459:               <input\n460:                 id=\"level-flux\"\n461:                 type=\"range\"\n462:                 min=\"5\"\n463:                 max=\"50\"\n464:                 step=\"5\"\n465:                 value={localSettings.levelGeneration.baseFlux}\n466:                 onChange={(e) => handleUpdate('levelGeneration.baseFlux', parseInt(e.target.value))}\n467:                 className=\"settings-slider\"\n468:               />\n469:             </div>\n470:             <div className=\"settings-row\">\n471:               <label htmlFor=\"level-difficulty\">Difficulty Mode</label>\n472:               <select\n473:                 id=\"level-difficulty\"\n474:                 value={localSettings.levelGeneration.difficultyScalingMode}\n475:                 onChange={(e) =>\n476:                   handleUpdate(\n477:                     'levelGeneration.difficultyScalingMode',\n478:                     e.target.value as 'TIME_ONLY' | 'RESOURCE_ONLY' | 'MIXED' | 'EXTREME'\n479:                   )\n480:                 }\n481:                 className=\"settings-select\"\n482:               >\n483:                 <option value=\"TIME_ONLY\">Time Only</option>\n484:                 <option value=\"RESOURCE_ONLY\">Resource Only</option>\n485:                 <option value=\"MIXED\">Mixed</option>\n486:                 <option value=\"EXTREME\">Extreme</option>\n487:               </select>\n488:             </div>\n489:           </section>\n490: \n491:           <section className=\"settings-section\">\n492:             <h3>Grid Sizing</h3>\n493:             <div className=\"settings-row\">\n494:               <label htmlFor=\"grid-mobile\">\n495:                 Mobile Cell Size (px): {localSettings.gridSizing.mobileCellSize}\n496:               </label>\n497:               <input\n498:                 id=\"grid-mobile\"\n499:                 type=\"range\"\n500:                 min=\"14\"\n501:                 max=\"24\"\n502:                 step=\"2\"\n503:                 value={localSettings.gridSizing.mobileCellSize}\n504:                 onChange={(e) =>\n505:                   handleUpdate('gridSizing.mobileCellSize', parseInt(e.target.value))\n506:                 }\n507:                 className=\"settings-slider\"\n508:               />\n509:             </div>\n510:             <div className=\"settings-row\">\n511:               <label htmlFor=\"grid-desktop\">\n512:                 Desktop Cell Size (px): {localSettings.gridSizing.desktopCellSize}\n513:               </label>\n514:               <input\n515:                 id=\"grid-desktop\"\n516:                 type=\"range\"\n517:                 min=\"16\"\n518:                 max=\"28\"\n519:                 step=\"2\"\n520:                 value={localSettings.gridSizing.desktopCellSize}\n521:                 onChange={(e) =>\n522:                   handleUpdate('gridSizing.desktopCellSize', parseInt(e.target.value))\n523:                 }\n524:                 className=\"settings-slider\"\n525:               />\n526:             </div>\n527:           </section>\n528:         </div>\n529: \n530:         <div className=\"settings-footer\">\n531:           <button className=\"settings-button secondary\" onClick={handleReset}>\n532:             Reset to Defaults\n533:           </button>\n534:           <button className=\"settings-button secondary\" onClick={handleExport}>\n535:             Export JSON\n536:           </button>\n537:           <button\n538:             className=\"settings-button secondary\"\n539:             onClick={() => document.getElementById('import-file-input')?.click()}\n540:           >\n541:             Import JSON\n542:           </button>\n543:           <input\n544:             id=\"import-file-input\"\n545:             type=\"file\"\n546:             accept=\".json\"\n547:             style={{ display: 'none' }}\n548:             onChange={handleImport}\n549:           />\n550:           <button className=\"settings-button primary\" onClick={handleSave}>\n551:             Save Settings\n552:           </button>\n553:           {importError && <div className=\"settings-error\">{importError}</div>}\n554:         </div>\n555:       </div>\n556:     </div>\n557:   )\n558: }\n559: \n\n(End of file - total 559 lines)\n</content>","title":"src/components/SettingsPanel.tsx","metadata":{"preview":"import { useState } from 'react'\nimport type { ExpertSettings } from '../ty