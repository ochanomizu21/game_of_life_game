26:   }\n127: \n128:   if (!s.audio || typeof s.audio !== 'object') {\n129:     errors.push('Invalid audio settings')\n130:   } else {\n131:     if (typeof s.audio.enabled !== 'boolean') {\n132:       errors.push('audio.enabled must be a boolean')\n133:     }\n134: \n135:     if (typeof s.audio.volume !== 'number') {\n136:       errors.push('audio.volume must be a number')\n137:     } else if (s.audio.volume < 0 || s.audio.volume > 0.5) {\n138:       errors.push('audio.volume must be between 0 and 0.5')\n139:     }\n140: \n141:     if (!['sine', 'triangle', 'square', 'sawtooth'].includes(s.audio.waveform)) {\n142:       errors.push('audio.waveform must be one of: sine, triangle, square, sawtooth')\n143:     }\n144:   }\n145: \n146:   return {\n147:     valid: errors.length === 0,\n148:     errors,\n149:   }\n150: }\n151: \n152: interface SettingsPanelProps {\n153:   isOpen: boolean\n154:   settings: ExpertSettings\n155:   onClose: () => void\n156:   onUpdateSettings: (settings: ExpertSettings) => void\n157: }\n158: \n159: export function SettingsPanel({ isOpen, settings, onClose, onUpdateSettings }: SettingsPanelProps) {\n160:   const [localSettings, setLocalSettings] = useState(settings)\n161:   const [importError, setImportError] = useState<string>('')\n162: \n163:   const handleExport = () => {\n164:     const dataStr = JSON.stringify(localSettings, null, 2)\n165:     const dataBlob = new Blob([dataStr], { type: 'application/json' })\n166:     const url = URL.createObjectURL(dataBlob)\n167:     const link = document.createElement('a')\n168:     link.href = url\n169:     link.download = 'gol-expert-settings.json'\n170:     document.body.appendChild(link)\n171:     link.click()\n172:     document.body.removeChild(link)\n173:     URL.revokeObjectURL(url)\n174:   }\n175: \n176:   const handleImport = (e: React.ChangeEvent<HTMLInputElement>) => {\n177:     const file = e.target.files?.[0]\n178:     if (!file) return\n179: \n180:     const reader = new FileReader()\n181:     reader.onload = (event) => {\n182:       try {\n183:         const json = JSON.parse(event.target?.result as string)\n184:         const validation = validateExpertSettingsDetailed(json)\n185:         if (validation.valid) {\n186:           setLocalSettings(json as ExpertSettings)\n187:           setImportError('')\n188:         } else {\n189:           setImportError(`Invalid settings: ${validation.errors.join(', ')}`)\n190:         }\n191:       } catch (error) {\n192:         setImportError('Failed to parse JSON file')\n193:       }\n194:     }\n195:     reader.readAsText(file)\n196:   }\n197: \n198:   const handleUpdate = (path: string, value: any) => {\n199:     const newSettings = { ...localSettings }\n200:     const keys = path.split('.')\n201:     let target: any = newSettings\n202: \n203:     for (let i = 0; i < keys.length - 1; i++) {\n204:       target = target[keys[i]]\n205:     }\n206: \n207:     target[keys[keys.length - 1]] = value\n208: \n209:     const updatedSettings: ExpertSettings = {\n210:       ...newSettings,\n211:       preset: undefined,\n212:     }\n213:     setLocalSettings(updatedSettings)\n214:   }\n215: \n216:   const handlePresetChange = (preset: Preset) => {\n217:     const presetSettings = applyPreset(preset)\n218:     setLocalSettings(presetSettings)\n219:   }\n220: \n221:   const handleSave = () => {\n222:     onUpdateSettings(localSettings)\n223:     onClose()\n224:   }\n225: \n226:   const handleReset = () => {\n227:     const defaultSettings = {\n228:       movementDetection: {\n229:         centroidHistoryLength: 5,\n230:         movementThreshold: 0.5,\n231:         minClusterSize: 1,\n232:       },\n233:       scoring: {\n234:         moverPointsPerGeneration: 10,\n235:         oscillatorPointsPerGeneration: 2,\n236:         scoreMultiplier: 1.0,\n237:       },\n238:       levelGeneration: {\n239:         baseTimeSeconds: 45,\n240:         timeIncrementPerLevel: 15,\n241:         baseFlux: 20,\n242:         difficultyS