{"type":"tool_use","timestamp":1771217896310,"sessionID":"ses_39b33d733ffe2qC1Fb1brs4w5Q","part":{"id":"prt_c64d0365e001htsBR05CQixmMI","sessionID":"ses_39b33d733ffe2qC1Fb1brs4w5Q","messageID":"msg_c64d00851001X9Y7oK2HFrBm36","type":"tool","callID":"call_2d966a0557664efaa1ec1981","tool":"write","state":{"status":"completed","input":{"content":"import { describe, it, expect, vi } from 'vitest'\nimport { render, screen } from '@testing-library/react'\nimport userEvent from '@testing-library/user-event'\nimport ErrorBoundary from './ErrorBoundary'\n\ndescribe('ErrorBoundary', () => {\n  it('should render children when no error occurs', () => {\n    const ChildComponent = () => <div data-testid=\"child\">Child Component</div>\n\n    render(\n      <ErrorBoundary>\n        <ChildComponent />\n      </ErrorBoundary>\n    )\n\n    expect(screen.getByTestId('child')).toBeInTheDocument()\n  })\n\n  it('should catch errors and display error UI', () => {\n    const ThrowError = () => {\n      throw new Error('Test error')\n    }\n\n    const consoleErrorSpy = vi.spyOn(console, 'error').mockImplementation(() => {})\n\n    render(\n      <ErrorBoundary>\n        <ThrowError />\n      </ErrorBoundary>\n    )\n\n    expect(screen.getByText('Something went wrong')).toBeInTheDocument()\n    expect(\n      screen.getByText('The application encountered an unexpected error. Please try refreshing the page.')\n    ).toBeInTheDocument()\n    expect(screen.getByRole('button', { name: /reload page/i })).toBeInTheDocument()\n\n    consoleErrorSpy.mockRestore()\n  })\n\n  it('should display error details in development mode', () => {\n    const ThrowError = () => {\n      throw new Error('Test error')\n    }\n\n    const consoleErrorSpy = vi.spyOn(console, 'error').mockImplementation(() => {})\n\n    const originalEnv = import.meta.env.DEV\n\n    Object.defineProperty(import.meta, 'env', {\n      value: { DEV: true },\n      configurable: true,\n    })\n\n    render(\n      <ErrorBoundary>\n        <ThrowError />\n      </ErrorBoundary>\n    )\n\n    const details = screen.getByText(/error details \\(development only\\)/i)\n    expect(details).toBeInTheDocument()\n\n    consoleErrorSpy.mockRestore()\n\n    Object.defineProperty(import.meta, 'env', {\n      value: { DEV: originalEnv },\n      configurable: true,\n    })\n  })\n\n  it('should not display error details in production mode', () => {\n    const ThrowError = () => {\n      throw new Error('Test error')\n    }\n\n    const consoleErrorSpy = vi.spyOn(console, 'error').mockImplementation(() => {})\n\n    const originalEnv = import.meta.env.DEV\n\n    Object.defineProperty(import.meta, 'env', {\n      value: { DEV: false },\n      configurable: true,\n    })\n\n    render(\n      <ErrorBoundary>\n        <ThrowError />\n      </ErrorBoundary>\n    )\n\n    expect(screen.queryByText(/error details/i)).not.toBeInTheDocument()\n\n    consoleErrorSpy.mockRestore()\n\n    Object.defineProperty(import.meta, 'env', {\n      value: { DEV: originalEnv },\n      configurable: true,\n    })\n  })\n\n  it('should reload page when reload button is clicked', async () => {\n    const ThrowError = () => {\n      throw new Error('Test error')\n    }\n\n    const consoleErrorSpy = vi.spyOn(console, 'error').mockImplementation(() => {})\n    const reloadSpy = vi.spyOn(window.location, 'reload').mockImplementation(() => {})\n\n    const user = userEvent.setup()\n\n    render(\n      <ErrorBoundary>\n        <ThrowError />\n      </ErrorBoundary>\n    )\n\n    const reloadButton = screen.getByRole('button', { name: /reload page/i })\n    await user.click(reloadButton)\n\n    expect(reloadSpy).toHaveBeenCalledTimes(1)\n\n    consoleErrorSpy.mockRestore()\n    reloadSpy.mockRestore()\n  })\n\n  it('should log error and component stack to console', () => {\n    const ThrowError = () => {\n      throw new Error('Test error')\n    }\n\n    const consoleErrorSpy = vi.spyOn(console, 'error').mockImplementation(() => {})\n\n    render(\n      <ErrorBoundary>\n        <ThrowError />\n      </ErrorBoundary>\n    )\n\n    expect(consoleErrorSpy).toHaveBeenCalledWith('Error caught by ErrorBoundary:', expect.any(Error))\n    expect(consoleErrorSpy).toHaveBeenCalledWith('Component stack:', expect.any(String))\n\n    consoleErrorSpy.mockRestore()\n  })\n})\n","filePath":"/home/ochanomizu/repos/game_of_life/src/components/ErrorBoundary.test.tsx"},"output":"Wrote file successfully.","title":"src/components/ErrorBoundary.test.tsx","metadata":{"diagnostics":{"/home/ochanomizu/repos/game_of_life/src/lib/presets.ts":[],"/home/ochanomizu/repos/game_of_life/src/components/SettingsPanel.tsx":[],"/home/ochanomizu/repos/game_of_life/src/App.tsx":[],"/home/ochanomizu/repos/game_of_life/src/components/UIToggleButton.tsx":[],"/home/ochanomizu/repos/game_of_life/src/components/IntroOverlay.tsx":[],"/home/ochanomizu/repos/game_of_life/src/lib/validation.ts":[],"/home/ochanomizu/repos/game_of_life/src/main.tsx":[],"/home/ochanomizu/repos/game_of_life/src/types/index.ts":[],"/home/ochanomizu/repos/game_of_life/src/components/Game.tsx":[],"/home/ochanomizu/repos/game_of_life/src/components/CanvasGrid.tsx":[],"/home/ochanomizu/repos/game_of_life/src/lib/state.ts":[],"/home/ochanomizu/repos/game_of_life/src/components/TransitionOverlay.tsx":[],"/home/ochanomizu/repos/game_of_life/src/components/GlassHUD.tsx":[],"/home/ochanomizu/repos/game_of_life/src/components/VictoryScreen.tsx":[],"/home/ochanomizu/repos/game_of_life/src/components/GridInteraction.tsx":[],"/home/ochanomizu/repos/game_of_life/src/hooks/useTransition.ts":[],"/home/ochanomizu/repos/game_of_life/src/lib/settings.ts":[],"/home/ochanomizu/repos/game_of_life/src/lib/level.ts":[],"/home/ochanomizu/repos/game_of_life/src/lib/flux.ts":[],"/home/ochanomizu/repos/game_of_life/src/lib/interaction.ts":[],"/home/ochanomizu/repos/game_of_life/src/hooks/usePhaseTimer.ts":[],"/home/ochanomizu/repos/game_of_life/src/components/LevelStats.tsx":[],"/home/ochanomizu