{"type":"tool_use","timestamp":1771218625180,"sessionID":"ses_39b28f7acffeLHlrypWKneG5Bj","part":{"id":"prt_c64db6289001PTXR7moGZD9azx","sessionID":"ses_39b28f7acffeLHlrypWKneG5Bj","messageID":"msg_c64db512a0010NU4EUNoEv425e","type":"tool","callID":"call_8e33c94a5c834ce9bc351970","tool":"read","state":{"status":"completed","input":{"filePath":"/home/ochanomizu/repos/game_of_life/src/components/CanvasGrid.tsx"},"output":"<path>/home/ochanomizu/repos/game_of_life/src/components/CanvasGrid.tsx</path>\n<type>file</type>\n<content>1: import { useRef, useEffect, useCallback } from 'react'\n2: import type { GridType } from '../types'\n3: import {\n4:   getCellColor,\n5:   getCellBlur,\n6:   getResponsiveCellSize,\n7:   CELL_CORNER_RADIUS,\n8:   BACKGROUND_COLOR,\n9:   GRID_LINE_COLOR,\n10: } from '../lib/canvasUtils'\n11: \n12: export interface CellAnimation {\n13:   row: number\n14:   col: number\n15:   type: 'birth' | 'death'\n16:   startTime: number\n17:   duration: number\n18: }\n19: \n20: interface CanvasGridProps {\n21:   grid: GridType\n22:   showGridLines: boolean\n23:   cellSize?: number\n24:   animations?: CellAnimation[]\n25:   showInvalidAction?: { row: number; col: number } | null\n26:   onClick?: (\n27:     event: React.MouseEvent<HTMLCanvasElement> | React.TouchEvent<HTMLCanvasElement>\n28:   ) => void\n29:   onMouseMove?: (\n30:     event: React.MouseEvent<HTMLCanvasElement> | React.TouchEvent<HTMLCanvasElement>\n31:   ) => void\n32:   onMouseLeave?: () => void\n33: }\n34: \n35: export function CanvasGrid({\n36:   grid,\n37:   showGridLines,\n38:   cellSize,\n39:   animations = [],\n40:   showInvalidAction = null,\n41:   onClick,\n42:   onMouseMove,\n43:   onMouseLeave,\n44: }: CanvasGridProps) {\n45:   const canvasRef = useRef<HTMLCanvasElement>(null)\n46:   const animationFrameRef = useRef<number | undefined>(undefined)\n47: \n48:   const actualCellSize = cellSize ?? getResponsiveCellSize()\n49: \n50:   const draw = useCallback(() => {\n51:     const canvas = canvasRef.current\n52:     if (!canvas) return\n53: \n54:     const ctx = canvas.getContext('2d')\n55:     if (!ctx) return\n56: \n57:     const dpr = window.devicePixelRatio || 1\n58:     const numCols = grid[0].length\n59:     const numRows = grid.length\n60: \n61:     const width = numCols * actualCellSize\n62:     const height = numRows * actualCellSize\n63: \n64:     canvas.width = width * dpr\n65:     canvas.height = height * dpr\n66:     canvas.style.width = `${width}px`\n67:     canvas.style.height = `${height}px`\n68: \n69:     ctx.scale(dpr, dpr)\n70: \n71:     ctx.fillStyle = BACKGROUND_COLOR\n72:     ctx.fillRect(0, 0, width, height)\n73: \n74:     if (showGridLines) {\n75:       ctx.strokeStyle = GRID_LINE_COLOR\n76:       ctx.lineWidth = 1\n77: \n78:       for (let col = 0; col <= numCols; col++) {\n79:         const x = col * actualCellSize\n80:         ctx.beginPath()\n81:         ctx.moveTo(x, 0)\n82:         ctx.lineTo(x, height)\n83:         ctx.stroke()\n84:       }\n85: \n86:       for (let row = 0; row <= numRows; row++) {\n87:         const y = row * actualCellSize\n88:         ctx.beginPath()\n89:         ctx.moveTo(0, y)\n90:         ctx.lineTo(width, y)\n91:         ctx.stroke()\n92:       }\n93:     }\n94: \n95:     const now = window.performance.now()\n96:     const animationMap = new Map(animations.map((a) => [`${a.row},${a.col}`, a]))\n97: \n98:     let activeCount = 0\n99: \n100:     for (let row = 0; row < numRows; row++) {\n101:       for (let col = 0; col < numCols; col++) {\n102:         const age = grid[row][col]\n103:         if (age > 0) {\n104:           activeCount++\n105:           const x = col * actualCellSize\n106:           const y = row * actualCellSize\n107:           const color = getCellColor(age)\n108:           const blur = getCellBlur(age)\n109: \n110:           ctx.save()\n111:           ctx.shadowColor = color\n112:           ctx.shadowBlur = blur\n113:           ctx.fillStyle = color\n114: \n115:           const animation = animationMap.get(`${row},${col}`)\n116:           if (animation && animation.type === 'birth') {\n117:             const elapsed = now - animation.startTime\n118:             const progress = Math.min(elapsed / animation.duration, 1)\n119:             const easeProgress = 1 - Math.pow(1 - progress, 3)\n120: \n121:             ctx.globalAlpha = easeProgress\n122:             const scale = easeProgress\n123:             const centerX = x + actualCellSize / 2\n124:             const centerY = y + actualCellSize / 2\n125:             ctx.translate(centerX, centerY)\n126:             ctx.scale(scale, scale)\n127:             ctx.translate(-centerX, -centerY)\n128:           }\n129: \n130:           const radius = CELL_CORNER_RADIUS\n131: \n132:           ctx.beginPath()\n133:           ctx.roundRect(x + 1, y + 1, actualCellSize - 2, actualCellSize - 2, radius)\n134:           ctx.fill()\n135:           ctx.restore()\n136:         }\n137:       }\n138:     }\n139: \n140:     for (const animation of animations) {\n141:       if (animation.type === 'death') {\n142:         const elapsed = now - animation.startTime\n143:         const progress = Math.min(elapsed / animation.duration, 1)\n144:         const easeProgress = Math.pow(progress, 2)\n145: \n146:         if (progress < 1) {\n147:           const x = animation.col * actualCellSize\n148:           const y = animation.row * actualCellSize\n149:           const scale = 1 - easeProgress\n150: \n151:           ctx.save()\n152:           ctx.fillStyle = '#00ffff'\n153:           ctx.globalAlpha = 1 - easeProgress\n154: \n155:           const centerX = x + actualCellSize / 2\n156:           const centerY = y + actualCellSize / 2\n157:           ctx.translate(centerX, centerY)\n158:           ctx.scale(scale, scale)\n159:           ctx.translate(-centerX, -centerY)\n160: \n161:           const radius = CELL_CORNER_RADIUS\n162: \n163:           ctx.beginPath()\n164:           ctx.roundRect(x + 1, y + 1, actualCellSize - 2, actualCellSize - 2, radius)\n165:           ctx.fill()\n166:           ctx.restore()\n167:         }\n168:       }\n169:     }\n170: \n171:     if (showInvalidAction) {\n172:       const x = showInvalidAction.col * actualCellSize\n173:       const y = showInvalidAction.row * actualCellSize\n174: \n175:       ctx.save()\n176:       ctx.strokeStyle = '#ff0000'\n177:       ctx.lineWidth = 2\n178:       ctx.globalAlpha = 0.8\n179: \n180:       ctx.beginPath()\n181:       ctx.roundRect(x + 1, y + 1, actualCellSize - 2, actualCellSize - 2, 2)\n182:       ctx.stroke()\n183: \n184:       ctx.restore()\n185:     }\n186: \n187:     const intensity = Math.min(activeCount / 500, 1)\n188:     document.documentElement.style.setProperty('--life-intensity', intensity.toString())\n189:   }, [grid, showGridLines, actualCellSize, animations, showInvalidAction])\n190: \n191:   useEffect(() => {\n192:     const render = () => {\n193:       draw()\n194:       if (animations.length > 0) {\n195:         animationFrameRef.current = window.requestAnimationFrame(render)\n196:       }\n197:     }\n198: \n199:     render()\n200: \n201:     return () => {\n202:       if (animationFrameRef.current) {\n203:         window.cancelAnimationFrame(animationFrameRef.current)\n204:       }\n205:     }\n206:   }, [draw, animations.length])\n207: \n208:   return (\n209:     <canvas\n210:       ref={canvasRef}\n211:       style={{ touchAction: 'none' }}\n212:       onClick={onClick}\n213:       onMouseMove={onMouseMove}\n214:       onMouseLeave={onMouseLeave}\n215:     />\n216:   )\n217: }\n218: \n\n(End of file - total 218 lines)\n</content>","title":"src/components/CanvasGrid.tsx","metadata":{"preview":"import { useRef, useEffect, useCallback } from 'react'\nimport type { GridType } from '../types'\nimport {\n  getCellColor,\n  getCellBlur,\n  getResponsiveCellSize,\n  CELL_CORNER_RADIUS,\n  BACKGROUND_COLOR,\n  GRID_LINE_COLOR,\n} from '../lib/canvasUtils'\n\nexport interface CellAnimation {\n  row: number\n  col: number\n  type: 'birth' | 'death'\n  startTime: number\n  duration: number\n}\n\ninterface CanvasGridProps {","truncated":false,"loaded":[]},"time":{"start":1771218625165,"end":1771218625175}}}}
