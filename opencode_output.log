pacity: 1;\n    transform: translateY(0);\n  }\n  100% {\n    opacity: 0;\n    transform: translateY(-20px);\n  }\n}\n\n@keyframes fadeInText {\n  0% {\n    opacity: 0;\n    transform: translateY(20px);\n  }\n  100% {\n    opacity: 1;\n    transform: translateY(0);\n  }\n}\n\n@media (max-width: 768px) {\n  .level-complete-text {\n    font-size: 2rem;\n  }\n\n  .next-level-text {\n    font-size: 1.5rem;\n  }\n\n  .skip-hint {\n    font-size: 0.8rem;\n  }\n}\n","filePath":"/home/ochanomizu/repos/game_of_life/src/components/TransitionOverlay.css"},"output":"Wrote file successfully.","title":"src/components/TransitionOverlay.css","metadata":{"diagnostics":{"/home/ochanomizu/repos/game_of_life/src/App.tsx":[],"/home/ochanomizu/repos/game_of_life/src/lib/phase.ts":[],"/home/ochanomizu/repos/game_of_life/src/lib/movement.ts":[],"/home/ochanomizu/repos/game_of_life/src/lib/simulation.ts":[],"/home/ochanomizu/repos/game_of_life/src/lib/interaction.ts":[],"/home/ochanomizu/repos/game_of_life/src/lib/flux.ts":[],"/home/ochanomizu/repos/game_of_life/src/components/Game.tsx":[],"/home/ochanomizu/repos/game_of_life/src/types/index.ts":[],"/home/ochanomizu/repos/game_of_life/src/lib/audio.ts":[],"/home/ochanomizu/repos/game_of_life/src/lib/scoring.ts":[],"/home/ochanomizu/repos/game_of_life/src/lib/settings.ts":[],"/home/ochanomizu/repos/game_of_life/src/hooks/usePhaseTimer.ts":[],"/home/ochanomizu/repos/game_of_life/src/components/CanvasGrid.tsx":[],"/home/ochanomizu/repos/game_of_life/src/components/GridInteraction.tsx":[],"/home/ochanomizu/repos/game_of_life/src/components/ScoreDisplay.tsx":[],"/home/ochanomizu/repos/game_of_life/src/components/SettingsPanel.tsx":[],"/home/ochanomizu/repos/game_of_life/src/components/GlassHUD.tsx":[],"/home/ochanomizu/repos/game_of_life/src/components/UIToggleButton.tsx":[],"/home/ochanomizu/repos/game_of_life/src/lib/validation.ts":[],"/home/ochanomizu/repos/game_of_life/src/lib/logger.ts":[],"/home/ochanomizu/repos/game_of_life/src/components