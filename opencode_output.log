{"type":"tool_use","timestamp":1771182446125,"sessionID":"ses_39d54d119ffe5wknN3nwR32dw0","part":{"id":"prt_c62b3481b001XVc5hb283nHwqN","sessionID":"ses_39d54d119ffe5wknN3nwR32dw0","messageID":"msg_c62b31ca1001aeGEu6Bbt42cz0","type":"tool","callID":"call_0b0272fa1f1747548e1b4959","tool":"write","state":{"status":"completed","input":{"content":"import { useState, useEffect, useRef } from 'react'\nimport type { TransitionState, TransitionConfig } from '../types'\n\nconst DEFAULT_CONFIG: TransitionConfig = {\n  fadeOutDuration: 2000,\n  fadeInDuration: 2000,\n  interstitialDuration: 2000,\n  autoAdvanceDelay: 2000,\n  skipEnabled: true,\n}\n\ninterface TransitionStateInternal {\n  current: TransitionState\n  canTransition: boolean\n}\n\nexport function useTransition(\n  config: TransitionConfig = DEFAULT_CONFIG,\n  onTransitionComplete?: () => void,\n) {\n  const [transitionState, setTransitionState] = useState<TransitionStateInternal>({\n    current: 'PLAYING',\n    canTransition: false,\n  })\n\n  const timeoutRef = useRef<number | null>(null)\n\n  const clearTimeoutRef = () => {\n    if (timeoutRef.current !== null) {\n      window.clearTimeout(timeoutRef.current)\n      timeoutRef.current = null\n    }\n  }\n\n  const startTransition = () => {\n    setTransitionState({ current: 'FADING_OUT', canTransition: false })\n\n    timeoutRef.current = window.setTimeout(() => {\n      setTransitionState({ current: 'INTERSTITIAL', canTransition: false })\n\n      timeoutRef.current = window.setTimeout(() => {\n        setTransitionState({ current: 'FADING_IN', canTransition: false })\n\n        timeoutRef.current = window.setTimeout(() => {\n          setTransitionState({ current: 'READY', canTransition: true })\n          onTransitionComplete?.()\n        }, config.fadeInDuration)\n      }, config.interstitialDuration)\n    }, config.fadeOutDuration)\n  }\n\n  const skipTransition = () => {\n    clearTimeoutRef()\n    setTransitionState({ current: 'READY', canTransition: true })\n    onTransitionComplete?.()\n  }\n\n  const resetTransition = () => {\n    clearTimeoutRef()\n    setTransitionState({ current: 'PLAYING', canTransition: false })\n  }\n\n  const handleKeyDown = (e: KeyboardEvent) => {\n    if (config.skipEnabled && (e.code === 'Space' || e.code === 'Escape')) {\n      if (transitionState.current !== 'PLAYING' && transitionState.current !== 'READY') {\n        skipTransition()\n      }\n    }\n  }\n\n  useEffect(() => {\n    window.addEventListener('keydown', handleKeyDown)\n    return () => {\n      window.removeEventListener('keydown', handleKeyDown)\n      clearTimeoutRef()\n    }\n  }, [config.skipEnabled, transitionState.current])\n\n  return {\n    transitionState: transitionState.current,\n    isTransitioning:\n      transitionState.current !== 'PLAYING' && transitionState.current !== 'READY',\n    isFadingOut: transitionState.current === 'FADING_OUT',\n    isInterstitial: transitionState.current === 'INTERSTITIAL',\n    isFadingIn: transitionState.current === 'FADING_IN',\n    isReady: transitionState.current === 'READY',\n    startTransition,\n    skipTransition,\n    resetTransition,\n  }\n}\n","filePath":"/home/ochanomizu/repos/game_of_life/src/hooks/useTransition.ts"},"output":"Wrote file successfully.","title":"src/hooks/useTransition.ts","metadata":{"diagnostics":{"/home/ochanomizu/repos/game_of_life/src/App.tsx":[],"/home/ochanomizu/repos/game_of_life/src/lib/phase.ts":[],"/home/ochanomizu/repos/game_of_life/src/lib/movement.ts":[],"/home/ochanomizu/repos/game_of_life/src/lib/simulation.ts":[],"/home/ochanomizu/repos/game_of_life/src/lib/interaction.ts":[],"/home/ochanomizu/repos/game_of_life/src/lib/flux.ts":[],"/home/ochanomizu/repos/game_of_life/src/components/Game.tsx":[],"/home/ochanomizu/repos/game_of_life/src/types/index.ts":[],"/home/ochanomizu/repos/game_of_life/src/lib/audio.ts":[],"/home/ochanomizu/repos/game_of_life/src/lib/scoring.ts":[],"/home/ochanomizu/repos/game_of_life/src/lib/settings.ts":[],"/home/ochanomizu/repos/game_of_life/src/hooks/usePhaseTimer.ts":[],"/home/ochanomizu/repos/game_of_life/src/components/CanvasGrid.tsx":[],"/home/ochanomizu/repos/game_of_life/src/components/GridInteraction.tsx":[],"/home/ochanomizu/repos/game_of_life/src/components/ScoreDisplay.tsx":[],"/home/ochanomizu/repos/game_of_life/src/components/SettingsPanel.tsx":[],"/home/ochanomizu/repos/game_of_life/src/components/GlassHUD.tsx":[],"/home/ochanomizu/repos/game_of_life/src/components/UIToggleButton.tsx":[],"/home/ochanomizu/repos/game_of_life/src/lib/validation.ts":[],"/home/ochanomizu/repos/game_of_life/src/lib/logger.ts":[],"/home/ochanomizu/repos/game_of_life/src/components/IntroOverlay.tsx":[],"/home/ochanomizu/repos/game_of_life/src/lib/canvasUtils.ts":[],"/home/ochanomizu/repos/game_of_life/src/lib/state.ts":[],"/home/ochanomizu/repos/game_of_life/src/lib/level.ts":[],"/home/ochanomizu/repos/game_of_life/src/lib/settings.test.ts":[],"/home/ochanomizu/repos/game_of_life/src/lib/level.test.ts":[],"/home/ochanomizu/repos/game_of_life/src/components/VictoryScreen.tsx":[],"/home/ochanomizu/repos/game_of_life/src/components/VictoryScreen.test.tsx":[],"/home/ochanomizu/repos/game_of_life/src/hooks/useTransition.ts":[]},"filepath":"/home/ochanomizu/repos/game_of_life/src/hooks/useTransition.ts","exists":false,"truncated":false},"time":{"start":1771182442531,"end":1771182446123}}}}
