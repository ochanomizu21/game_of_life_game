     }\n244:     }\n245:   }, [phaseState, simulationSpeed, handleSimulationStep, trackedClusters])\n246: \n247:   const handleStart = useCallback(() => {\n248:     if (phaseState.current === 'PLANNING' && hasCells() && currentLevelConfig) {\n249:       startCountdown()\n250:       startRunning(currentLevelConfig.timeLimitSeconds)\n251:     }\n252:   }, [phaseState, startCountdown, hasCells, currentLevelConfig, startRunning])\n253: \n254:   const handleGridChange = useCallback((newGrid: GridType) => {\n255:     setGrid(newGrid)\n256:     setGeneration(0)\n257:   }, [])\n258: \n259:   const handleFluxChange = useCallback((newFlux: FluxState) => {\n260:     setFlux(newFlux)\n261:   }, [])\n262: \n263:   const handleClear = useCallback(() => {\n264:     const { rows, cols } = GRID_SIZE_PRESETS[gridPreset]\n265:     setGrid(createGrid(rows, cols))\n266:     setFlux(createInitialFluxState(20))\n267:     setGeneration(0)\n268:     setScoreState(createInitialScoreState())\n269:     setTrackedClusters([])\n270:   }, [gridPreset])\n271: \n272:   const handleRandom = useCallback(() => {\n273:     const { rows, cols } = GRID_SIZE_PRESETS[gridPreset]\n274:     const newGrid = createGrid(rows, cols)\n275:     const density = 0.15\n276: \n277:     for (let row = 0; row < rows; row++) {\n278:       for (let col = 0; col < cols; col++) {\n279:         if (Math.random() < density) {\n280:           newGrid[row][col] = 1\n281:         }\n282:       }\n283:     }\n284: \n285:     setGrid(newGrid)\n286:     setFlux(createInitialFluxState(20))\n287:     setGeneration(0)\n288:     setScoreState(createInitialScoreState())\n289:     setTrackedClusters([])\n290:   }, [gridPreset])\n291: \n292:   const aliveCount = grid.flat().filter((cell: number) => cell > 0).length\n293: \n294:   const handleToggleSettings = useCallback(() => {\n295:     setSettingsPanelOpen((prev) => !prev)\n296:   }, [])\n297: \n298:   const handleUpdateSettings = useCallback((newSettings: ExpertSettings) => {\n299:     setExpertSettings(newSettings)\n300:     saveToLocalStorage('gol-expert-settings', newSettings)\n301:   }, [])\n302: \n303:   const handleStep = useCallback(() => {\n304:     if (phaseState.current !== 'PLANNING') return\n305: \n306:     const currentState = {\n307:       grid,\n308:       generation,\n309:       running: false,\n310:       speed: 100,\n311:       selectedRule: CONWAY_RULES,\n312:     }\n313: \n314:     const result = stepSimulation(currentState)\n315:     setGrid(result.newGrid)\n316:     setGeneration(result.newGeneration)\n317:   }, [phaseState, grid, generation])\n318: \n319:   const canInteract = phaseState.current === 'PLANNING'\n320: \n321:   const movers = trackedClusters.filter((c) => c.classification === 'MOVER').length\n322:   const oscillators = trackedClusters.filter((c) => c.classification === 'OSCILLATOR').length\n323:   const rate =\n324:     scoringConfig.moverPointsPerGeneration * movers +\n325:     scoringConfig.oscillatorPointsPerGeneration * oscillators\n326: \n327:   return (\n328:     <div style={{ padding: '20px', backgroundColor: '#0a0a0f', minHeight: '100vh', color: '#fff' }}>\n329:       <UIToggleButton isVisible={isUiVisible} onToggle={() => setIsUiVisible(!isUiVisible)} />\n330: \n331:       <ScoreDisplay\n332:         score={scoreState.currentScore}\n333:         previousScore={previousScore}\n334:         showPatternBreakdown={true}\n335:         movers={movers}\n336:         oscillators={oscillators}\n337:         rate={rate}\n338:         highScore={highScore}\n339:       />\n340: \n341:       <SettingsPanel\n342:         isOpen={settingsPanelOpen}\n343:         settings={expertSettings}\n344:         onClose={() => setSettingsPanelOpen(false)}\n345:         onUpdateSettings={handleUpdateSettings}\n346:       />\n347: \n348:       <h1 style={{ textAlign: 'center', marginBottom: '20px', color: '#61dafb' }}>\n349:         Level {levelProgression.currentLevel} - Conway's Game of Life\n350:       </h1>\n351: \n352:       <TransitionOverlay\n353:         transitionState={transitionState}\n354:         currentLevel={levelProgression.currentLevel}\n355:       />\n356: \n357:       {showVictory && (\n358:         <VictoryScreen\n359:           totalScore={levelProgression.totalScore}\n360:           onPlayAgain={() => {\n361:             const reset = resetProgression()\n362:             setLevelProgression(reset)\n363:             setShowVictory(false)\n364:             const { rows, cols } = GRID_SIZE_PRESETS[gridPreset]\n365:             setGrid(createGrid(rows, cols))\n366:             setFlux(createInitialFluxState(reset.levels[0]?.initialFlux ?? 20))\n367:             setGeneration(0)\n368:             setScoreState(createInitialScoreState())\n369:             previousTrackedClustersRef.current = []\n370:           }}\n371:         />\n372:       )}\n373: \n374:       {isUiVisible && (\n375:         <GlassHUD\n376:           phase={phaseState.current}\n377:           aliveCount={aliveCount}\n378:           flux={flux.current}\n379:           fluxMax={flux.initial}\n380:           interactionMode={interactionMode}\n381:           gridPreset={gridPreset}\n382:           showGridLines={showGridLines}\n383:           generation={generation}\n384:           countdownValue={phaseState.countdownValue}\n385:           timerRemaining={phaseState.timerRemaining}\n386:           canStart={aliveCount > 0}\n387:           canInteract={canInteract}\n388:           onStart={handleStart}\n389:           onStep={handleStep}\n390:           onClear={handleClear}\n391:           onRandom={handleRandom}\n392:           onToggleGrid={() => setShowGridLines(!showGridLines)}\n393:           onSetMode={setInteractionMode}\n394:           onSetGridPreset={setGridPreset}\n395:           onToggleSettings={handleToggleSettings}\n396:         />\n397:       )}\n398: \n399:       <div style={{ display: 'flex', justifyContent: 'center' }}>\n400:         <GridInteraction\n401:           grid={grid}\n402:           flux={flux}\n403:           phase={phaseState.current}\n404:           showGridLines={showGridLines}\n405:           onGridChange={handleGridChange}\n406:           onFluxChange={handleFluxChange}\n407:           interactionMode={interactionMode}\n408:           onInteractionSound={handleInteractionSound}\n409:           onFluxErrorSound={handleFluxErrorSound}\n410:         />\n411:       </div>\n412:     </div>\n413:   )\n414: }\n415: \n\n(End of file - total 415 lines)\n</content>","title":"src/components/Game.tsx","metadata":{"preview":"    }\n\n    const result = stepSimulation(currentState)\n\n    if (result.bornCount > 0) {\n      const totalRows = grid.length\n      soundEngineRef.current?.playGenerationSound(result.bornCount, result.averageRow, totalRows)\n    }\n\n    const currentClusters = findConnectedComponents(result.newGrid, result.newGeneration)\n    const tracked = trackClusters(currentClusters, trackedClusters, movementConfig)\n\n    const generationScore = calculateGenerationScore(tracked, scoringConfig)\n    const newScoreState = updateScore(scoreState, generationScore)\n\n    setPreviousScore(scoreState.currentScore)\n    previousTrackedClustersRef.current = tracked\n    setTrackedClusters(tracked)\n    setScoreState(newScoreState)\n    setGrid(result.newGrid)","truncated":false,"loaded":[]},"time":{"start":1771201135370,"end":1771201135374}}}}
