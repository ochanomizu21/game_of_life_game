: number) => {\n41:       const numRows = grid.length\n42:       const numCols = grid[0].length\n43: \n44:       if (!isWithinBounds(row, col, numRows, numCols)) return\n45: \n46:       const cellExists = grid[row][col] > 0\n47: \n48:       if (interactionMode === 'DRAW') {\n49:         if (cellExists) {\n50:           if (phase === 'PLANNING') {\n51:             onInteractionSound?.('erase')\n52:             const newFlux = removeCell(flux, phase)\n53:             const newGrid = grid.map((r, rIdx) =>\n54:               r.map((cell, cIdx) => (rIdx === row && cIdx === col ? 0 : cell))\n55:             )\n56:             onFluxChange(newFlux)\n57:             onGridChange(newGrid)\n58: \n59:             const deathAnimation: CellAnimation = {\n60:               row,\n61:               col,\n62:               type: 'death',\n63:               startTime: window.performance.now(),\n64:               duration: 150,\n65:             }\n66:             setAnimations((prev) => [...prev, deathAnimation])\n67:           }\n68:         } else {\n69:           if (canPlaceCell(flux)) {\n70:             onInteractionSound?.('draw')\n71:             const newFlux = placeCell(flux)\n72:             const newGrid = grid.map((r, rIdx) =>\n73:               r.map((cell, cIdx) => (rIdx === row && cIdx === col ? 1 : cell))\n74:             )\n75:             onFluxChange(newFlux)\n76:             onGridChange(newGrid)\n77: \n78:             const birthAnimation: CellAnimation = {\n79:               row,\n80:               col,\n81:               type: 'birth',\n82:               startTime: window.performance.now(),\n83:               duration: 100,\n84:             }\n85:             setAnimations((prev) => [...prev, birthAnimation])\n86:           } else {\n87:             onFluxErrorSound?.()\n88:             setShowInvalidAction({ row, col })\n89:             window.setTimeout(() => setShowInvalidAction(null), 200)\n90:           }\n91:         }\n92:       } else if (interactionMode === 'ERASE') {\n93:         if (cellExists && phase === 'PLANNING') {\n94:           onInteractionSound?.('erase')\n95:           const newFlux = removeCell(flux, phase)\n96:           const newGrid = grid.map((r, rIdx) =>\n97:             r.map((cell, cIdx) => (rIdx === row && cIdx === col ? 0 : cell))\n98:           )\n99:           onFluxChange(newFlux)\n100:           onGridChange(newGrid)\n101: \n102:           const deathAnimation: CellAnimation = {\n103:             row,\n104:             col,\n105:             type: 'death',\n106:             startTime: window.performance.now(),\n107:             duration: 150,\n108:           }\n109:           setAnimations((prev) => [...prev, deathAnimation])\n110:         }\n111:       }\n112:     },\n113:     [\n114:       grid,\n115:       flux,\n116:       phase,\n117:       interactionMode,\n118:       onGridChange,\n119:       onFluxChange,\n120:       onInteractionSound,\n121:       onFluxErrorSound,\n122:     ]\n123:   )\n124: \n125:   const handleCanvasClick = useCallback(\n126:     (event: React.MouseEvent<HTMLCanvasElement> | React.TouchEvent<HTMLCanvasElement>) => {\n127:       if (phase !== 'PLANNING') return\n128: \n129:       const canvas = event.currentTarget\n130:       const numRows = grid.length\n131:       const numCols = grid[0].length\n132: \n133:       const nativeEvent = event.nativeEvent\n134:       const { row, col } = getCellFromEvent(nativeEvent, canvas, numRows, numCols)\n135:       handleCellClick(row, col)\n136:     },\n137:     [phase, grid, handleCellClick]\n138:   )\n139: \n140:   const handleCanvasMove = useCallback(\n141:     (event: React.MouseEvent<HTMLCanvasElement> | React.TouchEvent<HTMLCanvasElement>) => {\n142:       const canvas = event.currentTarget\n143:       const numRows = grid.length\n144:       const numCols = grid[0].length\n145: \n146:       const nativeEvent = event.nativeEvent\n147:       const { row, col } = getCellFromEvent(nativeEvent, canvas, numRows, numCols)\n148: \n149:       if (isWithinBounds(row, col, numRows, numCols)) {\n150:         setHoveredCell({ row, col })\n151:       } else {\n152:         setHoveredCell(null)\n153:       }\n154:     },\n155:     [grid]\n156:   )\n157: \n158:   const handleCanvasLeave = useCallback(() => {\n159:     setHoveredCell(null)\n160:   }, [])\n161: \n162:   const getCursor = useCallback(() => {\n163:     if (phase !== 'PLANNING') return 'not-allowed'\n164: \n165:     if (!hoveredCell) return 'default'\n166: \n167:     const cellExists = grid[hoveredCell.row][hoveredCell.col] > 0\n168: \n169:     if (cellExists) {\n170:       if (phase === 'PLANNING') {\n171:         return 'crosshair'\n172:       }\n173:       return 'not-allowed'\n174:     }\n175: \n176:     if (flux.current === 0) {\n177:       return 'not-allowed'\n178:     }\n179: \n180:     return 'crosshair'\n181:   }, [phase, hoveredCell, grid, flux])\n182: \n183:   const isPlaceable = useCallback(() => {\n184:     if (!hoveredCell) return false\n185:     if (flux.current === 0) return false\n186:     return grid[hoveredCell.row][hoveredCell.col] === 0\n187:   }, [hoveredCell, flux, grid])\n188: \n189:   const isRemovable = useCallback(() => {\n190:     if (!hoveredCell) return false\n191:     return grid[hoveredCell.row][hoveredCell.col] > 0\n192:   }, [hoveredCell, grid])\n193: \n194:   useEffect(() => {\n195:     return () => {\n196:       setHoveredCell(null)\n197:     }\n198:   }, [grid])\n199: \n200:   return (\n201:     <div style={{ position: 'relative', cursor: getCursor() }}>\n202:       <CanvasGrid\n203:         grid={grid}\n204:         showGridLines={showGridLines}\n205:         cellSize={cellSize}\n206:         animations={animations}\n207:         showInvalidAction={showInvalidAction}\n208:         onClick={handleCanvasClick}\n209:         onMouseMove={handleCanvasMove}\n210:         onMouseLeave={handleCanvasLeave}\n211:       />\n212:       {hoveredCell && phase === 'PLANNING' && (\n213:         <div\n214:           style={{\n215:             position: 'absolute',\n216:             left: `${hoveredCell.col * (cellSize || 20)}px`,\n217:             top: `${hoveredCell.row * (cellSize || 20)}px`,\n218:             width: `${cellSize || 20}px`,\n219:             height: `${cellSize || 20}px`,\n220:             pointerEvents: 'none',\n221:             border: `2px solid ${isPlaceable() ? '#00ffff' : isRemovable() ? '#ff00ff' : '#ff0000'}`,\n222:             opacity: 0.5,\n223:             borderRadius: '2px',\n224:           }}\n225:         />\n226:       )}\n227:     </div>\n228:   )\n229: }\n230: \n\n(End of file - total 230 lines)\n</content>","title":"src/components/GridInteraction.tsx","metadata":{"preview":"import { useState, useCallback, useEffect } from 'react'\nimport type { GridType } from '../types'\nimport { CanvasGrid, type CellAnimation } from './CanvasGrid'\nimport { getCellFromEvent, isWithinBounds } from '../lib/interaction'\nimport { canPlaceCell, placeCell, removeCell } from '../lib/flux'\nimport type { FluxState } from '../types'\n\ninterface GridInteractionProps {\n  grid: GridType\n  flux: FluxState\n  phase: 'PLANNING' | 'COUNTDOWN' | 'RUNNING' | 'FINISHED'\n  showGridLines: boolean\n  cellSize?: number\n  onGridChange: (newGrid: GridType) => void\n  onFluxChange: (newFlux: FluxState) => void\n  interactionMode: 'DRAW' | 'ERASE'\n  onInteractionSound?: (type: 'draw' | 'erase') => void\n  onFluxErrorSound?: () => void\n}\n","truncated":false,"loaded":[]},"time":{"start":1771234202175,"end":1771234202181}}}}
