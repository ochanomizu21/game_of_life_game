     onChange={(e) => handleUpdate('audio.volume', parseFloat(e.target.value))}\n103:                 className=\"settings-slider\"\n104:               />\n105:             </div>\n106:             <div className=\"settings-row\">\n107:               <label htmlFor=\"audio-waveform\">Waveform</label>\n108:               <select\n109:                 id=\"audio-waveform\"\n110:                 value={localSettings.audio.waveform}\n111:                 onChange={(e) =>\n112:                   handleUpdate(\n113:                     'audio.waveform',\n114:                     e.target.value as 'sine' | 'triangle' | 'square' | 'sawtooth'\n115:                   )\n116:                 }\n117:                 className=\"settings-select\"\n118:               >\n119:                 <option value=\"sine\">Sine</option>\n120:                 <option value=\"triangle\">Triangle</option>\n121:                 <option value=\"square\">Square</option>\n122:                 <option value=\"sawtooth\">Sawtooth</option>\n123:               </select>\n124:             </div>\n125:           </section>\n126: \n127:           <section className=\"settings-section\">\n128:             <h3>Movement Detection</h3>\n129:             <div className=\"settings-row\">\n130:               <label htmlFor=\"movement-history\">\n131:                 Centroid History Length: {localSettings.movementDetection.centroidHistoryLength}\n132:               </label>\n133:               <input\n134:                 id=\"movement-history\"\n135:                 type=\"range\"\n136:                 min=\"3\"\n137:                 max=\"10\"\n138:                 step=\"1\"\n139:                 value={localSettings.movementDetection.centroidHistoryLength}\n140:                 onChange={(e) =>\n141:                   handleUpdate('movementDetection.centroidHistoryLength', parseInt(e.target.value))\n142:                 }\n143:                 className=\"settings-slider\"\n144:               />\n145:     