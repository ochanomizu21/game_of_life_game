rn true\n}\n\nconst modes: Array<'TIME_ONLY' | 'RESOURCE_ONLY' | 'MIXED' | 'EXTREME'> = [\n  'TIME_ONLY',\n  'RESOURCE_ONLY',\n  'MIXED',\n  'EXTREME',\n]\n\nmodes.forEach((mode) => {\n  const testSettings = { ...settings }\n  testSettings.levelGeneration.difficultyScalingMode = mode\n  console.log(`Testing mode: ${mode}, result: ${validateExpertSettings(testSettings)}`)\n})\nEOF\nnode /tmp/test_presets.ts\n","description":"Test which mode is failing validation"},"output":"Testing mode: TIME_ONLY, result: true\nTesting mode: RESOURCE_ONLY, result: true\nTesting mode: MIXED, result: true\nTesting mode: EXTREME, result: true\n","title":"Test which mode is failing validation","metadata":{"output":"Testing mode: TIME_ONLY, result: true\nTesting mode: RESOURCE_ONLY, result: true\nTesting mode: MIXED, result: true\nTesting mode: EXTREME, result: true\n","exit":0,"description":"Test which mode is failing validation","truncated":false},"time":{"start":1771215724927,"end":1771215725131}}}}
