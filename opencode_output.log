\n58:   totalPatternsTracked: number\n59: }\n60: \n61: export interface LevelProgression {\n62:   currentLevel: number\n63:   maxUnlockedLevel: number\n64:   totalScore: number\n65:   levels: LevelConfig[]\n66: }\n67: \n68: export type DifficultyScalingMode = 'TIME_ONLY' | 'RESOURCE_ONLY' | 'MIXED' | 'EXTREME'\n69: \n70: export interface LevelGenerationParams {\n71:   baseTimeSeconds: number\n72:   timeIncrementPerLevel: number\n73:   baseFlux: number\n74:   difficultyScalingMode: DifficultyScalingMode\n75: }\n76: \n77: export interface TransitionConfig {\n78:   fadeOutDuration: number\n79:   fadeInDuration: number\n80:   interstitialDuration: number\n81:   autoAdvanceDelay: number\n82:   skipEnabled: boolean\n83: }\n84: \n85: export interface MovementDetectionParams {\n86:   centroidHistoryLength: number\n87:   movementThreshold: number\n88:   minClusterSize: number\n89: }\n90: \n91: export interface GridSizingParams {\n92:   mobileCellSize: number\n93:   desktopCellSize: number\n94:   minVisibleCells: number\n95: }\n96: \n97: export interface AudioParams {\n98:   enabled: boolean\n99:   volume: number\n100:   waveform: 'sine' | 'triangle' | 'square' | 'sawtooth'\n101: }\n102: \n103: export interface ExpertSettings {\n104:   movementDetection: MovementDetectionParams\n105:   scoring: ScoringConfig\n106:   levelGeneration: LevelGenerationParams\n107:   gridSizing: GridSizingParams\n108:   audio: AudioParams\n109: }\n110: \n\n(End of file - total 110 lines)\n</content>","title":"src/types/index.ts","metadata":{"preview":"export type GridType = number[][]\n\nexport type GamePhase = 'PLANNING' | 'COUNTDOWN' | 'RUNNING' | 'FINISHED'\n\nexport type InteractionMode = 'DRAW' | 'ERASE'\n\nexport type TransitionState = 'PLAYING' | 'FADING_OUT' | 'INTERSTITIAL' | 'FADING_IN' | 'READY'\n\nexport interface CellCluster {\n  id: string\n  cells: Set<string>\n  centroid: { x: number; y: number }\n  generation: number\n}\n\nexport interface TrackedCluster extends CellCluster {\n  c