     failure: (error: Error) => ({ type: `${name}_FAILURE`, error }) as const,\n43:   }\n44: }\n45: \n46: // eslint-disable-next-line @typescript-eslint/no-explicit-any\n47: export function combineReducers<S extends Record<string, any>>(\n48:   // eslint-disable-next-line @typescript-eslint/no-explicit-any\n49:   reducers: Record<string, Reducer<any, any>>\n50:   // eslint-disable-next-line @typescript-eslint/no-explicit-any\n51: ): Reducer<S, any> {\n52:   // eslint-disable-next-line @typescript-eslint/no-explicit-any\n53:   return (state: S = {} as S, action: any): S => {\n54:     // eslint-disable-next-line @typescript-eslint/no-explicit-any\n55:     const nextState: any = { ...state }\n56:     let hasChanged = false\n57: \n58:     for (const key in reducers) {\n59:       const reducer = reducers[key]\n60:       const previousStateForKey = state[key]\n61:       const nextStateForKey = reducer(previousStateForKey, action)\n62: \n63:       if (nextStateForKey !== previousStateForKey) {\n64:         nextState[key] = nextStateForKey\n65:         hasChanged = true\n66:       }\n67:     }\n68: \n69:     return hasChanged ? (nextState as S) : state\n70:   }\n71: }\n72: \n73: export function dispatchMultiple<A>(dispatch: Dispatch<A>, actions: A[]): void {\n74:   actions.forEach((action) => dispatch(action))\n75: }\n76: \n77: export const STORAGE_KEY_PREFIX = 'gol-'\n78: \n79: export function saveToLocalStorage<T>(key: string, value: T): boolean {\n80:   try {\n81:     const fullKey = `${STORAGE_KEY_PREFIX}${key}`\n82:     const serialized = JSON.stringify(value)\n83:     localStorage.setItem(fullKey, serialized)\n84:     return true\n85:   } catch (error) {\n86:     console.error('Failed to save to localStorage:', error)\n87:     return false\n88:   }\n89: }\n90: \n91: export function loadFromLocalStorage<T>(key: string, defaultValue: T): T {\n92:   try {\n93:     const fullKey = `${STORAGE_KEY_PREFIX}${key}`\n94:     const serialized = localStorage.getItem(fullKey)\n95:     if (serialized === null) return defaultValue\n96:     const parsed = JSON.parse(serialized) as T\n97:     return parsed\n98:   } catch (error) {\n99:     console.error('Failed to load from localStorage:', error)\n100:     return defaultValue\n101:   }\n102: }\n103: \n104: export function removeFromLocalStorage(key: string): boolean {\n105:   try {\n106:     const fullKey = `${STORAGE_KEY_PREFIX}${key}`\n107:     localStorage.removeItem(fullKey)\n108:     return true\n109:   } catch (error) {\n110:     console.error('Failed to remove from localStorage:', error)\n111:     return false\n112:   }\n113: }\n114: \n\n(End of file - total 114 lines)\n</content>","title":"src/lib/state.ts","metadata":{"preview":"import type { Dispatch } from 'react'\n\nexport function createActionCreator<T extends string>(type: T): () => { type: T } {\n  return () => ({ type })\n}\n\nexport function createActionCreatorWithPayload<T extends string, P>(\n  type: T\n): (payload: P) => { type: T; payload: P } {\n  return (payload: P) => ({ type, payload })\n}\n\nexport type Action<T extends string, P = undefined> = P extends undefined\n  ? { type: T }\n  : { type: T; payload: P }\n\nexport type Reducer<S, A> = (state: S, action: A) => S\n\nexport function createReducer<S, A extends { type: string }>(\n  initialState: S,","truncated":false,"loaded":[]},"time":{"start":1771167750359,"end":1771167750377}}}}
