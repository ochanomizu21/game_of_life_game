     oscillators++\n        break\n      case 'STATIC':\n        staticCount++\n        break\n    }\n  }\n\n  return { movers, oscillators, static: staticCount }\n}\n\nexport function createInitialMovementDetectionParams(): MovementDetectionParams {\n  return {\n    centroidHistoryLength: 5,\n    movementThreshold: 0.5,\n    minClusterSize: 1,\n  }\n}\n","additions":1,"deletions":1},"truncated":false},"time":{"start":1771169743578,"end":1771169747008}}}}
